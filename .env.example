# Copia este archivo como .env.local (desarrollo) o configúralo en Vercel.
# Solo las variables PUBLIC_* llegan al navegador.

# --- Supabase (acceso de clientes) -----------------------------------------
# Proyecto xodvvxtmhaxpthqgkfbe · región us-west-2 · ver docs/supabase-setup.md
PUBLIC_SUPABASE_URL=https://xodvvxtmhaxpthqgkfbe.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Vacío en producción: el dashboard se sirve en el mismo origen vía rewrite (/app/{slug}/).
# Solo para desarrollo local contra un dashboard separado.
PUBLIC_DASHBOARD_URL=

# --- Solo local / servidor -------------------------------------------------
# NUNCA prefijar con PUBLIC_ ni subir a Vercel. Solo para scripts de alta.
SUPABASE_SERVICE_ROLE_KEY=

# --- Verificación de buscadores -------------------------------------------
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
