# Copia este archivo como .env (local) o configúralo en el panel de Netlify
# (Site configuration → Environment variables). Astro lo expone como PUBLIC_*.

# Código de verificación de Google Search Console (meta tag).
# Obtener en: Search Console → Configuración → Verificación → método "Etiqueta HTML".
# Ejemplo: PUBLIC_GOOGLE_SITE_VERIFICATION=AbCdEfGhIjKlMnOpQrStUv
PUBLIC_GOOGLE_SITE_VERIFICATION=
