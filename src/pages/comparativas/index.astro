---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Comparativas' }];

const title = 'Comparativas web y SEO | Presentto Online';
const description =
  'Compara web administrada, agencia tradicional y plantillas DIY con costes reales en COP.';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Comparativas de servicios web y SEO',
  url: 'https://www.presentto.online/comparativas/',
  inLanguage: 'es-CO',
  isPartOf: { '@id': 'https://www.presentto.online/#website' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Web administrada vs agencia tradicional vs DIY',
        url: 'https://www.presentto.online/comparativas/web-administrada-vs-agencia/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Precios de páginas web en Colombia 2026',
        url: 'https://www.presentto.online/guias/cuanto-cuesta-pagina-web-colombia/',
      },
    ],
  },
};
---

<BaseLayout title={title} description={description} path="/comparativas/" breadcrumbs={crumbs} jsonld={[collectionSchema]}>
  <Breadcrumbs items={crumbs} />

  <section class="section wrap page-hero">
    <p class="eyebrow">COMPARATIVAS</p>
    <h1>Compara antes de contratar</h1>
    <p class="lead">Análisis lado a lado con precios de mercado en Colombia.</p>
  </section>

  <section class="section wrap guide-layout">
    <ul class="collection-list">
      <li>
        <p class="eyebrow">COMPARATIVA</p>
        <h2>
          <a href="/comparativas/web-administrada-vs-agencia/">
            Web administrada vs agencia tradicional vs DIY
          </a>
        </h2>
        <p>
          Costes, tiempos, control y a quién le conviene cada opción — con la Presenttación Digital desde $40.000 COP/mes
          como referencia de entrada.
        </p>
      </li>
      <li>
        <p class="eyebrow">PRECIOS</p>
        <h2>
          <a href="/guias/cuanto-cuesta-pagina-web-colombia/">
            Precios de páginas web en Colombia 2026
          </a>
        </h2>
        <p>
          Tabla de rangos por tipo de proyecto y qué suele quedar fuera de la cotización.
        </p>
      </li>
    </ul>
  </section>
</BaseLayout>
