import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AuthorBox from '../../../components/AuthorBox.astro';
import { datesFor } from '../../../data/content-dates';
const crumbs = [
      { label: 'Inicio', href: '/' },
      { label: 'Guías', href: '/guias/' },
      { label: 'SEO local', href: '/guias/seo-local/' },
      { label: 'Google Business Profile' },
    ];
const dates = datesFor('/guias/seo-local/google-business-profile/');
const fechaLarga = new Date(dates.modified).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
