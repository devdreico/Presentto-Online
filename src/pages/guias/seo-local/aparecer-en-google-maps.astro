      { label: 'Google Maps' },
    ];
const dates = datesFor('/guias/seo-local/aparecer-en-google-maps/');
const fechaLarga = new Date(dates.modified).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const title = 'Aparecer en Google Maps para tu negocio';
const description =
  'Cómo aparecer en Google Maps: ficha verificada de Google Business, categorías, fotos, reseñas y web con schema LocalBusiness para el pack local.';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  datePublished: dates.published,
  dateModified: dates.modified,
  inLanguage: 'es-CO',
