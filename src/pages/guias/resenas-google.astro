---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { authorRef } from '../../components/schemas';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ArticleLayout from '../../components/ArticleLayout.astro';
import FinalCta from '../../components/FinalCta.astro';
import { ctaSession } from '../../data/business';
import { datesFor } from '../../data/content-dates';
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Guías', href: '/guias/' },
  { label: 'Reseñas de Google' },
];
const dates = datesFor('/guias/resenas-google/');

const title = 'Reseñas de Google: pedirlas y responder | Presentto';
const description =
  'Guía sobre reseñas de Google para negocios: cómo pedirlas, responderlas y evitar penalizaciones por prácticas falsas.';

const faqs = [
  {
    q: '¿Cómo pido reseñas sin molestar al cliente?',
    a: 'Después de entregar el producto o terminar el servicio, envía un mensaje corto por WhatsApp o correo con el enlace directo de reseñas y una sola frase de agradecimiento. Pide una, no insistas.',
  },
  {
    q: '¿Qué hago si me dejan una reseña negativa?',
    a: 'Responde dentro de 48 horas, con calma: agradece, ofrece solución concreta y lleva la conversación a un canal privado. Nunca discutas en público ni borres la reseña presionando.',
  },
  {
    q: '¿Puedo pagar por reseñas?',
    a: 'No. Comprar reseñas o intercambiarlas por descuentos viola las políticas de Google y puede costarte la suspensión de la ficha. Además, los clientes notan las valoraciones falsas y pierden confianza.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  datePublished: dates.published,
  dateModified: dates.modified,
  inLanguage: 'es-CO',
  about: { '@type': 'Thing', name: 'Reseñas en línea' },
  author: authorRef,
  publisher: { '@id': 'https://www.presentto.online/#organization' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://www.presentto.online/guias/resenas-google/#webpage' },
  breadcrumb: { '@id': 'https://www.presentto.online/guias/resenas-google/#breadcrumb' },
};
---

<BaseLayout title={title} description={description} path="/guias/resenas-google/" breadcrumbs={crumbs} jsonld={[articleSchema]} article={{ publishedTime: dates.published, modifiedTime: dates.modified }}>
  <Breadcrumbs items={crumbs} />

  <ArticleLayout
    eyebrow="REPUTACIÓN · GUÍA"
    title="Reseñas de Google sin riesgos"
    lead="Cómo pedirlas, cómo contestarlas y qué no hacer nunca."
    published={dates.published}
    modified={dates.modified}
    toc={true}
  >
    <h2 id="por-que-importan">Por qué importan</h2>
    <p class="snippet">Las reseñas son la prueba social que mira un cliente antes de escribirte. Influyen en qué tan seguido visitas tu ficha y en si deciden contactarte.</p>

    <h2 id="como-pedirlas">Cómo pedirlas</h2>
    <ul>
      <li>Elige el momento justo: justo después de una buena experiencia.</li>
      <li>Envía un mensaje breve con el enlace directo de reseñas de tu ficha.</li>
      <li>Pide una sola vez. Un recordatorio amable al mes es suficiente.</li>
      <li>Facilita el trabajo: un mensaje de WhatsApp ya preparado para que tus clientes solo toquen "enviar".</li>
    </ul>

    <h2 id="como-responderlas">Cómo responderlas</h2>
    <ul>
      <li>Positivas: agradece mencionando el producto o servicio.</li>
      <li>Negativas: responde rápido, con empatía, ofrece solución y mueve el caso a un canal privado.</li>
      <li>No respondas con descuentos ni ofrezcas nada a cambio de cambiar la reseña.</li>
    </ul>

    <h2 id="lo-que-nunca-debes-hacer">Lo que nunca debes hacer</h2>
    <ul>
      <li>Comprar reseñas o pedirlas a cuentas falsas.</li>
      <li>Ofrecer beneficios a quien deje cinco estrellas.</li>
      <li>Escribir reseñas sobre tu propio negocio desde tu cuenta personal.</li>
    </ul>

    <div class="guide-cta">
      <p><strong>¿Quieres una web que refuerce tu reputación?</strong></p>
      <a class="btn btn-primary" href={ctaSession} target="_blank" rel="noopener" data-magnetic>
        Agendar mi sesión 1 <span>↗</span>
      </a>
    </div>

    <AuthorBox name="Dilan Andrei Cifuentes Ortiz" role="Fundador y responsable editorial · Presentto Online" />
  </ArticleLayout>

  <section class="section wrap" id="preguntas-frecuentes">
    <div class="section-head">
      <p class="eyebrow">PREGUNTAS FRECUENTES</p>
      <h2 data-split>Dudas sobre <em>reseñas de Google.</em></h2>
    </div>
    <FaqList faqs={faqs} />
  </section>

  <FinalCta
    eyebrow="EMPIEZA HOY"
    title="Ve tu web antes de pagar. <em>Decide después.</em>"
    note="Agenda tu sesión 1 por Google Meet · Sin compromiso · Respuesta por WhatsApp en horario hábil"
  />
</BaseLayout>
