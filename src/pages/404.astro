---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';

const crumbs = [{ label: 'Inicio', href: '/' }, { label: '404' }];

const title = 'Página no encontrada | Presentto Online';
const description =
  'La página que buscas no existe. Vuelve al inicio, revisa los planes o entra a las guías de presencia digital de Presentto Online.';

const routes = [
  {
    tag: '01 · PLANES',
    title: 'Planes y precios',
    copy: 'Cuatro planes desde $100.000 COP/mes, IVA incluido, mensual o anual con 15% de descuento.',
    href: '/precios/',
    cta: 'Ver precios',
  },
  {
    tag: '02 · SERVICIO',
    title: 'Qué administramos',
    copy: 'Web, ficha de Google, analítica, sistemas y flujos de IA en un solo servicio con SLA publicado.',
    href: '/servicios/',
    cta: 'Ver servicio',
  },
  {
    tag: '03 · TRABAJO REAL',
    title: 'Sitios publicados',
    copy: '15 clientes en producción sobre *.presentto.online, con su rubro, su identidad y su base técnica.',
    href: '/sitios/',
    cta: 'Ver sitios',
  },
];
---

<BaseLayout title={title} description={description} path="/404/" breadcrumbs={crumbs} noindex={true}>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow="ERROR 404"
    title="Esta página <em>no existe.</em>"
    lead="Puede que el enlace haya cambiado o que la página se haya movido. Vuelve al inicio, entra al servicio o escríbenos por contacto."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href="/">Ir al inicio <span>↗</span></a>
      <a class="btn btn-ghost" href="/servicios/">Ver servicio <span>↗</span></a>
      <a class="btn btn-ghost" href="/contacto/">Contacto <span>↗</span></a>
    </Fragment>
    <Fragment slot="meta">
      <span class="tag">Error 404</span>
      <span class="tag">Contenido movido</span>
      <span class="tag">Presentto Online</span>
    </Fragment>
  </PageHero>

  <section class="section wrap">
    <div class="section-head center">
      <p class="eyebrow">MIENTRAS TANTO</p>
      <h2 data-split>Prueba por uno de estos <em>lados.</em></h2>
      <p class="lead">
        Los recorridos más útiles del sitio: qué cuesta, qué incluye y qué hemos publicado ya.
      </p>
    </div>
    <div class="card-grid cols-3" data-stagger>
      {routes.map((route) => (
        <article class="card reveal" data-tilt="6">
          <p class="eyebrow">{route.tag}</p>
          <h3>{route.title}</h3>
          <p>{route.copy}</p>
          <a class="btn btn-ghost btn-sm" href={route.href}>
            {route.cta} <span>↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
