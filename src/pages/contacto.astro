---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PlansGrid from '../components/PlansGrid.astro';
import PageHero from '../components/PageHero.astro';
import { ctaSession, waDirect } from '../data/business';

const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Contacto' }];

const title = 'Contacto, planes y sesión 1 | Presentto Online';
const description =
  'Agenda tu sesión 1 por WhatsApp o cuéntanos de tu negocio: te asesoramos sobre MVO desde $15.000/mes o dominio propio desde $40.000.';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto Presentto Online',
  url: 'https://www.presentto.online/contacto/',
  inLanguage: 'es-CO',
  about: { '@id': 'https://www.presentto.online/#organization' },
  mainEntity: {
    '@type': 'Organization',
    '@id': 'https://www.presentto.online/#organization',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path="/contacto/"
  breadcrumbs={crumbs}
  plansOffers={true}
  jsonld={[contactSchema]}
>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow="HABLEMOS · SESIÓN 1"
    title="Tu posición en Google <em>empieza aquí.</em>"
    lead="Agenda tu sesión 1 por WhatsApp (lo más rápido) o cuéntanos de tu negocio por el formulario: te asesoramos sobre el plan ideal, MVO en subdominio o dominio propio, y resolvemos dudas antes de que pagues."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={ctaSession} target="_blank" rel="noopener" data-magnetic>
        Agendar mi sesión 1 <span>↗</span>
      </a>
      <a class="btn btn-ghost" href="#formulario">Escribir el formulario <span>↓</span></a>
    </Fragment>
    <Fragment slot="meta">
      <span class="tag">Respuesta en horario hábil</span>
      <span class="tag">Sin compromiso</span>
      <span class="tag">Sabana Occidental y Colombia</span>
    </Fragment>
  </PageHero>

  <section class="section wrap" id="formulario">
    <div class="contact-layout">
      <form
        id="contactForm"
        class="contact-form"
        action="https://formspree.io/f/maeydzwd"
        method="POST"
      >
        <label>¿Cómo te llamas?
          <input name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre" />
        </label>
        <label>Nombre de tu negocio
          <input name="negocio" type="text" required autocomplete="organization" placeholder="Nombre del negocio" />
        </label>
        <label>Correo electrónico
          <input name="email" type="email" required autocomplete="email" placeholder="tu@correo.com" />
        </label>
        <label>WhatsApp o teléfono
          <input name="telefono" type="tel" required autocomplete="tel" placeholder="+57 300 000 0000" />
        </label>
        <fieldset>
          <legend>¿Qué quieres lograr?</legend>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Vender más" /> Vender más</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Verse más profesional" /> Verse más profesional</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Llegar a nuevos clientes" /> Llegar a nuevos clientes</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Aparecer en Google" /> Aparecer en Google</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Mostrar servicios o productos" /> Mostrar servicios o productos</label>
        </fieldset>
        <label>¿Algo más que debamos saber?
          <textarea name="necesidades_extra" rows="5" placeholder="Textos, fotos, horarios, si ya tienes dominio… lo que nos sirva para conocerte"></textarea>
        </label>
        <label class="checkbox-option privacy-option">
          <input name="privacidad" type="checkbox" required value="aceptada" />
          Acepto el tratamiento de mis datos según la
          <a href="/privacidad/" target="_blank" rel="noopener">política de privacidad</a>.
        </label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
        <button class="btn btn-primary" type="submit">Quiero mi asesoría <span>↗</span></button>
        <p class="form-note">
          Respondemos por WhatsApp o correo en horario hábil. El MVO arranca desde $15.000/mes y los
          planes con dominio propio desde $40.000/mes de prepago; ambos con 3 sesiones por Google
          Meet y administración incluida.
        </p>
        <p id="formStatus" role="status" aria-live="polite"></p>
      </form>
      <aside class="contact-aside">
        <p class="eyebrow">CONTACTO DIRECTO</p>
        <h2>Hablemos claro.</h2>
        <ol class="contact-steps">
          <li><b>01</b> Nos cuentas de tu negocio y tus metas de visibilidad</li>
          <li><b>02</b> Coordinamos tu sesión 1 y construimos tu web</li>
          <li><b>03</b> Apruebas en Meet, pagas y publicamos tu presencia</li>
        </ol>
        <p>
          Sin formularios eternos ni reuniones obligatorias. Nos escribes, entendemos qué necesitas
          y te mostramos cómo se vería tu web antes de que decidas.
        </p>
        <div class="actions">
          <a class="btn btn-ghost btn-sm" href={ctaSession} target="_blank" rel="noopener" data-magnetic>
            Agendar sesión 1 <span>↗</span>
          </a>
          <a class="btn btn-ghost btn-sm" href={waDirect} target="_blank" rel="noopener">
            WhatsApp directo <span>↗</span>
          </a>
        </div>
        <p class="muted">
          Sabana Occidental, Colombia<br />
          <a href="mailto:inbox@presentto.online">inbox@presentto.online</a>
        </p>
      </aside>
    </div>
  </section>

  <PlansGrid id="planes" heading={true} />
</BaseLayout>
