---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PlansGrid from '../components/PlansGrid.astro';
import PageHero from '../components/PageHero.astro';
import { ctaDiagnostico, waDirect, business, serviceHours } from '../data/business';

const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Contacto' }];

const title = 'Diagnóstico digital gratis | Presentto Online';
const description =
  'Cuéntanos qué tienes hoy y qué necesitas. Revisamos tu web, ficha de Google y redes en 20 minutos. Sin compromiso y con plan claro.';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto Presentto Online',
  url: 'https://www.presentto.online/contacto/',
  inLanguage: 'es-CO',
  about: { '@id': 'https://www.presentto.online/#organization' },
  mainEntity: {
    '@type': 'Organization',
    '@id': 'https://www.presentto.online/#organization',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path="/contacto/"
  breadcrumbs={crumbs}
  plansOffers={true}
  jsonld={[contactSchema]}
>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow="DIAGNÓSTICO GRATUITO"
    title="Revisamos tu presencia. <em>Tú decides después.</em>"
    lead="En 20 minutos vemos qué tienes, qué falta y qué plan aplica. Sin compromiso, sin reuniones eternas y con un presupuesto claro antes de pagar."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
        Pedir diagnóstico <span>↗</span>
      </a>
      <a class="btn btn-ghost" href="#formulario">Escribir el formulario <span>↓</span></a>
    </Fragment>
    <Fragment slot="meta">
      <span class="tag">20 minutos</span>
      <span class="tag">Sin compromiso</span>
      <span class="tag">Humano {serviceHours.human}</span>
    </Fragment>
  </PageHero>

  <section class="section wrap" id="formulario">
    <div class="contact-layout">
      <form
        id="contactForm"
        class="contact-form"
        action="https://formspree.io/f/maeydzwd"
        method="POST"
      >
        <label>¿Cómo te llamas?
          <input name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre" />
        </label>
        <label>Nombre de tu negocio
          <input name="negocio" type="text" required autocomplete="organization" placeholder="Nombre del negocio" />
        </label>
        <label>Correo electrónico
          <input name="email" type="email" required autocomplete="email" placeholder="tu@correo.com" />
        </label>
        <label>WhatsApp o teléfono
          <input name="telefono" type="tel" required autocomplete="tel" placeholder="+57 300 000 0000" />
        </label>
        <fieldset>
          <legend>¿Qué tienes hoy?</legend>
          <label class="checkbox-option"><input name="activos" type="checkbox" value="Web" /> Web</label>
          <label class="checkbox-option"><input name="activos" type="checkbox" value="Ficha de Google" /> Ficha de Google</label>
          <label class="checkbox-option"><input name="activos" type="checkbox" value="Instagram o Facebook" /> Instagram o Facebook</label>
          <label class="checkbox-option"><input name="activos" type="checkbox" value="Nada todavía" /> Nada todavía</label>
        </fieldset>
        <fieldset>
          <legend>¿Qué necesitas?</legend>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Administración web" /> Administración web</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Web nueva" /> Web nueva</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Aparecer en Google" /> Aparecer en Google</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Sistemas web" /> Sistemas web (reservas, catálogo, portal)</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="IA y automatizaciones" /> IA y automatizaciones</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="No estoy seguro" /> No estoy seguro</label>
        </fieldset>
        <label>¿Algo más que debamos saber?
          <textarea name="necesidades_extra" rows="5" placeholder="Si ya tienes web, dominio, accesos o una idea de lo que quieres lograr"></textarea>
        </label>
        <label class="checkbox-option privacy-option">
          <input name="privacidad" type="checkbox" required value="aceptada" />
          Acepto el tratamiento de mis datos según la
          <a href="/privacidad/" target="_blank" rel="noopener">política de privacidad</a>.
        </label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
        <button class="btn btn-primary" type="submit">Pedir mi diagnóstico <span>↗</span></button>
        <p class="form-note">
          Respondemos por WhatsApp o correo en horario hábil. Revisamos tu web, ficha de Google y
          redes; si no tienes nada, partimos de cero. El plan Presencia arranca en $100.000/mes.
        </p>
        <p id="formStatus" role="status" aria-live="polite"></p>
      </form>
      <aside class="contact-aside">
        <p class="eyebrow">QUÉ PASA DESPUÉS</p>
        <h2>Sin vueltas.</h2>
        <ol class="contact-steps">
          <li><b>01</b> Revisamos tu presencia actual y detectamos lo que frena al negocio</li>
          <li><b>02</b> Te decimos qué plan aplica y qué incluye el setup</li>
          <li><b>03</b> Apruebas, pagas y arrancamos con el plan de 30 días</li>
        </ol>
        <p>
          Si no tienes web, también aplica. Si ya tienes una, la auditamos antes de proponer
          cambios. Nada de rehacer por rehacer.
        </p>
        <div class="actions">
          <a class="btn btn-ghost btn-sm" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
            Agendar diagnóstico <span>↗</span>
          </a>
          <a class="btn btn-ghost btn-sm" href={waDirect} target="_blank" rel="noopener">
            WhatsApp directo <span>↗</span>
          </a>
        </div>
        <p class="muted">
          Sabana Occidental, Colombia<br />
          <a href={`mailto:${business.email}`}>{business.email}</a><br />
          Atención humana {serviceHours.human}
        </p>
      </aside>
    </div>
  </section>

  <PlansGrid id="planes" heading={true} />
</BaseLayout>
