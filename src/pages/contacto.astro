---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PlansGrid from '../components/PlansGrid.astro';
import { localBusinessSchema } from '../components/schemas';

const title = 'Contacto y planes | Presentto Online';
const description =
  'Pide tu demo gratis o asesoría sobre los planes Presenttación Digital desde $40.000 COP/mes con web, dominio y SEO local.';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto Presentto Online',
  url: 'https://www.presentto.online/contacto/',
  inLanguage: 'es-CO',
  about: { '@id': 'https://www.presentto.online/#organization' },
  mainEntity: {
    '@type': 'Organization',
    '@id': 'https://www.presentto.online/#organization',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path="/contacto/"
  jsonld={[contactSchema, localBusinessSchema]}
>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Contacto' }]} />

  <section class="section wrap contact-page">
    <p class="eyebrow">HABLEMOS</p>
    <h1>Tu presencia online <em>empieza aquí.</em></h1>
    <p class="lead">
      Cuéntanos de tu negocio y te enviamos una demo gratis o te asesoramos sobre el plan ideal. También
      puedes elegir y pagar tu plan directo con Mercado Pago.
    </p>
    <div class="contact-layout">
      <form
        id="contactForm"
        class="contact-form"
        action="https://formspree.io/f/maeydzwd"
        method="POST"
      >
        <label>¿Cómo te llamas?
          <input name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre" />
        </label>
        <label>Nombre de tu negocio
          <input name="negocio" type="text" required autocomplete="organization" placeholder="Nombre del negocio" />
        </label>
        <label>Correo electrónico
          <input name="email" type="email" required autocomplete="email" placeholder="tu@correo.com" />
        </label>
        <label>WhatsApp o teléfono
          <input name="telefono" type="tel" required autocomplete="tel" placeholder="+57 300 000 0000" />
        </label>
        <fieldset>
          <legend>¿Qué quieres lograr?</legend>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Vender más" /> Vender más</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Verse más profesional" /> Verse más profesional</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Llegar a nuevos clientes" /> Llegar a nuevos clientes</label>
          <label class="checkbox-option"><input name="objetivos" type="checkbox" value="Mostrar servicios o productos" /> Mostrar servicios o productos</label>
        </fieldset>
        <label>¿Algo más que debamos saber?
          <textarea name="necesidades_extra" rows="5" placeholder="Textos, fotos, horarios, si ya tienes dominio… lo que nos sirva para tu demo"></textarea>
        </label>
        <label class="checkbox-option privacy-option">
          <input name="privacidad" type="checkbox" required value="aceptada" />
          Acepto el tratamiento de mis datos según la
          <a href="/privacidad/" target="_blank">política de privacidad</a>.
        </label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
        <button class="button primary" type="submit">Quiero mi demo o asesoría <span>↗</span></button>
        <p class="form-note">Respondemos por WhatsApp o correo en horario hábil. Puedes pedir la demo sin abono o elegir un plan y pagarlo cuando quieras.</p>
        <p id="formStatus" role="status" aria-live="polite"></p>
      </form>
      <aside class="contact-aside">
        <p class="eyebrow">CONTACTO DIRECTO</p>
        <h2>Hablemos claro.</h2>
        <ol class="contact-steps">
          <li><b>01</b> Nos cuentas de tu negocio</li>
          <li><b>02</b> Te enviamos tu demo gratis</li>
          <li><b>03</b> Apruebas, pagas y publicamos</li>
        </ol>
        <p>Sin formularios eternos ni reuniones obligatorias. Nos escribes, entendemos qué necesitas y te mostramos cómo se vería tu web.</p>
        <div class="contact-aside-actions">
          <a
            class="button ghost"
            href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20asesor%C3%ADa%20sobre%20los%20planes"
            target="_blank"
            rel="noopener"
          >
            WhatsApp <span>↗</span>
          </a>
          <a
            class="button ghost"
            href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
            target="_blank"
            rel="noopener"
          >
            Demo gratis <span>↗</span>
          </a>
        </div>
        <p class="muted">
          Sabana Occidental, Colombia<br />
          <a href="mailto:inbox@presentto.online">inbox@presentto.online</a>
        </p>
      </aside>
    </div>
  </section>

  <PlansGrid id="planes" heading={true} />
</BaseLayout>
