---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import PlansGrid from '../components/PlansGrid.astro';
import PlanFinder from '../components/PlanFinder.astro';
import PlanComparison from '../components/PlanComparison.astro';
import SlaTable from '../components/SlaTable.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { addons, cop, prepaid } from '../data/service';
import { ctaDiagnostico } from '../data/business';

const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Precios' }];

const title = 'Planes de administración web desde $100.000/mes | Presentto';
const description =
  '4 planes de administración web y presencia digital: $100.000, $299.000, $640.000 y desde $1.450.000 COP/mes. Prepago anual −15%. IVA incluido.';

const faqs = [
  {
    q: '¿Es una mensualidad o un pago único?',
    a: 'Es un servicio continuo. Pagas el mes o el año por adelantado, sin suscripción automática y sin cargos sorpresa. Al terminar el plazo decides si renuevas. El setup inicial es un pago único que cubre auditoría, migración y configuración.',
  },
  {
    q: '¿Por qué hay un setup?',
    a: 'Porque antes de operar hay que diagnosticar, migrar o construir la base, configurar dominio, correo, analítica y ficha de Google. Ese trabajo se hace una vez. En Presencia y Crecimiento cuesta $250.000; en Sistemas, $750.000; en Empresa se cotiza.',
  },
  {
    q: '¿Qué pasa si necesito más cambios de los incluidos?',
    a: 'Se cotizan aparte. Un cambio es una solicitud de hasta 30 minutos que modifica contenido existente. Las secciones nuevas, páginas, funcionalidades e integraciones no cuentan como cambio.',
  },
  {
    q: '¿El precio incluye pauta publicitaria?',
    a: 'No. La inversión en Google Ads o Meta Ads se paga directamente a la plataforma. La gestión de campaña es un add-on de $400.000/mes más la inversión.',
  },
  {
    q: '¿Puedo cambiar de plan?',
    a: 'Sí. Subir de plan aplica desde el siguiente ciclo; bajar de plan aplica al renovar. No hay penalización por cambiar.',
  },
  {
    q: '¿Hay descuento por pago anual?',
    a: 'Sí: 15%, equivalente a dos meses. Presencia $1.020.000/año, Crecimiento $3.050.000/año y Sistemas $6.530.000/año. Empresa se cotiza según alcance.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/precios/"
  breadcrumbs={crumbs}
  plansOffers={true} faqs={faqs}>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow="PLANES Y PRECIOS"
    title="Precios claros. <em>Alcance claro.</em>"
    lead="Cuatro planes para cuatro momentos del negocio. Todos incluyen administración web, ficha de Google, analítica y soporte. Mensual o anual con 15% de descuento. COP con IVA incluido."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
        Diagnóstico gratis <span>↗</span>
      </a>
      <a class="btn btn-ghost" href="#planes">Comparar planes <span>↓</span></a>
    </Fragment>
    <Fragment slot="meta">
      <span class="tag">Desde $100.000/mes</span>
      <span class="tag">IVA incluido</span>
      <span class="tag">Mensual o anual</span>
      <span class="tag">Sin cargo automático</span>
    </Fragment>
  </PageHero>

  <PlanFinder />

  <PlansGrid />

  <PlanComparison />

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">COMPROMISO DE SERVICIO</p>
        <h2 data-split>Qué puedes exigir <em>en cada plan.</em></h2>
      </div>
      <p class="lead">
        Tiempos publicados, no promesas vagas. Si algo no se cumple, lo revisamos y ajustamos el
        plan contigo.
      </p>
    </div>
    <SlaTable />
  </section>

  <TrustStrip compact />

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">SERVICIOS ADICIONALES</p>
        <h2 data-split>Cuando necesitas <em>algo puntual.</em></h2>
      </div>
      <p class="lead">
        Add-ons con precio cerrado. Se suman al plan o se contratan sueltos.
      </p>
    </div>
    <div class="addon-grid" data-stagger>
      {addons.map((addon) => (
        <article class="addon-card reveal">
          <h3>{addon.name}</h3>
          <p>{addon.detail}</p>
          <strong>{cop(addon.price)} <span>{addon.unit}</span></strong>
        </article>
      ))}
    </div>
    <p class="stack-note">{prepaid.note} El setup y los add-ons se pagan una sola vez.</p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">PREGUNTAS DE PRECIO</p>
        <h2 data-split>Dudas sobre <em>planes y pagos.</em></h2>
      </div>
      <p class="lead">
        Sin letra pequeña. Si tu caso es distinto, lo vemos en el diagnóstico gratuito.
      </p>
    </div>
    <FaqList faqs={faqs} />
  </section>

  <FinalCta
    eyebrow="EMPIEZA SIN RIESGO"
    title="Primero el diagnóstico. <em>Después el plan.</em>"
    note="20 minutos por Google Meet o WhatsApp · Sin compromiso · Presupuesto antes de pagar"
  />
</BaseLayout>
