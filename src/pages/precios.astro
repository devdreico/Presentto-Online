---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import PlansGrid from '../components/PlansGrid.astro';
const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Precios' }];

const title = 'Precios: planes de web administrada y SEO local | Presentto';
const description =
  'Planes desde $40.000 COP (1 mes) hasta $350.000 COP (1 año), IVA incluido. Prepago por plazo, sin suscripción ni permanencia. Demo gratis antes de pagar.';

const faqs = [
  {
    q: '¿Es una mensualidad o un pago único?',
    a: 'Es prepago por plazo, no una suscripción: 1 mes $40.000 · 3 meses $100.000 · 6 meses $190.000 · 1 año $350.000 COP. Pagas una sola vez el plazo que elijas (Mercado Pago, IVA incluido) y no se te cobra nada automáticamente al final.',
  },
  {
    q: '¿Qué incluye cada plan?',
    a: 'Web lista con tu contenido y fotos, dominio propio, correo profesional, SEO on-page y técnico, datos estructurados schema, SEO local por municipio, orientación de ficha de Google Business Profile, ajustes durante el plan y administración por Presentto.',
  },
  {
    q: '¿Puedo ver la web antes de pagar?',
    a: 'Sí. La demo es gratis y sin abono: la construimos con la información de tu negocio, la ves, pides cambios y solo pagas cuando decides contratar.',
  },
  {
    q: '¿Hay costos ocultos o permanencia?',
    a: 'No. Todos los precios incluyen IVA y el pago es único por el plazo elegido. No hay permanencia obligatoria: al finalizar el plan decides tú si continúas, sin cargos automáticos ni multas.',
  },
  {
    q: '¿Por qué es más barato que una agencia?',
    a: 'Las agencias suelen cotizar sitios desde $800.000 a $3.000.000 COP más mantenimiento mensual. Presentto trabaja con una oferta estandarizada y administrada para negocios locales de la Sabana Occidental, por eso puede mantener precios desde $40.000 COP/mes sin sacrificar dominio, correo ni SEO local.',
  },
];
// FAQPage: solo preguntas exclusivas de esta página (el hub /preguntas/ es el
// canónico para las compartidas)
const sharedWithFaqHub = new Set([
  '¿Es una mensualidad o un pago único?',
  '¿Puedo ver la web antes de pagar?',
]);
const faqSchema = faqs.filter((f) => !sharedWithFaqHub.has(f.q));
---

<BaseLayout title={title} description={description} path="/precios/" breadcrumbs={crumbs} faqs={faqSchema} plansOffers={true}>
  <Breadcrumbs items={crumbs} />

  <section class="section wrap page-hero">
    <p class="eyebrow">PLANES Y PRECIOS</p>
    <h1>Precios claros. <em>Sin sorpresas ni letra pequeña.</em></h1>
    <p class="lead">
      Un solo servicio, cuatro plazos de prepago. Todo incluido: web, dominio, correo, SEO on-page,
      SEO local y administración. IVA incluido, sin suscripción automática y con demo gratis antes
      de pagar. Cobramos en COP: el plan de 1 mes equivale a ≈ US$10 al mes de ese plazo (referencia).
    </p>
    <div class="actions">
      <a
        class="button primary"
        href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20una%20demo%20gratis%20antes%20de%20elegir%20plan"
        target="_blank"
        rel="noopener"
      >
        Pedir mi demo gratis <span>↗</span>
      </a>
      <a class="button ghost" href="#planes">Ver los 4 planes <span>↓</span></a>
    </div>
  </section>

  <PlansGrid />

  <section class="section wrap">
    <div class="section-heading">
      <p class="eyebrow">COMPARATIVA HONESTA</p>
      <h2>Qué cuesta lo mismo <em>en el mercado.</em></h2>
      <p>
        Referencias reales de la industria para que compares con contexto. Presentto cubre la
        presencia completa de un negocio local desde el plan más bajo.
      </p>
    </div>
    <div class="service-list">
      <article class="service-card">
        <h3>Agencia tradicional</h3>
        <p>
          Diseño a medida desde <strong>$800.000 a $3.000.000 COP</strong> + mantenimiento mensual,
          y SEO local por separado desde $1.500.000 COP/mes. Contratos y tiempos más largos.
        </p>
      </article>
      <article class="service-card">
        <h3>Herramientas “hazlo tú mismo”</h3>
        <p>
          Desde <strong>~20 USD/mes</strong> de plataforma, más tu tiempo: tú escribes, tú optimizas,
          tú resuelves soporte. Sin contenido ni SEO local hechos por ti.
        </p>
      </article>
      <article class="service-card">
        <h3>Presentto</h3>
        <p>
          <strong>Desde $40.000 COP/mes</strong> (prepago por plazo): web publicada con tu contenido,
          dominio, correo, SEO local y administración incluidos. Demo gratis antes de pagar.
        </p>
      </article>
    </div>
  </section>

  <section class="section wrap faq-section">
    <div class="section-heading">
      <p class="eyebrow">PREGUNTAS DE PRECIO</p>
      <h2>Dudas frecuentes <em>sobre planes y pagos.</em></h2>
    </div>
    <FaqList faqs={faqs} />
    <p class="stack-note">
      ¿Otras dudas? Ver <a href="/preguntas/">todas las preguntas frecuentes</a> o
      <a href="/comparativas/">comparar opciones de web y SEO</a>.
    </p>
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">EMPEZA SIN RIESGO</p>
      <h2>Primero ves tu web. <em>Pagas solo si te gusta.</em></h2>
      <div class="actions">
        <a
          class="button light"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
          target="_blank"
          rel="noopener"
        >
          Pedir mi demo gratis <span>↗</span>
        </a>
        <a class="button ghost light-ghost" href="/contacto/">Hablar con el equipo</a>
      </div>
    </div>
  </section>
</BaseLayout>
