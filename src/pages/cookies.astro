---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';

const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Cookies' }];

const title = 'Política de cookies | Presentto Online';
const description =
  'Información sobre las cookies técnicas y de medición utilizadas por Presentto Online y cómo gestionar tu consentimiento.';
---

<BaseLayout title={title} description={description} path="/cookies/" breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow="COOKIES"
    title="Una navegación más <em>simple.</em>"
    lead="Información sobre las cookies técnicas y de medición que usa Presentto Online y cómo gestionar tu consentimiento en cualquier momento."
  >
    <Fragment slot="meta">
      <span class="tag">Cookie necesaria</span>
      <span class="tag">Analítica opcional</span>
      <span class="tag">Consentimiento reversible</span>
    </Fragment>
  </PageHero>

  <section class="section wrap">
    <div class="info-page">
      <article class="info-block">
        <h2>Presentto utiliza una cookie necesaria para guardar tu decisión de consentimiento.</h2>
        <p>
          La cookie necesaria (<code>presentto-consent</code>) mantiene la navegación y tus
          preferencias básicas. Las cookies opcionales de analítica solo se activan si las autorizas.
          Puedes cambiar o retirar tu decisión borrando las cookies del dominio desde tu navegador.
        </p>
      </article>

      <article class="info-block">
        <h2>Qué cookies usamos</h2>
        <ul>
          <li><strong>presentto-consent</strong> — necesaria. Guarda si aceptaste solo las necesarias o todas.</li>
          <li><strong>presentto-analytics</strong> — opcional. Solo se activa con tu permiso expreso.</li>
        </ul>
      </article>

      <article class="info-block">
        <h2>Cómo gestionarlas</h2>
        <p>
          Puedes borrar las cookies de este dominio en la configuración de tu navegador (Chrome,
          Firefox, Safari o Edge). Al hacerlo, volveremos a pedirte tu preferencia en la próxima
          visita.
        </p>
        <p>Última actualización: septiembre de 2026.</p>
      </article>
    </div>
  </section>
</BaseLayout>
