---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import PlansGrid from '../components/PlansGrid.astro';
import { localBusinessSchema } from '../components/schemas';

const title = 'Servicios web y SEO local | Presentto Online';
const description =
  'Presenttación Digital desde $40.000 COP/mes: web profesional, dominio, correo, SEO local y administración. Pide tu demo gratis, sin abono.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Presenttación Digital',
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: [
    { '@type': 'Place', name: 'Funza' },
    { '@type': 'Place', name: 'Mosquera' },
    { '@type': 'Place', name: 'Madrid' },
    { '@type': 'Place', name: 'Facatativá' },
  ],
  serviceType: 'Diseño y administración de páginas web con SEO local',
  offers: [
    { '@type': 'Offer', name: '1 mes', price: '40000', priceCurrency: 'COP', url: 'https://mpago.li/2j4gTPj' },
    { '@type': 'Offer', name: '3 meses', price: '100000', priceCurrency: 'COP', url: 'https://mpago.li/17JYVwX' },
    { '@type': 'Offer', name: '6 meses', price: '190000', priceCurrency: 'COP', url: 'https://mpago.li/1j4eF1j' },
    { '@type': 'Offer', name: '1 año', price: '350000', priceCurrency: 'COP', url: 'https://mpago.li/344eu17' },
  ],
};

const clientSites = [
  { name: 'Botane', host: 'botane.presentto.online', url: 'https://botane.presentto.online/' },
  { name: 'KSPR', host: 'kspr.presentto.online', url: 'https://kspr.presentto.online/' },
  { name: 'Esturel', host: 'esturel.presentto.online', url: 'https://esturel.presentto.online/' },
  { name: 'LYL', host: 'lyl.presentto.online', url: 'https://lyl.presentto.online/' },
  { name: 'Viking Dogs', host: 'vikingdogs.presentto.online', url: 'https://vikingdogs.presentto.online/' },
  { name: 'YA', host: 'ya.presentto.online', url: 'https://ya.presentto.online/' },
  { name: 'Knifopics', host: 'knifopics.presentto.online', url: 'https://knifopics.presentto.online/' },
  { name: 'Aeperion', host: 'aeperion.presentto.online', url: 'https://aeperion.presentto.online/' },
  { name: 'USPKH', host: 'uspkh.presentto.online', url: 'https://uspkh.presentto.online/' },
];

const clientsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sitios publicados con Presenttación Digital',
  url: 'https://www.presentto.online/servicios/',
  itemListElement: clientSites.map((site, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: site.name,
    url: site.url,
  })),
};

const faqs = [
  {
    q: '¿Qué incluye la Presenttación Digital?',
    a: 'Todo lo esencial para existir en internet y verte profesional: web con tu contenido, dominio propio, correo profesional, SEO local, códigos QR, ajustes durante el plan y administración por Presentto. Desde $40.000 COP/mes, IVA incluido.',
  },
  {
    q: '¿Cuánto cuesta y cómo se paga?',
    a: 'Planes de prepago: 1 mes $40.000 · 3 meses $100.000 · 6 meses $190.000 · 1 año $350.000 COP, todos con IVA incluido. Es un pago único por el plazo elegido vía Mercado Pago, sin suscripción automática. Puedes pedir tu demo gratis antes de pagar.',
  },
  {
    q: '¿Qué incluye el dominio y correo profesional?',
    a: 'La Presenttación Digital incluye el dominio propio tuempresa.online y 1 correo profesional @tuempresa.online. Si ya tienes un dominio, puedes aportarlo sin costo adicional.',
  },
  {
    q: '¿Cómo se configura el SEO local?',
    a: 'Se estructura el contenido, títulos, descripciones, datos locales y elementos técnicos para ayudar a que el negocio sea encontrado en Funza, Mosquera, Madrid, Facatativá y la Sabana Occidental. También orientamos tu ficha de Google Business Profile.',
  },
  {
    q: '¿Quiénes ya tienen un sitio con Presentto?',
    a: 'Negocios y proyectos como Botane, KSPR, Esturel, LYL, Viking Dogs, YA, Knifopics, Aeperion y USPKH ya publicaron sus sitios en *.presentto.online. Puedes visitarlos en esta página o en la lista de sitios publicados.',
  },
  {
    q: '¿Puedo ver una demo antes de pagar?',
    a: 'Sí, y es lo recomendado. Solicitas la demo web de tu negocio sin abono y sin compromiso; la ves, pides cambios y solo pagas cuando decides contratar el plan que prefieras.',
  },
];
---

<BaseLayout title={title} description={description} path="/servicios/" jsonld={[serviceSchema, localBusinessSchema, clientsSchema]}>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios' }]} />

  <section class="section wrap page-hero">
    <p class="eyebrow">SERVICIOS PRESENTTO</p>
    <img
      class="page-logo"
      src="/assets/img/Presentto-Slogan-Fondo-Transparente.webp"
      alt="Tu negocio en internet. Sin complicaciones."
      width="280"
      height="108"
      fetchpriority="high"
      decoding="async"
    />
    <h1>Una solución. <em>Una presencia real.</em></h1>
    <p class="lead">
      Presenttación Digital: creamos, publicamos y mantenemos la web de tu negocio. Tú te dedicas a atender;
      nosotros a que te encuentren. Entrega en pocos días hábiles.
    </p>
    <div class="actions">
      <a
        class="button primary"
        href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
        target="_blank"
        rel="noopener"
      >
        Pedir mi demo gratis <span>↗</span>
      </a>
      <a class="button ghost" href="#planes">Ver planes <span>↓</span></a>
    </div>
  </section>

  <section class="section services-section">
    <div class="wrap service-list">
      <article class="service-card service-main">
        <div class="service-number">01</div>
        <div>
          <p class="eyebrow">SERVICIO PRINCIPAL</p>
          <h2>Presenttación <em>Digital</em></h2>
          <p>
            Recibes una web lista para tu negocio: información, fotos, datos de contacto y lo esencial para
            vender. Nosotros construimos, publicamos y ajustamos contigo hasta dejarla lista. Sin instalar
            nada y sin pelear con herramientas.
          </p>
          <ul>
            <li>Creación personalizada con tus imágenes, tu estilo y tu contenido real.</li>
            <li>Dominio propio incluido: <strong>tuempresa.online</strong>.</li>
            <li>1 correo profesional: <strong>@tuempresa.online</strong>.</li>
            <li>Ajustes durante todo el plan, sin costo extra.</li>
            <li>SEO local para que aparezcan en búsquedas de la Sabana Occidental.</li>
            <li>Códigos QR para compartir tu web en tarjetas, menús y escaparates.</li>
            <li>Sin permanencia: eliges el plan y decides si renuevas al finalizarlo.</li>
          </ul>
        </div>
        <div class="service-price">
          <strong>desde $40.000</strong>
          <span>COP / mes · IVA incluido</span>
          <a
            class="button primary"
            href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
            target="_blank"
            rel="noopener"
          >
            Demo gratis <span>↗</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <PlansGrid id="planes" heading={true} />

  <section class="section clients-section">
    <div class="wrap">
      <p class="eyebrow">SITIOS PUBLICADOS CON PRESENTTO</p>
      <h2>Negocios y proyectos <em>ya publicados.</em></h2>
      <p class="clients-intro">
        Sitios reales, construidos y publicados en <strong>*.presentto.online</strong>. Cada uno con su
        identidad, su rubro y sus clientes. Tócalos y compáralos con lo que hoy tienes tú.
      </p>
      <div class="client-grid">
        {clientSites.map((site, i) => (
          <a class="client-card" href={site.url} target="_blank" rel="noopener noreferrer">
            <span class="client-index">{String(i + 1).padStart(2, '0')} · CLIENTE</span>
            <strong>{site.name}</strong>
            <code>{site.host}</code>
            <span class="client-go">Visitar sitio <span>↗</span></span>
          </a>
        ))}
      </div>
      <div class="guide-cta guide-cta-tight">
        <a class="button ghost" href="/sitios/">Ver todos los sitios publicados <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="section wrap faq-section-page">
    <p class="eyebrow">DUDAS FRECUENTES DEL SERVICIO</p>
    <h2>Lo esencial, <em>sin letra pequeña.</em></h2>
    <FaqList faqs={faqs} />
    <div class="guide-cta">
      <a
        class="button primary"
        href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
        target="_blank"
        rel="noopener"
      >
        Pedir mi demo gratis <span>↗</span>
      </a>
      &nbsp;
      <a class="button ghost" href="/preguntas/">Ver todas las preguntas <span>↗</span></a>
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">EMPIEZA SIN RIESGO</p>
      <h2>Ve tu web gratis. <em>Decide después.</em></h2>
      <div class="actions">
        <a
          class="button light"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
          target="_blank"
          rel="noopener"
        >
          Pedir mi demo gratis <span>↗</span>
        </a>
        <a class="button ghost light-ghost" href="#planes">Ver planes <span>↓</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
