---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import PlansGrid from '../components/PlansGrid.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import ServicePillars from '../components/ServicePillars.astro';
import AiTeam from '../components/AiTeam.astro';
import OnboardingTimeline from '../components/OnboardingTimeline.astro';
import ClientGrid from '../components/ClientGrid.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { ctaDiagnostico } from '../data/business';

const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Servicios' }];

const title = 'Administración web y presencia digital con IA | Presentto';
const description =
  'Administramos tu web, tu ficha de Google, la analítica y tus sistemas. Construimos lo que falta y aplicamos IA. 4 planes desde $100.000 COP/mes.';

const faqs = [
  {
    q: '¿Qué incluye exactamente el servicio?',
    a: 'Cuatro frentes: administración web (hosting, dominio, SSL, correo, backups, uptime y cambios), implementación (web nueva si no existe, reservas, catálogos, portales), presencia digital (ficha de Google, SEO local, reseñas y contenido) e IA aplicada (inducción y automatizaciones). El plan que contrates define la profundidad de cada frente.',
  },
  {
    q: '¿Trabajan sobre mi web actual o la reemplazan?',
    a: 'Primero auditamos. Si tu web funciona, la administramos y la mejoramos sin tirar lo que ya tienes. Si no existe o no se sostiene, construimos una base nueva y migramos el contenido con redirecciones para no perder lo indexado.',
  },
  {
    q: '¿La IA reemplaza a las personas?',
    a: 'No. La usamos para diagnosticar, redactar borradores, clasificar solicitudes y automatizar tareas repetitivas. Cada entrega pasa por revisión humana. Además te damos una inducción para que tu equipo la use con criterio y sin exponer datos.',
  },
  {
    q: '¿Cuánto cuesta y cómo se paga?',
    a: 'Cuatro planes: Presencia $100.000/mes, Crecimiento $299.000/mes, Sistemas $640.000/mes y Empresa desde $1.450.000/mes. También hay prepago anual con 15% de descuento. Precios en COP con IVA incluido, sin suscripción automática ni permanencia más allá del plazo pagado.',
  },
  {
    q: '¿En cuánto tiempo veo resultados?',
    a: 'El diagnóstico y el plan de 30 días se entregan en la primera semana. La implementación inicial (web, ficha, analítica) suele estar publicada entre los días 10 y 15. Los reportes son trimestrales en Presencia y mensuales desde Crecimiento. No prometemos posiciones ni ventas: prometemos ejecución y evidencia.',
  },
  {
    q: '¿Puedo empezar sin tener web?',
    a: 'Sí. El plan Presencia incluye una web nueva base de hasta cinco secciones con tu contenido real. Si luego necesitas reservas, catálogo o portal de clientes, subes a Sistemas sin cambiar de proveedor.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/servicios/"
  breadcrumbs={crumbs}
  plansOffers={true}
>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow="ADMINISTRACIÓN DE PRESENCIA DIGITAL"
    title="Tu presencia digital, <em>administrada de verdad.</em>"
    lead="La agencia todo en 1 para crecer digitalmente: web, ficha de Google, analítica, sistemas y flujos de IA. Construimos lo que falta, operamos lo que ya existe y respondemos con un SLA claro. Desde $100.000 COP/mes."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
        Diagnóstico gratis <span>↗</span>
      </a>
      <a class="btn btn-ghost" href="#planes">Ver los 4 planes <span>↓</span></a>
    </Fragment>
    <Fragment slot="meta">
      <span class="tag">Web existente o nueva</span>
      <span class="tag">Ficha de Google y analítica</span>
      <span class="tag">Sistemas y automatizaciones</span>
      <span class="tag">Inducción IA incluida</span>
    </Fragment>
  </PageHero>

  <ServicePillars />

  <AiTeam />

  <OnboardingTimeline />

  <PlansGrid id="planes" heading={true} />

  <TrustStrip />

  <ClientGrid limit={9} />

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">DUDAS FRECUENTES DEL SERVICIO</p>
        <h2 data-split>Lo esencial, <em>sin letra pequeña.</em></h2>
      </div>
      <p class="lead">
        Alcance, precios, IA y tiempos. Para el resto está el diagnóstico gratuito y el hub de
        preguntas.
      </p>
    </div>
    <FaqList faqs={faqs} />
    <p class="stack-note">
      ¿Otra duda? Ver <a href="/preguntas/">todas las preguntas frecuentes</a> o
      <a href="/contacto/">escríbenos</a>.
    </p>
  </section>

  <FinalCta
    eyebrow="EMPIEZA CON DIAGNÓSTICO GRATIS"
    title="Revisamos tu presencia. <em>Te decimos qué falta.</em>"
    note="20 minutos por Google Meet o WhatsApp · Sin compromiso · Plan y presupuesto claros antes de pagar"
  />
</BaseLayout>
