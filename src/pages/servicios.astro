---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import PlansGrid from '../components/PlansGrid.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import { ctaSession } from '../data/business';

const crumbs = [{ label: 'Inicio', href: '/' }, { label: 'Servicios' }];

const title = 'Servicios de web administrada | Presentto';
const description =
  'Web administrada desde $15.000 COP/mes (MVO) o con dominio propio desde $40.000. Diseño a gusto, 3 sesiones por Google Meet y administración incluida.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Presenttación Digital',
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: [
    { '@type': 'Place', name: 'Funza' },
    { '@type': 'Place', name: 'Mosquera' },
    { '@type': 'Place', name: 'Madrid' },
    { '@type': 'Place', name: 'Facatativá' },
  ],
  serviceType: 'Diseño y administración de páginas web',
  offers: [
    { '@type': 'Offer', name: 'MVO Mensual', price: '15000', priceCurrency: 'COP', url: 'https://mpago.li/1iJFAwE' },
    { '@type': 'Offer', name: 'MVO Anual', price: '120000', priceCurrency: 'COP', url: 'https://mpago.li/113CYVC' },
    { '@type': 'Offer', name: '1 mes', price: '40000', priceCurrency: 'COP', url: 'https://mpago.li/2j4gTPj' },
    { '@type': 'Offer', name: '3 meses', price: '100000', priceCurrency: 'COP', url: 'https://mpago.li/17JYVwX' },
    { '@type': 'Offer', name: '6 meses', price: '190000', priceCurrency: 'COP', url: 'https://mpago.li/1j4eF1j' },
    { '@type': 'Offer', name: '1 año', price: '350000', priceCurrency: 'COP', url: 'https://mpago.li/344eu17' },
  ],
};

const clientSites = [
  { name: 'Botane', host: 'botane.presentto.online', url: 'https://botane.presentto.online/' },
  { name: 'KSPR', host: 'kspr.presentto.online', url: 'https://kspr.presentto.online/' },
  { name: 'Esturel', host: 'esturel.presentto.online', url: 'https://esturel.presentto.online/' },
  { name: 'LYL', host: 'lyl.presentto.online', url: 'https://lyl.presentto.online/' },
  { name: 'Viking Dogs', host: 'vikingdogs.presentto.online', url: 'https://vikingdogs.presentto.online/' },
  { name: 'YA', host: 'ya.presentto.online', url: 'https://ya.presentto.online/' },
  { name: 'Knifopics', host: 'knifopics.presentto.online', url: 'https://knifopics.presentto.online/' },
  { name: 'Aeperion', host: 'aeperion.presentto.online', url: 'https://aeperion.presentto.online/' },
  { name: 'USPKH', host: 'uspkh.presentto.online', url: 'https://uspkh.presentto.online/' },
];

const clientsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sitios publicados con Presenttación Digital',
  url: 'https://www.presentto.online/servicios/',
  itemListElement: clientSites.map((site, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: site.name,
    url: site.url,
  })),
};

const faqs = [
  {
    q: '¿Qué incluye la Presenttación Digital?',
    a: 'Todo lo esencial para existir en internet y verte profesional: web con tu contenido, diseño a gusto, 3 sesiones por Google Meet, dominio propio y correo profesional en los planes tradicionales (o subdominio en MVO), códigos QR, ajustes durante el plan y administración por Presentto.',
  },
  {
    q: '¿Cuánto cuesta y cómo se paga?',
    a: 'MVO: mensual $15.000 · anual $120.000 COP. Dominio propio: 1 mes $40.000 · 3 meses $100.000 · 6 meses $190.000 · 1 año $350.000 COP, todos con IVA incluido. Es prepago por plazo vía Mercado Pago, sin suscripción automática. Agendas tu sesión 1 antes de pagar.',
  },
  {
    q: '¿Qué incluye el dominio y correo profesional?',
    a: 'Los planes con dominio propio incluyen tu dominio tuempresa.online y 1 correo profesional @tuempresa.online. Si ya tienes un dominio, puedes aportarlo sin costo adicional. El MVO opera en subdominio cliente.presentto.online para mantener el costo bajo.',
  },
  {
    q: '¿Cómo preparan mi web para que me encuentren en Google?',
    a: 'Cuidamos lo técnico sin que tú tengas que entenderlo: meta títulos y descripciones, encabezados claros, estructura con enlaces internos, sitemap, velocidad, datos estructurados y orientación para tu ficha de Google. Así un cliente puede encontrarte en Funza, Mosquera, Madrid, Facatativá o donde trabajes.',
  },
  {
    q: '¿Quiénes ya tienen un sitio con Presentto?',
    a: 'Negocios y proyectos como Botane, KSPR, Esturel, LYL, Viking Dogs, YA, Knifopics, Aeperion y USPKH ya publicaron sus sitios en *.presentto.online. Puedes visitarlos en esta página o en la lista de sitios publicados.',
  },
  {
    q: '¿Puedo ver una demo antes de pagar?',
    a: 'Sí, y es lo recomendado. Agenda tu Sesión 1 por WhatsApp: construimos la web con la información de tu negocio, la ves, pides cambios y solo pagas cuando decides contratar el plan que prefieras.',
  },
];
---

<BaseLayout title={title} description={description} path="/servicios/" breadcrumbs={crumbs} plansOffers={true} jsonld={[serviceSchema, clientsSchema]}>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow="SERVICIOS PRESENTTO"
    title="Tu web profesional, <em>sin agencia tradicional.</em>"
    lead="Presenttación Digital: web administrada con diseño a tu gusto, presencia clara en Google y acompañamiento por Google Meet. Elige MVO en subdominio desde $15.000/mes o tu dominio propio desde $40.000. Entrega en pocos días hábiles; ves tu web antes de pagar."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={ctaSession} target="_blank" rel="noopener" data-magnetic>
        Agendar mi sesión 1 <span>↗</span>
      </a>
      <a class="btn btn-ghost" href="#planes">Ver planes <span>↓</span></a>
    </Fragment>
    <Fragment slot="meta">
      <span class="tag">Diseño a gusto</span>
      <span class="tag">3 sesiones Meet</span>
      <span class="tag">Dominio y correo opcionales</span>
      <span class="tag">Administración incluida</span>
    </Fragment>
  </PageHero>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">SERVICIO PRINCIPAL</p>
        <h2 data-split>Presenttación <em>Digital</em></h2>
      </div>
      <p class="lead">
        Una sola oferta, dos modalidades de infraestructura. Nosotros construimos, publicamos y
        administramos; tú apruebas en cada sesión. Sin plugins, sin hosting que administrar y sin
        pelear con herramientas.
      </p>
    </div>
    <div class="infra-box service-panel reveal">
      <div>
        <h3 class="infra-title">Web lista para vender, construida con estructura real</h3>
        <p class="infra-copy">
          Desde el día uno: meta títulos, meta descripciones, encabezados jerárquicos, enlaces
          internos, imágenes comprimidas y datos estructurados. Ajustes de contenido y diseño
          coordinados en las sesiones, más soporte por WhatsApp en horario hábil.
        </p>
        <ul class="feature-list">
          <li>Creación personalizada con tus imágenes, tu estilo y tu contenido real.</li>
          <li>Diseño adaptado a tu rubro: landing o multipágina según lo que vendas.</li>
          <li>3 sesiones por Google Meet: información, muestra con correcciones y entrega.</li>
          <li>Metas, H1–H3, enlaces internos y URLs limpias.</li>
          <li>Estructura lista para búsquedas de tu zona y “cerca de mí”.</li>
          <li>Orientación de tu ficha de Google: categorías y datos coherentes.</li>
          <li>Velocidad y Core Web Vitals: que tu cliente cargue rápido.</li>
          <li>Sitemap XML, robots.txt e indexación listos al publicar.</li>
          <li>Códigos QR para llevar tráfico del punto de venta a tu web.</li>
          <li>Sin permanencia: eliges el plan y decides si renuevas al finalizarlo.</li>
        </ul>
      </div>
      <aside class="service-price">
        <p class="eyebrow">MVO · SUBDOMINIO</p>
        <strong>desde $15.000</strong>
        <span>COP / mes · IVA incluido</span>
        <p class="infra-copy">
          Con dominio propio y correo profesional desde <strong>$40.000/mes</strong> de prepago.
        </p>
        <a class="btn btn-primary" href={ctaSession} target="_blank" rel="noopener" data-magnetic>
          Agendar mi sesión 1 <span>↗</span>
        </a>
        <a class="btn btn-ghost btn-sm" href="#planes">Comparar planes <span>↓</span></a>
      </aside>
    </div>
  </section>

  <PlansGrid id="planes" heading={true} />

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">SITIOS PUBLICADOS CON PRESENTTO</p>
        <h2 data-split>Negocios y proyectos <em>ya publicados.</em></h2>
      </div>
      <p class="lead">
        Sitios reales, construidos y publicados en <strong>*.presentto.online</strong>. Cada uno con
        su identidad, su rubro y sus clientes. Ábrelos y compáralos con lo que hoy tienes tú.
      </p>
    </div>
    <div class="client-grid" data-stagger>
      {clientSites.map((site, i) => (
        <a class="client-card reveal" href={site.url} target="_blank" rel="noopener noreferrer">
          <span class="client-index">{String(i + 1).padStart(2, '0')} · CLIENTE</span>
          <strong>{site.name}</strong>
          <code>{site.host}</code>
          <span class="client-go">Visitar sitio <span>↗</span></span>
        </a>
      ))}
    </div>
    <p class="stack-note">
      <a href="/sitios/">Ver todos los sitios publicados <span aria-hidden="true">↗</span></a>
      · también en <a href="/portfolio/">portafolio</a>.
    </p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">DUDAS FRECUENTES DEL SERVICIO</p>
        <h2 data-split>Lo esencial, <em>sin letra pequeña.</em></h2>
      </div>
      <p class="lead">
        Alcance, precios, dominio e indexación. Para el resto está la sesión 1 y el hub de
        preguntas.
      </p>
    </div>
    <FaqList faqs={faqs} />
    <p class="stack-note">
      ¿Otra duda? Ver <a href="/preguntas/">todas las preguntas frecuentes</a> o
      <a href="/contacto/">escríbenos</a>.
    </p>
  </section>

  <FinalCta
    eyebrow="EMPIEZA SIN RIESGO"
    title="Ve tu web antes de pagar. <em>Decide después.</em>"
    note="Sesión 1 de 30 min por Google Meet · Te enviamos el enlace de pago recién cuando decides"
  />
</BaseLayout>
