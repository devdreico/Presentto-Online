---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlansGrid from '../components/PlansGrid.astro';
import FaqList from '../components/FaqList.astro';
import MvoEconomics from '../components/MvoEconomics.astro';
import SessionTimeline from '../components/SessionTimeline.astro';
import MvoConstellation from '../components/three/MvoConstellation.astro';
import { usd } from '../data/business';

const title = 'Página web por mensualidad desde $15.000 | Presentto';
const description =
  'MVO con subdominio desde $15.000 COP/mes, o web administrada con dominio propio desde $40.000. Agenda tu 1ª sesión por WhatsApp y ve tu web antes de pagar.';

const faqs = [
  {
    q: '¿Qué es el plan MVO de Presentto Online?',
    a: 'Es el modelo de infraestructura compartida en subdominio (cliente.presentto.online) con el que puedes tener tu sitio web administrado, con diseño a gusto y 3 sesiones de asesoría por Google Meet, desde $15.000 COP al mes.',
  },
  {
    q: '¿Por qué se usa un subdominio y no un dominio propio en el MVO?',
    a: 'Porque un dominio propio individual encarecería el servicio. El subdominio compartido (cliente.presentto.online) permite que mantengamos una infraestructura única y de alta calidad a un costo extremadamente bajo para tu negocio.',
  },
  {
    q: '¿Cómo funcionan las tres sesiones por Google Meet?',
    a: '1ª Sesión (30 min): solicitud de información y lectura previa del contrato. 2ª Sesión: muestra preliminar y correcciones de tu mano. 3ª Sesión: cierre final, entrega, firmado de contrato y pago.',
  },
  {
    q: '¿Qué diferencia hay entre el MVO y los planes con dominio propio?',
    a: 'El MVO opera en subdominio y cuesta desde $15.000/mes con acompañamiento por sesiones. Los planes tradicionales (desde $40.000/mes) incluyen tu propio dominio (ej. .online o .com) y correo profesional.',
  },
  {
    q: '¿Puedo solicitar una demo o asesoría gratis?',
    a: 'Sí. Puedes escribirnos por WhatsApp para agendar tu primera sesión de coordinación sin compromiso.',
  },
  {
    q: '¿Trabajan con negocios de Funza, Mosquera, Madrid y Facatativá?',
    a: 'Sí. Atendemos negocios de Sabana Occidental y toda Colombia con adaptación local a tu zona y clientes.',
  },
];

const homeService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'MVO — Presencia Digital Administrada',
  description:
    'Sitio web administrado en subdominio con 3 sesiones de asesoría por Google Meet desde $15.000 COP/mes.',
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: [
    { '@type': 'Place', name: 'Colombia' },
    { '@type': 'Place', name: 'Funza' },
    { '@type': 'Place', name: 'Mosquera' },
    { '@type': 'Place', name: 'Madrid' },
    { '@type': 'Place', name: 'Facatativá' },
  ],
  offers: [
    {
      '@type': 'Offer',
      name: 'MVO Mensual',
      price: '15000',
      priceCurrency: 'COP',
      description: 'MVO — Subdominio cliente.presentto.online, 1 mes',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/1iJFAwE',
    },
    {
      '@type': 'Offer',
      name: 'MVO Anual',
      price: '120000',
      priceCurrency: 'COP',
      description: 'MVO — Subdominio cliente.presentto.online, 1 año',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/113CYVC',
    },
    {
      '@type': 'Offer',
      name: '1 mes (Dominio propio)',
      price: '40000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital con dominio propio — 1 mes',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/2j4gTPj',
    },
    {
      '@type': 'Offer',
      name: '1 año (Dominio propio)',
      price: '350000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital con dominio propio — 1 año',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/344eu17',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  plansOffers={true}
  jsonld={[homeService]}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <img
        class="hero-logo"
        src="/assets/img/Presentto-Nombre-Fondo-Transparente.png"
        alt="Presentto Online"
        width="340"
        height="116"
        fetchpriority="high"
        decoding="async"
      />
      <p class="eyebrow">MVO · EL NUEVO COSTO REAL DE MOSTRAR TUS SERVICIOS ONLINE</p>
      <h1>Tu negocio, <em>en internet sin complicaciones.</em></h1>
      <p class="lead">
        El nuevo plan MVO te ofrece presencia web administrada en subdominio y 3 sesiones de asesoría por Google Meet.
        Desde <strong>$15.000 COP/mes</strong> o <strong>$120.000 anuales</strong>.
      </p>
      <div class="hero-price">
        <strong>desde $15.000</strong>
        <span>COP / mes<br />IVA incluido<br />≈ {usd(15000)} (ref.)</span>
      </div>
      <div class="actions">
        <a
          class="button primary"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20agendar%20mi%201%C2%AA%20sesi%C3%B3n%20para%20el%20plan%20MVO"
          target="_blank"
          rel="noopener"
        >
          Agendar mi sesión 1 <span>↗</span>
        </a>
        <a class="button ghost" href="#planes">Ver planes <span>↓</span></a>
      </div>
      <p class="hero-demo">
        <a href="#planes">
          Plan MVO mensual ($15k) y anual ($120k) · Planes con dominio propio desde $40k ↓
        </a>
      </p>
    </div>
    <div class="hero-visual">
      <MvoConstellation />
    </div>
  </section>

  <section class="proof">
    <div class="wrap proof-grid">
      <div><strong>MVO</strong><span>desde $15.000/mes</span></div>
      <div><strong>3 Sesiones</strong><span>Google Meet</span></div>
      <div><strong>Subdominio</strong><span>cliente.presentto.online</span></div>
    </div>
  </section>

  <MvoEconomics />

  <SessionTimeline />

  <PlansGrid id="planes" heading={true} />

  <section class="section wrap" id="como-funciona">
    <p class="eyebrow">UN SERVICIO REAL · TRES SESIONES</p>
    <div class="section-heading">
      <h2>Tu web y tu presencia digital: <em>un solo plan, todo incluido.</em></h2>
      <p>
        Diseño, textos a tu medida y todo lo técnico resuelto para que cualquier cliente te encuentre,
        te escriba y confíe en tu negocio, con acompañamiento guiado en Google Meet.
      </p>
    </div>
    <div class="feature-grid feature-grid-four">
      <article>
        <b>01</b>
        <h3>Diseño a gusto</h3>
        <p>
          Landing o multipágina adaptada a tu identidad, con tus fotos, servicios y canales de contacto listos.
        </p>
      </article>
      <article>
        <b>02</b>
        <h3>Subdominio compartido</h3>
        <p>
          Infraestructura optimizada en <strong>cliente.presentto.online</strong> para mantener un costo extremadamente bajo.
        </p>
      </article>
      <article>
        <b>03</b>
        <h3>Asesoría por Google Meet</h3>
        <p>
          3 sesiones guiadas: solicitud de info, muestra preliminar con tus correcciones, y entrega final con firma y pago.
        </p>
      </article>
      <article>
        <b>04</b>
        <h3>Administración continua</h3>
        <p>
          Mantenimiento técnico, optimización de velocidad y soporte activo durante todo tu plan MVO.
        </p>
      </article>
    </div>
  </section>

  <section class="section industries-section">
    <div class="wrap">
      <p class="eyebrow">UNA WEB PARA CADA NEGOCIO</p>
      <h2 class="center">Una web <em>a la medida de tu rubro.</em></h2>
      <div class="industry-grid">
        <span>Restaurantes y cafés</span>
        <span>Tiendas y comercios</span>
        <span>Clínicas y consultorios</span>
        <span>Talleres y servicios</span>
        <span>Peluquerías y estética</span>
        <span>Profesionales independientes</span>
        <span>Emprendimientos</span>
        <span>Portafolios profesionales</span>
      </div>
    </div>
  </section>

  <section class="section wrap" id="preguntas">
    <p class="eyebrow">PREGUNTAS FRECUENTES MVO</p>
    <div class="section-heading">
      <h2>Dudas sobre <em>el plan MVO y tu web</em></h2>
      <p>
        Lo que más nos preguntan sobre el subdominio, las sesiones y los precios. Más respuestas en
        <a href="/preguntas/">preguntas frecuentes</a>.
      </p>
    </div>
    <FaqList faqs={faqs} />
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">EMPIEZA CON EL MVO</p>
      <h2>El nuevo costo real de mostrar tus servicios online.</h2>
      <div class="actions">
        <a
          class="button light"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20agendar%20mi%201%C2%AA%20sesi%C3%B3n%20para%20el%20plan%20MVO"
          target="_blank"
          rel="noopener"
        >
          Agendar mi sesión 1 <span>↗</span>
        </a>
        <a class="button ghost light-ghost" href="#planes">Ver planes MVO <span>↓</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
