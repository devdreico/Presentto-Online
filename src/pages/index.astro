---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlansGrid from '../components/PlansGrid.astro';
import FaqList from '../components/FaqList.astro';
import { localBusinessSchema } from '../components/schemas';
import { usd } from '../data/business';

const title = 'SEO local y posicionamiento en Google | Presentto';
const description =
  'Web con SEO local y posicionamiento en Google desde $40.000 COP/mes en Funza, Mosquera, Madrid y Facatativá. Dominio, correo y ficha de Google. Demo gratis.';
const faqs = [
  {
    q: '¿Qué es el SEO local y cómo ayuda a mi negocio a aparecer en Google?',
    a: 'El SEO local optimiza tu web, tu ficha de Google Business Profile y tus datos estructurados para aparecer en búsquedas con geolocalización ("cerca de mí", "en Funza") y en el pack de Maps. En Presentto lo incluimos en la web desde el primer día: metas, schema LocalBusiness, contenido por municipio y arquitectura de enlaces internos. Te lo explicamos paso a paso en la guía de SEO local.',
  },
  {
    q: '¿Cuánto cuesta el posicionamiento en Google con Presentto?',
    a: 'La Presenttación Digital arranca en $40.000 COP (IVA incluido) por plan prepago de 1 mes, con equivalente aproximado de US$10 al mes de ese plazo. El precio incluye diseño, dominio propio, correo profesional, SEO on-page, SEO local y administración. No hay mensualidad recurrente ni permanencia: pagas por el plazo que elijas.',
  },
  {
    q: '¿En cuánto tiempo se ven resultados de SEO local?',
    a: 'La indexación suele ocurrir en días o semanas tras publicar, con sitemap y Search Console. El posicionamiento orgánico en búsquedas locales competitivas toma meses de autoridad, contenido y reseñas coherentes: promedios publicados por especialistas apuntan a 3-6 meses según competencia y punto de partida. Tú decides cuándo arrancar.',
  },
  {
    q: '¿Posicionan mi negocio en Funza, Mosquera, Madrid y Facatativá?',
    a: 'Sí. Trabajamos la Sabana Occidental (Funza, Mosquera, Madrid, Facatativá) con contenido específico por municipio y municipios vecinos de Cundinamarca. Si tu negocio atiende también a Bogotá o a clientes de otros países, diseñamos la arquitectura de contenidos para esas búsquedas sin duplicar páginas.',
  },
  {
    q: '¿Qué diferencia hay entre SEO local y anuncios de Google?',
    a: 'Los anuncios de Google son pago por clic: aparecen primero mientras pagas y se detienen al cortar el presupuesto. El SEO local es orgánico: se construye con contenido, técnica y reseñas y sigue generando visitas sin costo por clic, aunque tarda más en crecer. Lo habitual es empezar por SEO y usar anuncios solo para lanzamientos puntuales.',
  },
  {
    q: '¿La demo web es gratis y sin compromiso?',
    a: 'Sí: construimos una demo con la identidad real de tu negocio y la ves completa antes de pagar. Sin abono, sin formulario eterno y sin permanencia. Si no te convence, no pasa nada; si te gusta, eliges plan en Mercado Pago y publicamos en pocos días hábiles.',
  },
];

const homeService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Presenttación Digital',
  description:
    'Sitio web profesional con SEO on-page, posicionamiento local, dominio propio, correo y administración para negocios de la Sabana Occidental.',
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: [
    { '@type': 'Place', name: 'Funza' },
    { '@type': 'Place', name: 'Mosquera' },
    { '@type': 'Place', name: 'Madrid' },
    { '@type': 'Place', name: 'Facatativá' },
    { '@type': 'Place', name: 'Sabana Occidental, Colombia' },
  ],
  offers: [
    {
      '@type': 'Offer',
      name: '1 mes',
      price: '40000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 1 mes, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/2j4gTPj',
    },
    {
      '@type': 'Offer',
      name: '3 meses',
      price: '100000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 3 meses, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/17JYVwX',
    },
    {
      '@type': 'Offer',
      name: '6 meses',
      price: '190000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 6 meses, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/1j4eF1j',
    },
    {
      '@type': 'Offer',
      name: '1 año',
      price: '350000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 1 año, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/344eu17',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  plansOffers={true}
  faqs={faqs}
  jsonld={[localBusinessSchema, homeService]}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <img
        class="hero-logo"
        src="/assets/img/Presentto-Nombre-Fondo-Transparente.webp"
        alt="Presentto Online"
        width="340"
        height="116"
        fetchpriority="high"
        decoding="async"
      />
      <p class="eyebrow">SEO LOCAL · POSICIONAMIENTO EN GOOGLE</p>
      <h1>Tu negocio, <em>posicionado en Google y en la Sabana Occidental.</em></h1>
      <p class="lead">
        Presentamos tu negocio online con una web optimizada para SEO on-page, SEO técnico y búsquedas
        locales: dominio, correo y ficha de Google Business Profile incluidos. Primero la ves gratis; pagas
        solo si te convence.
      </p>
      <div class="hero-price">
        <strong>desde $40.000</strong>
        <span>COP / mes<br />IVA incluido<br />≈ {usd(40000)} (ref.)</span>
      </div>
      <div class="actions">
        <a
          class="button primary"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
          target="_blank"
          rel="noopener"
        >
          Pedir mi demo gratis <span>↗</span>
        </a>
        <a class="button ghost" href="#planes">Ver planes <span>↓</span></a>
      </div>
      <p class="hero-demo">
        <a href="#planes">
          ¿Listo para comprar? Planes desde $40.000 COP · pago seguro con Mercado Pago ↓
        </a>
      </p>
    </div>
    <div class="hero-visual">
      <div class="visual-window">
        <div class="window-bar">
          <i></i><i></i><i></i><span>tuempresa.online</span>
        </div>
        <div class="window-content">
          <span class="visual-tag">TU NEGOCIO</span>
          <strong>Una web clara<br />que trabaja<br /><em>por ti.</em></strong>
          <div class="visual-qr">
            <svg viewBox="0 0 31 31" aria-hidden="true" shape-rendering="crispEdges"><path stroke="currentColor" stroke-width=".7" fill="none" d="M1 1.5h7m2 0h2m1 0h1m2 0h6m1 0h7M1 2.5h1m5 0h1m4 0h1m5 0h1m4 0h1m5 0h1M1 3.5h1m1 0h3m1 0h1m1 0h3m1 0h1m1 0h1m1 0h1m2 0h2m1 0h1m1 0h3m1 0h1M1 4.5h1m1 0h3m1 0h1m1 0h3m5 0h2m1 0h1m2 0h1m1 0h3m1 0h1M1 5.5h1m1 0h3m1 0h1m1 0h1m3 0h4m1 0h3m2 0h1m1 0h3m1 0h1M1 6.5h1m5 0h1m1 0h1m2 0h7m2 0h1m1 0h1m5 0h1M1 7.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M9 8.5h3m1 0h2m1 0h1m2 0h3M1 9.5h1m1 0h5m4 0h2m1 0h2m1 0h1m1 0h1m2 0h5M1 10.5h1m2 0h3m3 0h3m3 0h6m1 0h3m3 0h1M1 11.5h2m2 0h3m1 0h2m1 0h1m9 0h1M1 12.5h1m1 0h2m1 0h1m2 0h1m1 0h3m1 0h1m1 0h1m1 0h1m1 0h2m1 0h1m1 0h1m1 0h1M1 13.5h1m1 0h1m1 0h1m1 0h3m7 0h2m2 0h1m4 0h2M2 14.5h3m4 0h2m1 0h1m1 0h3m1 0h4m1 0h1m1 0h1m3 0h1M1 15.5h4m2 0h1m3 0h7m1 0h1m2 0h1m1 0h1m1 0h2M1 16.5h1m1 0h2m1 0h1m1 0h1m1 0h1m2 0h2m1 0h1m4 0h5m2 0h1M4 17.5h1m1 0h3m1 0h1m1 0h1m2 0h2m1 0h1m2 0h1m2 0h1m1 0h2M1 18.5h3m1 0h1m2 0h1m1 0h1m1 0h1m3 0h10m1 0h1m1 0h1M1 19.5h1m1 0h3m1 0h2m1 0h3m5 0h1m5 0h1m2 0h1M1 20.5h1m2 0h1m1 0h1m1 0h1m4 0h1m1 0h1m1 0h1m1 0h3m2 0h2m2 0h1M1 21.5h1m1 0h1m1 0h1m1 0h2m3 0h2m3 0h2m1 0h6m1 0h3M9 22.5h1m1 0h2m1 0h3m2 0h1m1 0h1m3 0h5M1 23.5h7m3 0h1m1 0h5m2 0h2m1 0h1m1 0h3M1 24.5h1m5 0h1m1 0h1m1 0h2m1 0h1m1 0h1m3 0h2m3 0h1M1 25.5h1m1 0h3m1 0h1m1 0h1m2 0h1m2 0h2m1 0h2m1 0h5m1 0h1m1 0h1M1 26.5h1m1 0h3m1 0h1m1 0h2m1 0h3m1 0h5m3 0h1m1 0h2M1 27.5h1m1 0h3m1 0h1m1 0h2m1 0h1m1 0h1m3 0h1m1 0h1m2 0h6M1 28.5h1m5 0h1m2 0h1m1 0h3m2 0h1m3 0h2m1 0h1m1 0h1m1 0h1M1 29.5h7m1 0h4m2 0h1m3 0h2m2 0h5"/></svg>
            <small>presentto<br />.online</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="wrap proof-grid">
      <div><strong>Demo</strong><span>gratis, sin abono</span></div>
      <div><strong>SEO</strong><span>local + posicionamiento</span></div>
      <div><strong>desde $40.000</strong><span>COP/mes · IVA incl.</span></div>
    </div>
  </section>

  <PlansGrid id="planes" heading={true} />

  <section class="section wrap" id="como-funciona">
    <p class="eyebrow">POSICIONAMIENTO WEB · TODO INCLUIDO</p>
    <div class="section-heading">
      <h2>SEO local y posicionamiento web: <em>un solo plan, todo incluido.</em></h2>
      <p>
        Diseño, SEO on-page, SEO técnico, datos estructurados y contenido geolocalizado para que tu negocio
        aparezca en búsquedas locales de Funza, Mosquera, Madrid, Facatativá y en el pack local de Google Maps.
      </p>
    </div>
    <div class="feature-grid feature-grid-four">
      <article>
        <b>01</b>
        <h3>Nosotros lo hacemos todo</h3>
        <p>
          Tú apruebas; nosotros <a href="/servicios/">diseñamos, publicamos y optimizamos tu web</a> con
          tus fotos, textos y servicios reales.
        </p>
      </article>
      <article>
        <b>02</b>
        <h3>Dominio y correo profesionales</h3>
        <p>
          Dominio propio <strong>tuempresa.online</strong> (autoridad de dominio propia, sin subdominios
          gratis) y correo <strong>@tuempresa.online</strong> incluidos.
        </p>
      </article>
      <article>
        <b>03</b>
        <h3>SEO local y pack de Maps</h3>
        <p>
          SEO on-page, meta títulos, schema LocalBusiness y contenido por municipio para posicionar en
          <a href="/funza/">Funza</a>, <a href="/mosquera/">Mosquera</a>, <a href="/madrid/">Madrid</a>,
          <a href="/facatativa/">Facatativá</a> y búsquedas “cerca de mí”.
        </p>
      </article>
      <article>
        <b>04</b>
        <h3>Contenido indexable y conversión</h3>
        <p>
          Arquitectura de <a href="/guias/">enlaces internos y contenidos indexables</a>, encabezados H1–H3,
          imágenes optimizadas y CTAs claros para convertir tráfico orgánico en clientes por WhatsApp.
        </p>
      </article>
    </div>
    <div class="actions plan-cta">
      <a
        class="button primary"
        href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
        target="_blank"
        rel="noopener"
      >
        Pedir mi demo gratis <span>↗</span>
      </a>
      <a class="button ghost" href="#planes">Ver planes <span>↓</span></a>
    </div>
  </section>

  <section class="section industries-section">
    <div class="wrap">
      <p class="eyebrow">UNA WEB PARA CADA NEGOCIO</p>
      <h2 class="center">Una web con SEO <em>a la medida de tu rubro.</em></h2>
      <div class="industry-grid">
        <span>Restaurantes y cafés</span>
        <span>Tiendas y comercios</span>
        <span>Clínicas y consultorios</span>
        <span>Talleres y servicios</span>
        <span>Peluquerías y estética</span>
        <span>Profesionales independientes</span>
        <span>Emprendimientos</span>
        <span>Portafolios profesionales</span>
      </div>
      <p class="stack-note">
        Cada rubro tiene búsquedas distintas: revisa cómo se traduce eso en
        <a href="/portfolio/">proyectos publicados</a> y en las
        <a href="/comparativas/">comparativas de opciones de web y SEO</a>.
      </p>
    </div>
  </section>

  <section class="section trust-section">
    <div class="wrap">
      <p class="eyebrow center">CÓMO FUNCIONA</p>
      <div class="section-heading">
        <h2>Tres pasos. <em>Cero riesgo.</em></h2>
        <p>Ves la web de tu negocio antes de comprometer un peso. Así de simple.</p>
      </div>
      <div class="trust-grid">
        <article class="trust-card">
          <span class="trust-icon">01</span>
          <h3>Cuéntanos de tu negocio</h3>
          <p>
            Nos escribes por WhatsApp: qué haces, tus fotos y a qué clientes quieres llegar. Sin formularios
            eternos ni reuniones obligatorias.
          </p>
          <small>Sin abono · Sin compromiso</small>
        </article>
        <article class="trust-card">
          <span class="trust-icon">02</span>
          <h3>Te mostramos tu demo</h3>
          <p>
            Construimos una demo web con la identidad de tu negocio. La ves, pides cambios y decides con calma
            si te convence.
          </p>
          <small>Demo gratis · Tú apruebas</small>
        </article>
        <article class="trust-card">
          <span class="trust-icon">03</span>
          <h3>Publicamos y la mantenemos</h3>
          <p>
            Pagas el plan que elijas en Mercado Pago y publicamos en pocos días. Ajustes y administración
            incluidos durante todo el plan.
          </p>
          <small>Entrega en días · Sin permanencia</small>
        </article>
      </div>
    </div>
  </section>

  <section class="section stack-section">
    <div class="wrap">
      <p class="eyebrow">SEO TÉCNICO · CORE WEB VITALS</p>
      <div class="section-heading">
        <h2>Indexable, veloz <em>y listo para posicionar.</em></h2>
        <p>
          Rastreo limpio, HTML semántico, sitemap XML, datos estructurados y Core Web Vitals (LCP, INP, CLS)
          optimizados: la base técnica que Google necesita para indexarte y mostrarte en resultados locales.
        </p>
      </div>
      <div class="stack-grid">
        <article class="stack-card">
          <img src="/assets/img/icons/html5.svg" alt="Icono HTML5" width="42" height="42" loading="lazy" />
          <strong>HTML5</strong><span>Semántica e indexación</span>
        </article>
        <article class="stack-card">
          <img src="/assets/img/icons/css3.svg" alt="Icono CSS3" width="42" height="42" loading="lazy" />
          <strong>CSS3</strong><span>Mobile-first responsive</span>
        </article>
        <article class="stack-card">
          <img src="/assets/img/icons/javascript.svg" alt="Icono JavaScript" width="42" height="42" loading="lazy" />
          <strong>JavaScript</strong><span>Interacción sin bloquear rastreo</span>
        </article>
        <article class="stack-card">
          <span class="stack-badge">SEO</span><strong>SEO on-page</strong><span>Metas, schema y enlaces internos</span>
        </article>
        <article class="stack-card">
          <span class="stack-badge">GBP</span><strong>Google Business</strong><span>Ficha, NAP y pack local</span>
        </article>
        <article class="stack-card">
          <span class="stack-badge">CWV</span><strong>Core Web Vitals</strong><span>LCP · INP · CLS</span>
        </article>
      </div>
      <p class="stack-note">
        Tecnologías y estándares de trabajo (guía oficial de
        <a
          href="https://developers.google.com/search/docs/fundamentals/seo-starter-guide"
          target="_blank"
          rel="noopener">SEO de Google</a
        >). No representa certificaciones oficiales de terceros.
      </p>
    </div>
  </section>

  <section class="section wrap" id="preguntas-seo">
    <p class="eyebrow">PREGUNTAS FRECUENTES · SEO LOCAL</p>
    <div class="section-heading">
      <h2>Dudas sobre <em>SEO local y posicionamiento en Google</em></h2>
      <p>
        Lo que más nos preguntan antes de pedir la demo. Más respuestas en
        <a href="/preguntas/">preguntas frecuentes</a> y en la
        <a href="/guias/seo-local/">guía completa de SEO local</a>.
      </p>
    </div>
    <FaqList faqs={faqs} />
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">EMPEZA SIN RIESGO</p>
      <h2>Primero ves tu web. <em>Pagas solo si te gusta.</em></h2>
      <div class="actions">
        <a
          class="button light"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
          target="_blank"
          rel="noopener"
        >
          Pedir mi demo gratis <span>↗</span>
        </a>
        <a class="button ghost light-ghost" href="#planes">Ver planes <span>↓</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
