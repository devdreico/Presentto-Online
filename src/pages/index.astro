---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlansGrid from '../components/PlansGrid.astro';
import FaqList from '../components/FaqList.astro';
import FinalCta from '../components/FinalCta.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServicePillars from '../components/ServicePillars.astro';
import AiTeam from '../components/AiTeam.astro';
import ClientGrid from '../components/ClientGrid.astro';
import ProofSection from '../components/ProofSection.astro';
import OnboardingTimeline from '../components/OnboardingTimeline.astro';
import { ctaDiagnostico } from '../data/business';
import { clients } from '../data/clients';

const title = 'Agencia todo en 1: web y presencia digital | Presentto';
const description =
  'La agencia todo en 1 para crecer digitalmente: administramos web, ficha de Google, analítica, sistemas e IA. 4 planes desde $100.000 COP/mes, IVA incluido.';

const faqs = [
  {
    q: '¿Qué hace exactamente Presentto por mi negocio?',
    a: 'Administramos tu presencia digital completa: web, hosting, dominio o subdominio, SSL, correo profesional, backups, ficha de Google, analítica, cambios de contenido y soporte. Si no tienes web, la construimos. Si ya tienes sistemas que faltan (reservas, catálogos, portales), los implementamos. Y si quieres usar IA sin exponer datos, te damos la inducción.',
  },
  {
    q: '¿Cuánto cuesta y qué incluye el plan más económico?',
    a: 'El plan Presencia cuesta $100.000 COP/mes con IVA incluido. Incluye web administrada, web nueva base si no tienes, dominio o subdominio, correo profesional, ficha de Google básica, analítica, dos cambios de contenido al mes, soporte con primera respuesta en 8 horas y la inducción IA. El setup inicial es de $250.000 único.',
  },
  {
    q: '¿Qué diferencia hay entre los cuatro planes?',
    a: 'Presencia sostiene la base. Crecimiento agrega SEO local mensual, gestión de reseñas, seis cambios al mes y primera respuesta en 4 horas. Sistemas suma desarrollo de sistemas web, tres flujos de automatización y respuesta en 2 horas. Empresa es multi-sede, con alcance y SLA contractuales. Puedes subir o bajar de plan sin penalización.',
  },
  {
    q: '¿La IA reemplaza a las personas?',
    a: 'No. Usamos IA para diagnosticar, redactar borradores, clasificar solicitudes y automatizar tareas repetitivas. Todo pasa por revisión humana y se limita a tareas verificables. Además te enseñamos a usarla con criterio, con límites claros sobre qué datos nunca se comparten.',
  },
  {
    q: '¿Cómo se paga y hay permanencia?',
    a: 'Pagas el mes o el año por adelantado, sin suscripción automática. El plan anual tiene 15% de descuento. No hay permanencia más allá del plazo pagado ni cargos sorpresa. Si decides no renovar, el servicio termina al final del periodo contratado.',
  },
  {
    q: '¿Puedo entrar a mi cuenta y ver mi plan?',
    a: 'Sí. En /cuenta/ inicias sesión con tu teléfono y un PIN de 6 dígitos, y te llevamos a tu dashboard personal en presentto.online/app/. Allí ves plan, fechas, entregables, métricas y solicitudes. Las credenciales se entregan al activar el servicio.',
  },
];

const marqueeItems = [
  'Restaurantes y cafés',
  'Tiendas y comercios',
  'Clínicas y consultorios',
  'Talleres mecánicos',
  'Peluquerías y estética',
  'Profesionales independientes',
  'Emprendimientos locales',
  'Portafolios creativos',
  'Bufetes y consultorías',
  'Gimnasios y entrenadores',
  'Inmobiliarias',
  'Servicios a domicilio',
];
---

<BaseLayout title={title} description={description} path="/" plansOffers={true} faqs={faqs}>
  <!-- 1. Hero ---------------------------------------------------------------- -->
  <section class="hero hero-home wrap" data-home-scroll>
    <div class="hero-motion" aria-hidden="true"></div>
    <canvas class="home-hero-rain" data-home-rain aria-hidden="true"></canvas>
    <div class="home-hero-brand" data-home-brand aria-hidden="true">
      <img
        src="/assets/img/Presentto-Icono-Fondo-Transparente.webp"
        alt=""
        width="46"
        height="54"
        decoding="async"
      />
      <span>Present<em>to</em></span>
    </div>
    <p class="home-hero-cue" data-home-cue aria-hidden="true">Explora <span>↓</span></p>
    <div class="hero-copy">
      <h1 class="hero-title home-hero-title">
        <span class="sr-only">Administración de presencia digital con IA en Colombia.</span>
        <span class="home-hero-visual" aria-hidden="true">
          <span class="home-hero-line home-hero-lead" data-home-lead>
            <span class="home-hero-word">TU</span>
            <span class="home-hero-word">PRESENCIA</span>
            <span class="home-hero-word">DIGITAL</span>
          </span>
          <span class="home-hero-line home-hero-tail" data-home-tail>
            <span class="home-hero-word">ADMINISTRADA</span>
            <span class="home-hero-word">DE</span>
            <span class="home-hero-word">VERDAD.</span>
          </span>
        </span>
      </h1>
      <div class="home-hero-actions" data-home-actions>
        <a class="btn btn-ghost" href="/servicios/">
          Qué incluye <span aria-hidden="true">↗</span>
        </a>
        <a class="btn btn-primary" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
          Diagnóstico gratis <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Prueba --------------------------------------------------------------- -->
  <section class="proof" aria-label="Cifras del servicio">
    <div class="wrap proof-grid">
      <div class="stat">
        <strong data-count="100000" data-prefix="$">$100.000</strong>
        <span>COP / mes · desde</span>
      </div>
      <div class="stat">
        <strong data-count={clients.length}>{clients.length}</strong>
        <span>clientes en producción</span>
      </div>
      <div class="stat">
        <strong>7:00–19:00</strong>
        <span>atención humana, todos los días</span>
      </div>
      <div class="stat">
        <strong>24/7</strong>
        <span>WhatsApp con recepción automática</span>
      </div>
    </div>
  </section>

  <!-- 3. Marquee de rubros ---------------------------------------------------- -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {marqueeItems.map((item) => <span>{item}</span>)}
      {marqueeItems.map((item) => <span>{item}</span>)}
    </div>
  </div>

  <TrustStrip />

  <!-- 4. Pilares -------------------------------------------------------------- -->
  <ServicePillars />

  <!-- 5. Método IA ------------------------------------------------------------ -->
  <AiTeam />

  <!-- 6. Clientes reales ------------------------------------------------------ -->
  <ClientGrid limit={9} />

  <!-- 6b. Casos y testimonios aprobados (no renderiza si no hay datos) -------- -->
  <ProofSection />

  <!-- 7. Proceso -------------------------------------------------------------- -->
  <OnboardingTimeline />

  <!-- 8. Planes --------------------------------------------------------------- -->
  <PlansGrid id="planes" heading={true} />

  <!-- 9. FAQ ------------------------------------------------------------------ -->
  <section class="section wrap" id="preguntas">
    <div class="section-head">
      <div>
        <p class="eyebrow">PREGUNTAS FRECUENTES</p>
        <h2 data-split>Lo esencial, <em>sin letra pequeña.</em></h2>
      </div>
      <p class="lead">
        Alcance, precios, IA y acceso de clientes. Para el resto está el diagnóstico gratuito y el
        hub de preguntas.
      </p>
    </div>
    <FaqList faqs={faqs} />
    <p class="stack-note">
      ¿Otra duda? Ver <a href="/preguntas/">todas las preguntas frecuentes</a> o
      <a href="/contacto/">escríbenos</a>.
    </p>
  </section>

  <!-- 10. CTA final ----------------------------------------------------------- -->
  <FinalCta
    eyebrow="EMPIEZA CON DIAGNÓSTICO GRATIS"
    title="Revisamos tu presencia. <em>Te decimos qué falta.</em>"
    note="20 minutos por Google Meet o WhatsApp · Sin compromiso · Plan y presupuesto claros antes de pagar"
  />
</BaseLayout>
