---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlansGrid from '../components/PlansGrid.astro';
import { organizationSchema, websiteSchema, localBusinessSchema } from '../components/schemas';

const title = 'Web y SEO local desde $40.000 COP/mes | Presentto Online';
const description =
  'Presencia online profesional desde $40.000 COP/mes con SEO local en Funza, Mosquera, Madrid y Facatativá. Web, dominio y correo incluidos. Demo gratis.';
const homeService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Presenttación Digital',
  description:
    'Sitio web profesional con dominio propio, correo, SEO local y administración para negocios de la Sabana Occidental.',
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: [
    { '@type': 'Place', name: 'Funza' },
    { '@type': 'Place', name: 'Mosquera' },
    { '@type': 'Place', name: 'Madrid' },
    { '@type': 'Place', name: 'Facatativá' },
    { '@type': 'Place', name: 'Sabana Occidental, Colombia' },
  ],
  offers: [
    {
      '@type': 'Offer',
      name: '1 mes',
      price: '40000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 1 mes, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/2j4gTPj',
    },
    {
      '@type': 'Offer',
      name: '3 meses',
      price: '100000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 3 meses, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/17JYVwX',
    },
    {
      '@type': 'Offer',
      name: '6 meses',
      price: '210000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 6 meses, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/1j4eF1j',
    },
    {
      '@type': 'Offer',
      name: '1 año',
      price: '389000',
      priceCurrency: 'COP',
      description: 'Presenttación Digital — 1 año, IVA incluido',
      availability: 'https://schema.org/InStock',
      url: 'https://mpago.li/344eu17',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonld={[organizationSchema, websiteSchema, localBusinessSchema, homeService]}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <img
        class="hero-logo"
        src="/assets/img/Presentto-Nombre-Fondo-Transparente.webp"
        alt="Presentto Online"
        width="340"
        height="116"
        fetchpriority="high"
        decoding="async"
      />
      <p class="eyebrow">WEB PROFESIONAL · SABANA OCCIDENTAL</p>
      <h1>Tu negocio, <em>visible y posicionado en la Sabana Occidental.</em></h1>
      <p class="lead">
        Una web clara, rápida y lista para convertir visitas en clientes. Con dominio, correo y SEO local
        incluidos.
      </p>
      <div class="hero-price">
        <strong>desde $40.000</strong>
        <span>COP / mes<br />IVA incluido</span>
      </div>
      <div class="actions">
        <a
          class="button primary"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20la%20Presenttaci%C3%B3n%20Digital"
          target="_blank"
          rel="noopener"
        >
          Comprar Presenttación Digital <span>↗</span>
        </a>
        <a class="button ghost" href="#planes">Ver planes <span>↓</span></a>
      </div>
      <p class="hero-demo">
        <a
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
          target="_blank"
          rel="noopener"
        >
          ¿Prefieres verlo primero? Solicita una demo web gratis, sin abono ↗
        </a>
      </p>
    </div>
    <div class="hero-visual">
      <div class="visual-window">
        <div class="window-bar">
          <i></i><i></i><i></i><span>tuempresa.online</span>
        </div>
        <div class="window-content">
          <span class="visual-tag">TU NEGOCIO</span>
          <strong>Una web clara<br />que trabaja<br /><em>por ti.</em></strong>
          <div class="visual-qr">
            <svg viewBox="0 0 31 31" aria-hidden="true" shape-rendering="crispEdges"><path stroke="currentColor" stroke-width=".7" fill="none" d="M1 1.5h7m2 0h2m1 0h1m2 0h6m1 0h7M1 2.5h1m5 0h1m4 0h1m5 0h1m4 0h1m5 0h1M1 3.5h1m1 0h3m1 0h1m1 0h3m1 0h1m1 0h1m1 0h1m2 0h2m1 0h1m1 0h3m1 0h1M1 4.5h1m1 0h3m1 0h1m1 0h3m5 0h2m1 0h1m2 0h1m1 0h3m1 0h1M1 5.5h1m1 0h3m1 0h1m1 0h1m3 0h4m1 0h3m2 0h1m1 0h3m1 0h1M1 6.5h1m5 0h1m1 0h1m2 0h7m2 0h1m1 0h1m5 0h1M1 7.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M9 8.5h3m1 0h2m1 0h1m2 0h3M1 9.5h1m1 0h5m4 0h2m1 0h2m1 0h1m1 0h1m2 0h5M1 10.5h1m2 0h3m3 0h3m3 0h6m1 0h3m3 0h1M1 11.5h2m2 0h3m1 0h2m1 0h1m9 0h1M1 12.5h1m1 0h2m1 0h1m2 0h1m1 0h3m1 0h1m1 0h1m1 0h1m1 0h2m1 0h1m1 0h1m1 0h1M1 13.5h1m1 0h1m1 0h1m1 0h3m7 0h2m2 0h1m4 0h2M2 14.5h3m4 0h2m1 0h1m1 0h3m1 0h4m1 0h1m1 0h1m3 0h1M1 15.5h4m2 0h1m3 0h7m1 0h1m2 0h1m1 0h1m1 0h2M1 16.5h1m1 0h2m1 0h1m1 0h1m1 0h1m2 0h2m1 0h1m4 0h5m2 0h1M4 17.5h1m1 0h3m1 0h1m1 0h1m2 0h2m1 0h1m2 0h1m2 0h1m1 0h2M1 18.5h3m1 0h1m2 0h1m1 0h1m1 0h1m3 0h10m1 0h1m1 0h1M1 19.5h1m1 0h3m1 0h2m1 0h3m5 0h1m5 0h1m2 0h1M1 20.5h1m2 0h1m1 0h1m1 0h1m4 0h1m1 0h1m1 0h1m1 0h3m2 0h2m2 0h1M1 21.5h1m1 0h1m1 0h1m1 0h2m3 0h2m3 0h2m1 0h6m1 0h3M9 22.5h1m1 0h2m1 0h3m2 0h1m1 0h1m3 0h5M1 23.5h7m3 0h1m1 0h5m2 0h2m1 0h1m1 0h3M1 24.5h1m5 0h1m1 0h1m1 0h2m1 0h1m1 0h1m3 0h2m3 0h1M1 25.5h1m1 0h3m1 0h1m1 0h1m2 0h1m2 0h2m1 0h2m1 0h5m1 0h1m1 0h1M1 26.5h1m1 0h3m1 0h1m1 0h2m1 0h3m1 0h5m3 0h1m1 0h2M1 27.5h1m1 0h3m1 0h1m1 0h2m1 0h1m1 0h1m3 0h1m1 0h1m2 0h6M1 28.5h1m5 0h1m2 0h1m1 0h3m2 0h1m3 0h2m1 0h1m1 0h1m1 0h1M1 29.5h7m1 0h4m2 0h1m3 0h2m2 0h5"/></svg>
            <small>presentto<br />.online</small>
          </div>
        </div>
      </div>
      <div class="visual-note">Diseño · SEO local · Dominio<br /><b>Administrado por Presentto</b></div>
    </div>
  </section>

  <section class="proof">
    <div class="wrap proof-grid">
      <div><strong>desde $40.000</strong><span>COP / mes · IVA incl.</span></div>
      <div><strong>Demo</strong><span>gratis, sin abono</span></div>
      <div><strong>SEO</strong><span>local incluido</span></div>
    </div>
  </section>

  <PlansGrid id="planes" heading={true} />

  <section class="section wrap" id="como-funciona">
    <p class="eyebrow">WEB ADMINISTRADA PRESENTTO</p>
    <div class="section-heading">
      <h2>Todo lo necesario para <em>ganar visibilidad.</em></h2>
      <p>
        Un solo plan te da presencia online profesional: dominio propio, contenido estratégico, diseño y SEO
        local para la Sabana Occidental.
      </p>
    </div>
    <div class="feature-grid feature-grid-four">
      <article>
        <b>01</b>
        <h3>Creación personalizada</h3>
        <p>Imagen, estilo, textos y fotos alineados con la identidad real de tu empresa.</p>
      </article>
      <article>
        <b>02</b>
        <h3>Dominio y correo profesional</h3>
        <p>Dominio propio <strong>tuempresa.online</strong> y correo <strong>@tuempresa.online</strong> incluidos.</p>
      </article>
      <article>
        <b>03</b>
        <h3>SEO local en tu ciudad</h3>
        <p>
          Estructura SEO para que te encuentren en
          <a href="/funza/">Funza</a>, <a href="/mosquera/">Mosquera</a>, <a href="/madrid/">Madrid</a>,
          <a href="/facatativa/">Facatativá</a> y la Sabana Occidental.
        </p>
      </article>
      <article>
        <b>04</b>
        <h3>Contenido e identidad</h3>
        <p>Textos, fotos y llamadas a la acción de tu negocio, listos para crecer contigo.</p>
      </article>
    </div>
    <div class="actions plan-cta">
      <a class="button primary" href="#planes">Comprar Presenttación Digital <span>↗</span></a>
      <a
        class="button ghost"
        href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
        target="_blank"
        rel="noopener"
      >
        Pedir demo gratis <span>↗</span>
      </a>
    </div>
  </section>

  <section class="section industries-section">
    <div class="wrap">
      <p class="eyebrow">UNA WEB PARA CADA IDEA</p>
      <h2 class="center">Presencia digital <em>sin complicaciones.</em></h2>
      <div class="industry-grid">
        <span>Negocios locales</span>
        <span>Portafolios profesionales</span>
        <span>Emprendimientos</span>
        <span>Empresas</span>
        <span>Blogs personales</span>
        <span>Campañas y promociones</span>
        <span>Sitios de acceso temporal</span>
        <span>Encuestas temporales</span>
      </div>
    </div>
  </section>

  <section class="section trust-section">
    <div class="wrap">
      <p class="eyebrow center">RESULTADOS DE REFERENCIA</p>
      <div class="section-heading">
        <h2>Una web que se siente <em>hecha para tu negocio.</em></h2>
        <p>Escenarios habituales que una Presenttación Digital bien construida ayuda a resolver desde el primer día.</p>
      </div>
      <div class="trust-grid">
        <article class="trust-card">
          <span class="trust-icon">01</span>
          <h3>Más confianza</h3>
          <p>Una presencia clara para que nuevos clientes entiendan quién eres, qué ofreces y cómo contactarte.</p>
          <small>Resultado esperado · No es una reseña publicada</small>
        </article>
        <article class="trust-card">
          <span class="trust-icon">02</span>
          <h3>Más oportunidades</h3>
          <p>Información ordenada, llamadas a la acción visibles y una experiencia pensada para convertir visitas en conversaciones.</p>
          <small>Resultado esperado · Se adapta a tus objetivos</small>
        </article>
        <article class="trust-card">
          <span class="trust-icon">03</span>
          <h3>Más autonomía</h3>
          <p>Un sitio propio con dominio, correo profesional y una base digital lista para acompañar el crecimiento del negocio.</p>
          <small>Resultado esperado · Alcance acordado contigo</small>
        </article>
      </div>
    </div>
  </section>

  <section class="section stack-section">
    <div class="wrap">
      <p class="eyebrow">RESPALDO TÉCNICO</p>
      <div class="section-heading">
        <h2>Tecnología útil, <em>sin complicaciones.</em></h2>
        <p>Trabajamos con tecnologías y estándares profesionales para construir una presencia rápida, accesible y preparada para crecer.</p>
      </div>
      <div class="stack-grid">
        <article class="stack-card">
          <img src="/assets/img/icons/html5.svg" alt="Icono HTML5" width="42" height="42" loading="lazy" />
          <strong>HTML5</strong><span>Estructura semántica</span>
        </article>
        <article class="stack-card">
          <img src="/assets/img/icons/css3.svg" alt="Icono CSS3" width="42" height="42" loading="lazy" />
          <strong>CSS3</strong><span>Diseño responsive</span>
        </article>
        <article class="stack-card">
          <img src="/assets/img/icons/javascript.svg" alt="Icono JavaScript" width="42" height="42" loading="lazy" />
          <strong>JavaScript</strong><span>Interacciones útiles</span>
        </article>
        <article class="stack-card">
          <span class="stack-badge">SEO</span><strong>SEO local</strong><span>Encontrabilidad técnica</span>
        </article>
        <article class="stack-card">
          <span class="stack-badge">A11Y</span><strong>Accesibilidad</strong><span>Experiencia inclusiva</span>
        </article>
        <article class="stack-card">
          <span class="stack-badge">CWV</span><strong>Core Web Vitals</strong><span>Velocidad y experiencia</span>
        </article>
      </div>
      <p class="stack-note">Tecnologías y estándares de trabajo. No representa certificaciones oficiales de terceros.</p>
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">¿LISTO PARA MOSTRAR LO QUE HACES?</p>
      <h2>Tu web puede estar lista <em>en pocos días.</em></h2>
      <div class="actions">
        <a class="button light" href="#planes">Ver planes <span>↗</span></a>
        <a
          class="button ghost light-ghost"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
          target="_blank"
          rel="noopener"
        >
          Demo gratis <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
