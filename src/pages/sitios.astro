---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Sitios publicados con SEO local y posicionamiento | Presentto Online';
const description =
  'Sitios reales construidos y publicados con Presenttación Digital en la Sabana Occidental: SEO on-page, ficha de Maps y tráfico orgánico.';

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sitios publicados Presentto',
  url: 'https://www.presentto.online/sitios/',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Botane', url: 'https://botane.presentto.online/' },
    { '@type': 'ListItem', position: 2, name: 'KSPR', url: 'https://kspr.presentto.online/' },
    { '@type': 'ListItem', position: 3, name: 'Esturel', url: 'https://esturel.presentto.online/' },
    { '@type': 'ListItem', position: 4, name: 'LYL', url: 'https://lyl.presentto.online/' },
    { '@type': 'ListItem', position: 5, name: 'Viking Dogs', url: 'https://vikingdogs.presentto.online/' },
    { '@type': 'ListItem', position: 6, name: 'YA', url: 'https://ya.presentto.online/' },
    { '@type': 'ListItem', position: 7, name: 'Knifopics', url: 'https://knifopics.presentto.online/' },
    { '@type': 'ListItem', position: 8, name: 'Aeperion', url: 'https://aeperion.presentto.online/' },
    { '@type': 'ListItem', position: 9, name: 'USPKH', url: 'https://uspkh.presentto.online/' },
  ],
};

const sites = [
  { name: 'Botane', url: 'https://botane.presentto.online/', host: 'botane.presentto.online' },
  { name: 'KSPR', url: 'https://kspr.presentto.online/', host: 'kspr.presentto.online' },
  { name: 'Esturel', url: 'https://esturel.presentto.online/', host: 'esturel.presentto.online' },
  { name: 'LYL', url: 'https://lyl.presentto.online/', host: 'lyl.presentto.online' },
  { name: 'Viking Dogs', url: 'https://vikingdogs.presentto.online/', host: 'vikingdogs.presentto.online' },
  { name: 'YA', url: 'https://ya.presentto.online/', host: 'ya.presentto.online' },
  { name: 'Knifopics', url: 'https://knifopics.presentto.online/', host: 'knifopics.presentto.online' },
  { name: 'Aeperion', url: 'https://aeperion.presentto.online/', host: 'aeperion.presentto.online' },
  { name: 'USPKH', url: 'https://uspkh.presentto.online/', host: 'uspkh.presentto.online' },
];
---

<BaseLayout title={title} description={description} path="/sitios/" jsonld={[listSchema]}>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Sitios' }]} />

  <section class="section wrap page-hero map-hero">
    <p class="eyebrow">SITIOS PUBLICADOS · SEO Y POSICIONAMIENTO</p>
    <img
      class="page-logo"
      src="/assets/img/Presentto-Nombre-Fondo-Transparente.webp"
      alt="Presentto Online"
      width="240"
      height="81"
      fetchpriority="high"
      decoding="async"
    />
    <h1>Proyectos que ya están <em>presentes online.</em></h1>
    <p class="lead">
      Visita los sitios que ya construimos y publicamos. Cada uno con su rubro, su identidad y su base de
      SEO on-page — así se ve el trabajo de Presentto en producción y posicionándose en Google.
    </p>
  </section>

  <section class="section map-section">
    <div class="wrap published-sites">
      <div class="map-directory">
        <p class="eyebrow">SITIOS PUBLICADOS</p>
        <h2>Explora los sitios publicados.</h2>
        <ol class="business-list">
          {sites.map((site, i) => (
            <li>
              <a href={site.url} target="_blank" rel="noopener">
                <span class="business-index">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{site.name}</strong>
                  <small>{site.host}</small>
                </span>
                <b>↗</b>
              </a>
            </li>
          ))}
        </ol>
        <p class="map-note">
          Todos se publican en la infraestructura administrada de Presentto con indexación, sitemap y datos
          estructurados listos para el rastreo de Google. Cada sitio conserva su identidad y muestra una
          aplicación distinta de la misma base técnica.
        </p>
      </div>
    </div>
  </section>

  <section class="section map-principles">
    <div class="wrap">
      <p class="eyebrow">UNA WEB QUE SE ADAPTA A TI</p>
      <h2>Una presencia clara para <em>cada negocio.</em></h2>
      <div class="feature-grid feature-grid-three">
        <article><b>01</b><h3>Identidad propia</h3><p>Cada sitio parte de tu negocio real: tu tono, tus fotos y la forma en que atiendes a tus clientes.</p></article>
        <article><b>02</b><h3>Indexable y compartible</h3><p>URL limpia, sitemap y datos estructurados listos para el rastreo — fácil de mandar por WhatsApp, redes, QR o tarjeta.</p></article>
        <article><b>03</b><h3>Administrada por Presentto</h3><p>Nosotros la mantenemos publicada y operando según el alcance acordado. Tú no tocas el servidor.</p></article>
      </div>
      <div class="guide-cta guide-cta-tight">
        <a
          class="button primary"
          href="https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio"
          target="_blank"
          rel="noopener"
        >
          Quiero un sitio así para mi negocio <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
