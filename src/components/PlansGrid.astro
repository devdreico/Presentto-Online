---
import { plans } from '../data/plans';

interface Props {
  id?: string;
  heading?: boolean;
}
const { id = 'planes', heading = true } = Astro.props;

const DEMO_URL =
  'https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio';
---

<section class="section plans-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    {heading && (
      <div class="section-heading plans-heading">
        <div>
          <p class="eyebrow">PLANES · PREPAGO POR PLAZO</p>
          <h2 id={`${id}-title`}>Elige tu plan. <em>Empieza con la demo.</em></h2>
        </div>
        <p>
          Paga solo cuando veas la web de tu negocio y estés conforme. Sin abono para pedir tu demo, sin
          suscripción automática y sin permanencia. Pago seguro con Mercado Pago.
        </p>
      </div>
    )}
    <div class="plans-grid">
      {plans.map((plan) => (
        <article class:list={['plan-card', { 'plan-featured': plan.featured }]}>
          {plan.badge && <span class="plan-badge">{plan.badge}</span>}
          <h3 class="plan-name">{plan.name}</h3>
          <div class="plan-price">
            <strong>{plan.price}</strong>
            <span>{plan.unit}</span>
          </div>
          {plan.per && <p class="plan-per">{plan.per}</p>}
          <ul class="plan-perks">
            <li>Web lista con tu contenido, fotos y servicios</li>
            <li>Dominio y correo profesionales incluidos</li>
            <li>SEO local en la Sabana Occidental</li>
            <li>Ajustes y administración durante el plan</li>
          </ul>
          <a
            class:list={['button', 'plan-cta', { primary: plan.featured, ghost: !plan.featured }]}
            href={plan.url}
            target="_blank"
            rel="noopener noreferrer"
            data-plan-checkout
            data-pay={plan.url}
            data-plan={plan.name}
            data-price={plan.price}
          >
            Pagar {plan.name} <span>↗</span>
          </a>
        </article>
      ))}
    </div>
    <div class="plans-demo">
      <div class="plans-demo-copy">
        <strong>¿Prefieres verlo antes de pagar?</strong>
        <p>Pide la demo web de tu negocio: sin abono y sin compromiso. Pagas solo si te gusta.</p>
      </div>
      <a class="button ghost" href={DEMO_URL} target="_blank" rel="noopener">
        Pedir demo gratis <span>↗</span>
      </a>
    </div>
    <p class="plans-note">
      Todos los precios incluyen IVA. Es un pago único por el plazo elegido, no una mensualidad recurrente.
      La entrega se agenda tras confirmar el plan y el pago revisado en Mercado Pago.
      {Astro.url.pathname !== '/precios/' && (
        <> <a href="/precios/">Ver planes y precios en detalle</a>.</>
      )}
    </p>
  </div>
</section>

<dialog class="plan-checkout" id="planCheckout" aria-labelledby="planCheckoutTitle">
  <div class="plan-checkout-head">
    <p class="eyebrow">DATOS ANTES DE PAGAR</p>
    <h2 id="planCheckoutTitle">Completa tus datos <em>y continúa al pago.</em></h2>
    <p class="plan-checkout-summary">
      Plan: <strong data-checkout-plan>—</strong>
      · <strong data-checkout-price>—</strong>
    </p>
  </div>
  <form id="planCheckoutForm" class="plan-checkout-form" novalidate>
    <label>
      Tu nombre
      <input name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre completo" />
    </label>
    <label>
      WhatsApp
      <input
        name="whatsapp"
        type="tel"
        required
        autocomplete="tel"
        inputmode="tel"
        pattern="[0-9+\s()-]{7,}"
        placeholder="+57 300 000 0000"
      />
    </label>
    <input type="hidden" name="plan" data-field="plan" />
    <input type="hidden" name="precio" data-field="precio" />
    <input type="hidden" name="hora" data-field="hora" />
    <input type="hidden" name="zona_horaria" data-field="zona_horaria" />
    <input type="hidden" name="pagina" data-field="pagina" />
    <input type="hidden" name="referrer" data-field="referrer" />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
    <button class="button primary plan-checkout-submit" type="submit">
      Enviar y pagar <span>↗</span>
    </button>
    <p class="form-note">
      Solo usamos tu nombre y WhatsApp para identificar tu compra y coordinar la entrega de tu web.
      <a href="/privacidad/" target="_blank" rel="noopener">Política de privacidad</a>.
    </p>
    <p id="planCheckoutStatus" class="plan-checkout-status" role="status" aria-live="polite"></p>
    <button type="button" class="plan-checkout-cancel" data-checkout-cancel>Cancelar</button>
  </form>
</dialog>

<script is:inline>
  (function () {
    var FORMSPREE = 'https://formspree.io/f/xeaokwly';
    var dialog = document.getElementById('planCheckout');
    var form = document.getElementById('planCheckoutForm');
    var statusEl = document.getElementById('planCheckoutStatus');
    if (!dialog || !form || !statusEl) return;

    var planLabel = dialog.querySelector('[data-checkout-plan]');
    var priceLabel = dialog.querySelector('[data-checkout-price]');
    var fPlan = form.querySelector('[data-field="plan"]');
    var fPrecio = form.querySelector('[data-field="precio"]');
    var fHora = form.querySelector('[data-field="hora"]');
    var fTz = form.querySelector('[data-field="zona_horaria"]');
    var fPagina = form.querySelector('[data-field="pagina"]');
    var fRef = form.querySelector('[data-field="referrer"]');
    var submitBtn = form.querySelector('button[type="submit"]');
    var payUrl = '';
    var busy = false;

    function setStatus(msg, isError) {
      statusEl.textContent = msg || '';
      statusEl.className = 'plan-checkout-status' + (msg ? (isError ? ' form-error' : ' form-status') : '');
    }

    var track = window.__presenttoTrack || function () {};

    function localHora() {
      try {
        return new Date().toLocaleString('es-CO', {
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          hour12: false,
          timeZoneName: 'short',
        });
      } catch (e) {
        return new Date().toString();
      }
    }

    function timezone() {
      try { return Intl.DateTimeFormat().resolvedOptions().timeZone || ''; }
      catch (e) { return ''; }
    }

    function closeDialog() {
      if (typeof dialog.close === 'function' && dialog.open) dialog.close();
      document.body.classList.remove('modal-open');
    }

    function openCheckout(btn) {
      payUrl = btn.getAttribute('data-pay') || '';
      var plan = btn.getAttribute('data-plan') || '';
      var price = btn.getAttribute('data-price') || '';
      if (planLabel) planLabel.textContent = plan;
      if (priceLabel) priceLabel.textContent = price;
      if (fPlan) fPlan.value = plan;
      if (fPrecio) fPrecio.value = price;
      form.reset();
      if (fPlan) fPlan.value = plan;
      if (fPrecio) fPrecio.value = price;
      setStatus('', false);
      document.body.classList.add('modal-open');
      track('checkout_start', { plan: plan, price: price, page_path: location.pathname });
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
        var first = form.querySelector('input[name="nombre"]');
        if (first) first.focus();
      } else {
        location.href = payUrl;
      }
    }

    document.querySelectorAll('[data-plan-checkout]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        if (typeof dialog.showModal !== 'function') return;
        e.preventDefault();
        openCheckout(btn);
      });
    });

    dialog.addEventListener('close', function () {
      document.body.classList.remove('modal-open');
    });
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) closeDialog();
    });
    var cancelBtn = dialog.querySelector('[data-checkout-cancel]');
    if (cancelBtn) cancelBtn.addEventListener('click', closeDialog);

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (busy) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (!payUrl) {
        setStatus('No encontramos el enlace de pago. Cierra e intenta de nuevo.', true);
        return;
      }

      busy = true;
      if (submitBtn) submitBtn.disabled = true;
      setStatus('Enviando tus datos…', false);

      if (fHora) fHora.value = new Date().toISOString() + ' | ' + localHora();
      if (fTz) fTz.value = timezone();
      if (fPagina) fPagina.value = location.href;
      if (fRef) fRef.value = document.referrer || '';

      var data = {
        nombre: (form.nombre && form.nombre.value || '').trim(),
        whatsapp: (form.whatsapp && form.whatsapp.value || '').trim(),
        plan: fPlan ? fPlan.value : '',
        precio: fPrecio ? fPrecio.value : '',
        hora: fHora ? fHora.value : '',
        zona_horaria: fTz ? fTz.value : '',
        pagina: fPagina ? fPagina.value : '',
        referrer: fRef ? fRef.value : '',
        _subject: 'Pago plan ' + (fPlan ? fPlan.value : '') + ' — Presentto',
        _gotcha: (form._gotcha && form._gotcha.value) || '',
      };

      try {
        var res = await fetch(FORMSPREE, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('send');
        setStatus('¡Listo! Te llevamos al pago seguro de Mercado Pago…', false);
        track('checkout_lead_sent', {
          plan: fPlan ? fPlan.value : '',
          price: fPrecio ? fPrecio.value : '',
          page_path: location.pathname,
        });
        setTimeout(function () {
          location.href = payUrl;
        }, 400);
      } catch (err) {
        setStatus('No pudimos enviar tus datos. Revisa tu conexión e inténtalo de nuevo.', true);
        track('checkout_error', { plan: fPlan ? fPlan.value : '', page_path: location.pathname });
        busy = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  })();
</script>
