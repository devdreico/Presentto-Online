---
import { plans } from '../data/plans';
import { ctaSession } from '../data/business';

interface Props {
  id?: string;
  heading?: boolean;
}
const { id = 'planes', heading = true } = Astro.props;

const mvoPlans = plans.filter((p) => p.id.includes('mvo'));
const ownDomainPlans = plans.filter((p) => !p.id.includes('mvo'));

const mvoPerks = [
  'Subdominio <code>cliente.presentto.online</code>',
  'Sitio administrado y diseño a tu gusto',
  '3 sesiones de asesoría por Google Meet',
  'Ajustes, mantenimiento y velocidad incluidos',
];
const domainPerks = [
  'Web lista con tu contenido y fotos',
  'Dominio propio (.com/.online) y correo profesional',
  'Presencia digital optimizada para Google',
  'Administración y soporte durante todo el plan',
];
---

<section class="section plans-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    {heading && (
      <div class="section-head center">
        <p class="eyebrow">PLANES · MVO Y DOMINIO PROPIO</p>
        <h2 id={`${id}-title`}>Elige tu plan. <em>Empieza con la asesoría.</em></h2>
        <p class="lead">
          MVO en subdominio desde $15.000/mes con 3 sesiones incluidas, o tu dominio propio con
          correo profesional. Pagas con Mercado Pago, sin permanencia.
        </p>
      </div>
    )}

    <div class="plans-toolbar">
      <div class="seg-tabs" role="tablist" aria-label="Tipo de plan" data-plans-tabs data-active="0">
        <span class="seg-indicator" aria-hidden="true"></span>
        <button
          class="seg-tab"
          type="button"
          role="tab"
          id="tab-mvo"
          aria-selected="true"
          aria-controls="panel-mvo"
          data-tab="mvo"
        >
          MVO · Subdominio
        </button>
        <button
          class="seg-tab"
          type="button"
          role="tab"
          id="tab-dominio"
          aria-selected="false"
          aria-controls="panel-dominio"
          data-tab="dominio"
        >
          Dominio propio
        </button>
      </div>
    </div>

    <div class="plans-panel" id="panel-mvo" role="tabpanel" aria-labelledby="tab-mvo" data-panel="mvo">
      <div class="plans-grid cols-2">
        {mvoPlans.map((plan) => (
          <article class:list={['plan-card', { 'plan-featured': plan.featured }]}>
            {plan.badge && <span class="plan-badge">{plan.badge}</span>}
            <h3 class="plan-name">{plan.name}</h3>
            <div class="plan-price">
              <strong>${plan.price}</strong>
              <span>{plan.unit}</span>
            </div>
            {plan.per && <p class="plan-per">{plan.per}</p>}
            <p class="plan-usd">≈ {plan.priceUsd} (ref. USD)</p>
            <ul class="plan-perks">
              {mvoPerks.map((perk) => <li set:html={perk} />)}
            </ul>
            <a
              class:list={['btn', 'plan-cta', { 'btn-primary': plan.featured, 'btn-ghost': !plan.featured }]}
              href={plan.url}
              target="_blank"
              rel="noopener noreferrer"
              data-plan-checkout
              data-pay={plan.url}
              data-plan={plan.name}
              data-price={plan.price}
            >
              Pagar {plan.name} <span>↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div
      class="plans-panel"
      id="panel-dominio"
      role="tabpanel"
      aria-labelledby="tab-dominio"
      data-panel="dominio"
      hidden
    >
      <div class="plans-grid cols-4">
        {ownDomainPlans.map((plan) => (
          <article class:list={['plan-card', { 'plan-featured': plan.featured }]}>
            {plan.badge && <span class="plan-badge">{plan.badge}</span>}
            <h3 class="plan-name">{plan.name}</h3>
            <div class="plan-price">
              <strong>${plan.price}</strong>
              <span>{plan.unit}</span>
            </div>
            {plan.per && <p class="plan-per">{plan.per}</p>}
            <p class="plan-usd">≈ {plan.priceUsd} (ref. USD)</p>
            <ul class="plan-perks">
              {domainPerks.map((perk) => <li set:html={perk} />)}
            </ul>
            <a
              class:list={['btn', 'plan-cta', { 'btn-primary': plan.featured, 'btn-ghost': !plan.featured }]}
              href={plan.url}
              target="_blank"
              rel="noopener noreferrer"
              data-plan-checkout
              data-pay={plan.url}
              data-plan={plan.name}
              data-price={plan.price}
            >
              Pagar {plan.name} <span>↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div class="plans-foot">
      <div>
        <strong>¿Primero quieres hablarlo?</strong>
        <p>Agenda la Sesión 1 (30 min): resolvemos dudas y vemos tu caso antes de que pagues nada.</p>
      </div>
      <a class="btn btn-ghost btn-sm" href={ctaSession} target="_blank" rel="noopener">
        Agendar sesión 1 <span>↗</span>
      </a>
    </div>
    <p class="plans-note">
      Todos los precios incluyen IVA. El MVO funciona mediante subdominio compartido para optimizar
      costos.
      {Astro.url.pathname !== '/precios/' && (
        <> <a href="/precios/">Ver comparativa completa de planes</a>.</>
      )}
    </p>
  </div>
</section>

<dialog class="plan-checkout" id="planCheckout" aria-labelledby="planCheckoutTitle">
  <div class="plan-checkout-head">
    <p class="eyebrow">DATOS ANTES DE PAGAR</p>
    <h2 id="planCheckoutTitle">Completa tus datos <em>y continúa al pago.</em></h2>
    <p class="plan-checkout-summary">
      Plan: <strong data-checkout-plan>—</strong>
      · <strong data-checkout-price>—</strong>
    </p>
  </div>
  <form id="planCheckoutForm" class="plan-checkout-form" novalidate>
    <label>
      Tu nombre
      <input name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre completo" />
    </label>
    <label>
      WhatsApp
      <input
        name="whatsapp"
        type="tel"
        required
        autocomplete="tel"
        inputmode="tel"
        pattern="[0-9+\s()-]{7,}"
        placeholder="+57 300 000 0000"
      />
    </label>
    <input type="hidden" name="plan" data-field="plan" />
    <input type="hidden" name="precio" data-field="precio" />
    <input type="hidden" name="hora" data-field="hora" />
    <input type="hidden" name="zona_horaria" data-field="zona_horaria" />
    <input type="hidden" name="pagina" data-field="pagina" />
    <input type="hidden" name="referrer" data-field="referrer" />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
    <button class="btn btn-primary plan-checkout-submit" type="submit">
      Enviar y pagar <span>↗</span>
    </button>
    <p class="form-note">
      Solo usamos tu nombre y WhatsApp para coordinar tus sesiones de Google Meet y la entrega de tu
      web. <a href="/privacidad/">Política de privacidad</a>.
    </p>
    <p id="planCheckoutStatus" class="plan-checkout-status" role="status" aria-live="polite"></p>
    <button type="button" class="plan-checkout-cancel" data-checkout-cancel>Cancelar</button>
  </form>
</dialog>
