---
import { plans, prepaid, cop, type BillingCycle } from '../data/service';
import { paymentLink } from '../data/payments';
import { ctaDiagnostico, wa } from '../data/business';

interface Props {
  id?: string;
  heading?: boolean;
  defaultCycle?: BillingCycle;
}
const { id = 'planes', heading = true, defaultCycle = 'mensual' } = Astro.props;

const cycles: Array<{ id: BillingCycle; label: string }> = [
  { id: 'mensual', label: 'Mensual' },
  { id: 'anual', label: 'Anual · −15%' },
];

const priceFor = (plan: (typeof plans)[number], cycle: BillingCycle) => {
  if (cycle === 'anual') {
    return plan.annual ? cop(plan.annual) : 'Cotización';
  }
  return `${plan.fromPrice ? 'Desde ' : ''}${cop(plan.monthly)}`;
};

const unitFor = (cycle: BillingCycle) => (cycle === 'anual' ? 'COP / año' : 'COP / mes');

const annualSaving = (plan: (typeof plans)[number]) =>
  plan.annual ? cop(plan.monthly * 12 - plan.annual) : null;
---

<section class="section plans-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    {heading && (
      <div class="section-head center">
        <p class="eyebrow">4 PLANES · MENSUAL O ANUAL</p>
        <h2 id={`${id}-title`}>Elige tu plan. <em>Empieza con el diagnóstico.</em></h2>
        <p class="lead">
          Todos incluyen administración web, ficha de Google, analítica y soporte. Subes de plan
          cuando necesitas SEO, sistemas o automatizaciones, no cuando cambias de proveedor.
        </p>
      </div>
    )}

    <div class="plans-toolbar">
      <div class="seg-tabs" role="tablist" aria-label="Ciclo de pago" data-plans-tabs data-active={defaultCycle === 'anual' ? '1' : '0'}>
        <span class="seg-indicator" aria-hidden="true"></span>
        {cycles.map((cycle) => (
          <button
            class="seg-tab"
            type="button"
            role="tab"
            id={`tab-${cycle.id}`}
            aria-selected={defaultCycle === cycle.id}
            aria-controls={`panel-${cycle.id}`}
            data-tab={cycle.id}
          >
            {cycle.label}
          </button>
        ))}
      </div>
    </div>

    {cycles.map((cycle) => (
      <div
        class="plans-panel"
        id={`panel-${cycle.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${cycle.id}`}
        data-panel={cycle.id}
        hidden={defaultCycle !== cycle.id}
      >
        <div class="plans-grid cols-4">
          {plans.map((plan) => {
            const link = paymentLink(plan.id, cycle.id);
            const price = priceFor(plan, cycle.id);
            const saving = annualSaving(plan);
            const per =
              cycle.id === 'anual' && saving
                ? `Ahorras ${saving} frente al pago mensual`
                : plan.fromPrice
                  ? 'Alcance cotizado tras diagnóstico'
                  : 'Sin permanencia más allá del plazo pagado';

            return (
              <article class:list={['plan-card', { 'plan-featured': plan.featured }]}>
                {plan.featured ? (
                  <span class="plan-badge">Más elegido</span>
                ) : (
                  <span class="plan-badge plan-badge-soft">{plan.name}</span>
                )}
                <h3 class="plan-name">{plan.name}</h3>
                <p class="plan-tagline">{plan.tagline}</p>
                <div class="plan-price">
                  <strong>{price}</strong>
                  {cycle.id === 'anual' && !plan.annual ? (
                    <span>Alcance a medida</span>
                  ) : (
                    <span>{unitFor(cycle.id)}</span>
                  )}
                </div>
                <p class="plan-per">{per}</p>
                <p class="plan-setup">
                  Setup: {plan.setup ? `${cop(plan.setup)} único` : 'cotizado'}
                </p>
                <ul class="plan-perks">
                  {plan.includes.slice(0, 6).map((item) => <li>{item}</li>)}
                </ul>
                {link ? (
                  <>
                    <a
                      class:list={['btn', 'plan-cta', { 'btn-primary': plan.featured, 'btn-ghost': !plan.featured }]}
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-plan-checkout
                      data-pay={link}
                      data-plan={`${plan.name} ${cycle.id}`}
                      data-price={price}
                    >
                      Pagar {plan.name} <span>↗</span>
                    </a>
                    <a
                      class="plan-help"
                      href={wa(`Hola Presentto, tengo dudas sobre el plan ${plan.name} (${cycle.id})`)}
                      target="_blank"
                      rel="noopener"
                    >
                      Tengo dudas
                    </a>
                  </>
                ) : (
                  <a
                    class:list={['btn', 'plan-cta', { 'btn-primary': plan.featured, 'btn-ghost': !plan.featured }]}
                    href={wa(`Hola Presentto, quiero el plan ${plan.name} (${cycle.id})`)}
                    target="_blank"
                    rel="noopener"
                    data-plan-request={plan.id}
                  >
                    {plan.fromPrice ? 'Solicitar cotización' : 'Solicitar link de pago'} <span>↗</span>
                  </a>
                )}
              </article>
            );
          })}
        </div>
      </div>
    ))}

    <div class="plans-foot">
      <div>
        <strong>¿No sabes cuál te sirve?</strong>
        <p>Diagnóstico gratis de 20 minutos: revisamos tu presencia actual y te decimos qué plan aplica.</p>
      </div>
      <a class="btn btn-ghost btn-sm" href={ctaDiagnostico} target="_blank" rel="noopener">
        Pedir diagnóstico <span>↗</span>
      </a>
    </div>
    <p class="plans-note">
      Precios en COP con IVA incluido. IVA a cargo de Presentto. {prepaid.note}
      {Astro.url.pathname !== '/precios/' && (
        <> <a href="/precios/">Ver comparativa completa de planes</a>.</>
      )}
    </p>
  </div>
</section>

<dialog class="plan-checkout" id="planCheckout" aria-labelledby="planCheckoutTitle">
  <div class="plan-checkout-head">
    <p class="eyebrow">DATOS ANTES DE PAGAR</p>
    <h2 id="planCheckoutTitle">Completa tus datos <em>y continúa al pago.</em></h2>
    <p class="plan-checkout-summary">
      Plan: <strong data-checkout-plan>—</strong>
      · <strong data-checkout-price>—</strong>
    </p>
  </div>
  <form id="planCheckoutForm" class="plan-checkout-form" novalidate>
    <label>
      Tu nombre
      <input name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre completo" />
    </label>
    <label>
      WhatsApp
      <input
        name="whatsapp"
        type="tel"
        required
        autocomplete="tel"
        inputmode="tel"
        pattern="[0-9+\s()-]{7,}"
        placeholder="+57 300 000 0000"
      />
    </label>
    <input type="hidden" name="plan" data-field="plan" />
    <input type="hidden" name="precio" data-field="precio" />
    <input type="hidden" name="hora" data-field="hora" />
    <input type="hidden" name="zona_horaria" data-field="zona_horaria" />
    <input type="hidden" name="pagina" data-field="pagina" />
    <input type="hidden" name="referrer" data-field="referrer" />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
    <button class="btn btn-primary plan-checkout-submit" type="submit">
      Enviar y pagar <span>↗</span>
    </button>
    <p class="form-note">
      Usamos tu nombre y WhatsApp para coordinar el setup, la inducción y la entrega.
      <a href="/privacidad/">Política de privacidad</a>.
    </p>
    <p id="planCheckoutStatus" class="plan-checkout-status" role="status" aria-live="polite"></p>
    <button type="button" class="plan-checkout-cancel" data-checkout-cancel>Cancelar</button>
  </form>
</dialog>
