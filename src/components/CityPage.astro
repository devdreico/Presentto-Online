---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import { localBusinessSchema } from '../components/schemas';

interface Props {
  city: string;
  slug: string;
  focus: string;
  sectors: string;
  highlight: string;
  landmarks: string;
  poblacion: string;
  areaKm2: string;
  fuenteDane: string;
  economia: string;
  zona: string;
  hitos: string[];
  sectoresUnicos: string[];
  casoTipo: string;
  faqLocal: { q: string; a: string };
  pasosLocales: string[];
  fuentes: { label: string; href: string }[];
}
const {
  city,
  slug,
  focus,
  sectors,
  highlight,
  landmarks,
  poblacion,
  areaKm2,
  fuenteDane,
  economia,
  zona,
  hitos,
  sectoresUnicos,
  casoTipo,
  faqLocal,
  pasosLocales,
  fuentes,
} = Astro.props;

const path = `/${slug}/`;
const title = `SEO y posicionamiento en Google en ${city} | Presentto`;
const description = `Web con SEO local y posicionamiento en Google en ${city} desde $40.000 COP/mes: schema, ficha de Google, dominio y correo. Demo gratis.`;
const DEMO_URL = `https://wa.me/573236487336?text=${encodeURIComponent(
  `Hola Presentto, quiero solicitar una demo web gratis de mi negocio en ${city}`
)}`;

const crumbs = [{ label: 'Inicio', href: '/' }, { label: city }];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Páginas web con SEO local y posicionamiento en ${city}`,
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: { '@type': 'Place', name: `${city}, Cundinamarca, Colombia` },
  serviceType: 'Diseño web, SEO on-page y posicionamiento local',
  offers: {
    '@type': 'Offer',
    price: '40000',
    priceCurrency: 'COP',
    description: 'Presenttación Digital — IVA incluido',
  },
};

const faqs = [
  {
    q: `¿Cuánto cuesta una página web con SEO local en ${city}?`,
    a: `La Presenttación Digital cuesta desde $40.000 COP/mes con IVA incluido e integra diseño, dominio propio, correo, SEO on-page y SEO local para ${city}. Antes de pagar puedes pedir una demo gratis de tu negocio.`,
  },
  {
    q: `¿Cómo posiciono mi negocio de ${city} en Google y en el pack de Maps?`,
    a: `Con tres patas: web con metas, schema LocalBusiness y contenido de ${city}; Google Business Profile con categorías y NAP coherente (Nombre, Dirección, Teléfono); y reseñas reales y constantes. Nosotros preparamos las dos primeras; las reseñas las decides tú. No prometemos ranking garantizado.`,
  },
  {
    q: `¿Cuánto tarda en indexarse un sitio web en ${city}?`,
    a: `La indexación suele ocurrir en días o semanas tras publicar, con sitemap y Search Console. Posicionarse en búsquedas competitivas de ${city} toma meses de autoridad, contenido y reseñas. La entrega técnica es de pocos días hábiles.`,
  },
  faqLocal,
];

const relatedCities = [
  { slug: 'funza', label: 'Páginas web en Funza' },
  { slug: 'mosquera', label: 'Páginas web en Mosquera' },
  { slug: 'madrid', label: 'Páginas web en Madrid' },
  { slug: 'facatativa', label: 'Páginas web en Facatativá' },
].filter((c) => c.slug !== slug);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonld={[localBusinessSchema, schema]}
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <Breadcrumbs items={crumbs} />

  <section class="section wrap page-hero">
    <p class="eyebrow">SEO LOCAL · POSICIONAMIENTO · {city.toUpperCase()}</p>
    <h1>Tu negocio en {city}, <em>posicionado en Google.</em></h1>
    <p class="lead">
      Aparece en Google, en el pack de Maps y en “cerca de mí” con SEO on-page, schema y contenido
      geolocalizado a {city}. Primero lo ves gratis; pagas solo si te gusta.
    </p>
    <div class="actions">
      <a class="button primary" href={DEMO_URL} target="_blank" rel="noopener">
        Pedir mi demo gratis <span>↗</span>
      </a>
      <a class="button ghost" href="/servicios/">Ver servicio <span>↓</span></a>
    </div>
  </section>

  <section class="section wrap guide-layout">
    <h2>Por qué {city} necesita SEO local</h2>
    <p class="snippet">
      Según el Censo Nacional de Población y Vivienda 2018 del DANE, {city} reúne {poblacion} habitantes
      sobre {areaKm2} km² de territorio (consulta la
      <a href={fuenteDane} target="_blank" rel="noopener">ficha municipal del DANE</a>). Cada una de esas
      personas que busca un producto o un servicio con la palabra “{city}” o con “cerca de mí” decide en
      segundos entre tu competencia local y los resultados de Bogotá que se cuelan por cercanía. Quien no
      aparece cede el cliente sin darse cuenta. Por eso el SEO local aquí no es un extra: es la forma en que
      tu negocio se muestra en el mapa y en los resultados orgánicos.
    </p>
    <p>{economia}</p>

    <h2>Visibilidad orgánica para {focus}</h2>
    <p class="snippet">{sectors}. Una web rápida e indexable convierte esa actividad en consultas que Google
      puede responder con tus páginas, en lugar de con las de otro municipio.</p>
    <p>{highlight}</p>
    <p>{landmarks}</p>

    <h2>Hitos y zona de influencia de {city}</h2>
    <p>{zona}</p>
    <ul>
      {hitos.map((h) => (
        <li>{h}</li>
      ))}
    </ul>

    <h2>Sectores con búsquedas propias en {city}</h2>
    <p>El patrón de búsqueda cambia según el giro. Estos sectores suelen pedir una web con SEO local en
      {city}, con ejemplos de consulta:</p>
    <ul>
      {sectoresUnicos.map((s) => (
        <li>{s}</li>
      ))}
    </ul>
    <p>{casoTipo}</p>

    <h2>Qué incluye la web con SEO local para {city}</h2>
    <ul>
      <li>Diseño personalizado alineado con tu marca y con {focus}.</li>
      <li>Dominio propio y correo profesional (por ejemplo, <strong>tuempresa.online</strong>).</li>
      <li>SEO on-page: meta títulos, meta descripciones, H1–H3, enlaces internos y URL limpias.</li>
      <li>Datos estructurados schema LocalBusiness/Service, más sitemap XML y robots.txt para el rastreo.</li>
      <li>Contenido geolocalizado y palabras clave de cola larga de {city}.</li>
      <li>Orientación de Google Business Profile: categorías, fotos y coherencia NAP.</li>
      <li>Velocidad, Core Web Vitals y administración del hosting por Presentto durante el plan.</li>
    </ul>

    <h2>¿Cuánto cuesta una página web con SEO en {city}?</h2>
    <p class="snippet">
      Desde $40.000 COP/mes con IVA incluido: creación, dominio, correo, SEO on-page, SEO local, schema y
      administración. Prepago de 1, 3, 6 meses o 1 año, sin permanencia. Pide tu demo gratis antes de
      decidir.
    </p>
    <table class="compare-table">
      <thead>
        <tr><th>Opción</th><th>Inversión típica</th><th>Ideal para</th></tr>
      </thead>
      <tbody>
        <tr><td>Presentto ({city}) — 1 mes</td><td>$40.000 COP (IVA incl.)</td><td>Negocios locales que quieren posicionar ya</td></tr>
        <tr><td>Presentto ({city}) — 1 año</td><td>$350.000 COP (IVA incl.)</td><td>Quien busca el mejor coste por mes</td></tr>
        <tr><td>Agencia web + SEO local</td><td>$800.000 – $3.000.000 COP + mant.</td><td>Proyectos grandes con CMS y blog</td></tr>
        <tr><td>Plantilla DIY (Wix, etc.)</td><td>Desde ~20 USD/mes</td><td>Quien quiere hacer SEO y web solo</td></tr>
      </tbody>
    </table>

    <h2>Cómo trabajamos el posicionamiento SEO en {city}</h2>
    <ol>
      <li>Keyword research local: búsquedas reales con intención en {city} y municipios vecinos.</li>
      {pasosLocales.map((p) => (
        <li>{p}</li>
      ))}
      <li>Medición en Google Search Console y ajuste continuo según tráfico orgánico.</li>
    </ol>

    <div class="guide-cta">
      <p><strong>¿Quieres posicionar tu negocio en {city}?</strong></p>
      <a class="button primary" href={DEMO_URL} target="_blank" rel="noopener">
        Pedir mi demo gratis <span>↗</span>
      </a>
      &nbsp;
      <a class="button ghost" href="/contacto/#planes">Ver planes <span>↗</span></a>
    </div>

    <h2>Fuentes y referencias de {city}</h2>
    <ul>
      {fuentes.map((f) => (
        <li><a href={f.href} target="_blank" rel="noopener">{f.label}</a></li>
      ))}
    </ul>

    <section class="silo-related" aria-label="Municipios relacionados">
      <h2>También en la Sabana Occidental</h2>
      <ul>
        {relatedCities.map((c) => (
          <li><a href={`/${c.slug}/`}>{c.label}</a></li>
        ))}
        <li><a href="/guias/seo-local/">Guía completa de SEO local</a></li>
        <li><a href="/servicios/">Ver servicios y planes</a></li>
      </ul>
    </section>
  </section>

  <section class="section wrap">
    <p class="eyebrow">PREGUNTAS FRECUENTES</p>
    <h2>Dudas sobre <em>presencia web en {city}</em></h2>
    <FaqList faqs={faqs} />
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">EMPIEZA SIN RIESGO</p>
      <h2>Ve tu web gratis. <em>Decide después.</em></h2>
      <div class="actions">
        <a class="button light" href={DEMO_URL} target="_blank" rel="noopener">
          Pedir mi demo gratis <span>↗</span>
        </a>
        <a class="button ghost light-ghost" href="/contacto/#planes">Ver planes <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
