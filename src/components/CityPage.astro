---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import TrustStrip from './TrustStrip.astro';
import { ctaDiagnostico } from '../data/business';
import { localBusinessSchema } from '../components/schemas';
import { plans, cop } from '../data/service';

interface Props {
  city: string;
  slug: string;
  focus: string;
  sectors: string;
  highlight: string;
  landmarks: string;
  poblacion: string;
  areaKm2: string;
  fuenteDane: string;
  economia: string;
  zona: string;
  hitos: string[];
  sectoresUnicos: string[];
  casoTipo: string;
  faqLocal: { q: string; a: string };
  pasosLocales: string[];
  fuentes: { label: string; href: string }[];
}
const {
  city,
  slug,
  focus,
  sectors,
  highlight,
  landmarks,
  poblacion,
  areaKm2,
  fuenteDane,
  economia,
  zona,
  hitos,
  sectoresUnicos,
  casoTipo,
  faqLocal,
  pasosLocales,
  fuentes,
} = Astro.props;

const path = `/${slug}/`;
const title = `Presencia digital en ${city} | Presentto`;
const description = `Administramos la web, la ficha de Google y la presencia digital de negocios de ${city}. 4 planes desde $100.000 COP/mes, IVA incluido. Diagnóstico gratis.`;

const crumbs = [{ label: 'Inicio', href: '/' }, { label: city }];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Administración de presencia digital en ${city}`,
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: { '@type': 'Place', name: `${city}, Cundinamarca, Colombia` },
  serviceType: 'Administración web y presencia digital',
  offers: plans.map((plan) => ({
    '@type': 'Offer',
    name: plan.name,
    price: String(plan.monthly),
    priceCurrency: 'COP',
    description: `${plan.tagline} — IVA incluido`,
  })),
};

const faqs = [
  {
    q: `¿Cuánto cuesta la administración web en ${city}?`,
    a: `El plan Presencia cuesta $100.000 COP/mes con IVA incluido e incluye web administrada, ficha de Google, analítica y soporte. Crecimiento cuesta $299.000, Sistemas $640.000 y Empresa desde $1.450.000. También hay prepago anual con 15% de descuento.`,
  },
  {
    q: `¿Cómo hago visible mi negocio de ${city} en Google y Maps?`,
    a: `Con tres patas: una web clara con tus servicios y zona de cobertura; una ficha de Google verificada con categorías y datos coherentes; y reseñas reales y constantes. Nosotros administramos las dos primeras; las reseñas las decides tú.`,
  },
  {
    q: `¿Cuánto tarda en indexarse un sitio web en ${city}?`,
    a: `La indexación suele ocurrir en días o semanas tras publicar, con sitemap y Search Console. Posicionarse en búsquedas competitivas de ${city} toma meses de autoridad, contenido y reseñas. La entrega técnica es de pocos días hábiles.`,
  },
  faqLocal,
];

const relatedCities = [
  { slug: 'funza', label: 'Presencia digital en Funza' },
  { slug: 'mosquera', label: 'Presencia digital en Mosquera' },
  { slug: 'madrid', label: 'Presencia digital en Madrid' },
  { slug: 'facatativa', label: 'Presencia digital en Facatativá' },
].filter((c) => c.slug !== slug);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonld={[...(localBusinessSchema ? [localBusinessSchema] : []), schema]}
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow={`PRESENCIA DIGITAL · ${city.toUpperCase()}`}
    title={`Tu negocio en ${city}, <em>administrado y visible.</em>`}
    lead={`Web, ficha de Google, analítica y soporte en un solo servicio. Sin que tengas que aprender herramientas ni perseguir a un proveedor. Diagnóstico gratis y planes desde $100.000 COP/mes.`}
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
        Diagnóstico gratis <span>↗</span>
      </a>
      <a class="btn btn-ghost" href="/precios/">Ver precios <span>↓</span></a>
    </Fragment>
    <Fragment slot="meta">
      <span class="tag">{poblacion} habitantes</span>
      <span class="tag">{areaKm2} km²</span>
      <span class="tag">{city} · Cundinamarca</span>
      <span class="tag">Desde $100.000 COP/mes</span>
    </Fragment>
  </PageHero>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">POR QUÉ IMPORTA</p>
        <h2 data-split>Por qué <em>{city}</em> necesita presencia digital</h2>
      </div>
      <p class="lead">
        {poblacion} habitantes, {areaKm2} km² y un comercio que hoy busca en Google antes de salir a
        la calle: en {city} la presencia digital decide a quién llega el cliente.
      </p>
    </div>
    <div class="prose">
      <p class="snippet">
        Según el Censo Nacional de Población y Vivienda 2018 del DANE, {city} reúne {poblacion} habitantes
        sobre {areaKm2} km² de territorio (consulta la
        <a href={fuenteDane} target="_blank" rel="noopener">ficha municipal del DANE</a>). Cada una de esas
        personas que busca un producto o un servicio con la palabra “{city}” o con “cerca de mí” decide en
        segundos entre tu competencia local y los resultados de Bogotá que se cuelan por cercanía. Quien no
        aparece cede el cliente sin darse cuenta. Por eso tener una web y una ficha bien administradas aquí no es un extra: es la forma en que
        tu negocio se muestra en el mapa y cuando alguien busca lo que tú ofreces.
      </p>
      <p>{economia}</p>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">NEGOCIOS Y SERVICIOS</p>
        <h2 data-split>Presencia web para <em>{focus}</em></h2>
      </div>
      <p class="lead">
        Una web clara convierte esa actividad en llamadas y mensajes, en lugar de perderlos frente a
        otro municipio.
      </p>
    </div>
    <div class="prose">
      <p class="snippet">{sectors}.</p>
      <p>{highlight}</p>
      <p>{landmarks}</p>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">GEOGRAFÍA LOCAL</p>
        <h2 data-split>Hitos y zona de influencia de <em>{city}</em></h2>
      </div>
      <p class="lead">{zona}</p>
    </div>
    <div class="card-grid cols-3" data-stagger>
      {hitos.map((h) => (
        <article class="card reveal">
          <p>{h}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">BÚSQUEDAS POR GIRO</p>
        <h2 data-split>Sectores con búsquedas propias en <em>{city}</em></h2>
      </div>
      <p class="lead">
        El patrón de búsqueda cambia según el giro. Estos sectores necesitan una web propia en
        {city}, con ejemplos de lo que buscan sus clientes.
      </p>
    </div>
    <ul class="feature-list">
      {sectoresUnicos.map((s) => (
        <li>{s}</li>
      ))}
    </ul>
    <p>{casoTipo}</p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">QUÉ ADMINISTRAMOS</p>
        <h2 data-split>Tu presencia en <em>{city}</em>, operada.</h2>
      </div>
      <p class="lead">
        Web existente o nueva, ficha de Google, analítica y cambios. Todo con un solo interlocutor.
      </p>
    </div>
    <ul class="feature-list">
      <li>Web administrada: hosting, dominio o subdominio, SSL, backups y monitoreo.</li>
      <li>Web nueva base si no tienes, con tu contenido y tu identidad.</li>
      <li>Correo profesional y datos coherentes en toda la presencia digital.</li>
      <li>Ficha de Google: categorías, horarios, fotos y servicios de {city}.</li>
      <li>Analítica instalada: GA4, Search Console y Clarity.</li>
      <li>Cambios de contenido mensuales y soporte con SLA.</li>
    </ul>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">PRECIOS</p>
        <h2 data-split>¿Cuánto cuesta en <em>{city}</em>?</h2>
      </div>
      <p class="lead">
        Cuatro planes con IVA incluido. Prepago mensual o anual con 15% de descuento.
      </p>
    </div>
    <div class="table-scroll reveal">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col">Plan</th>
            <th scope="col">Inversión mensual</th>
            <th scope="col">Ideal para</th>
          </tr>
        </thead>
        <tbody>
          {plans.map((plan) => (
            <tr>
              <td><strong>{plan.name}</strong></td>
              <td>{plan.fromPrice ? 'Desde ' : ''}{cop(plan.monthly)} COP</td>
              <td>{plan.forWho}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="stack-note">
      ¿Quieres comparar? Ver <a href="/precios/">todos los planes</a> o
      <a href="/comparativas/">comparativas de opciones</a>.
    </p>
  </section>

  <TrustStrip />

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">PROCESO</p>
        <h2 data-split>Cómo trabajamos en <em>{city}</em></h2>
      </div>
      <p class="lead">
        Diagnóstico, plan de 30 días, implementación e inducción. El mismo proceso para todos los
        clientes.
      </p>
    </div>
    <div class="prose">
      <ol>
        <li>Entendemos cómo busca tu cliente en {city} y municipios vecinos.</li>
        {pasosLocales.map((p) => (
          <li>{p}</li>
        ))}
        <li>Revisión de visitas, reporte y ajuste continuo durante el plan.</li>
      </ol>
    </div>
    <div class="guide-cta">
      <p><strong>¿Quieres saber qué le falta a tu presencia en {city}?</strong></p>
      <div class="actions">
        <a class="btn btn-primary" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
          Pedir diagnóstico gratis <span>↗</span>
        </a>
        <a class="btn btn-ghost btn-sm" href="/precios/">Ver planes <span>↓</span></a>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">FUENTES</p>
        <h2 data-split>Fuentes y referencias de <em>{city}</em></h2>
      </div>
    </div>
    <div class="prose">
      <ul>
        {fuentes.map((f) => (
          <li><a href={f.href} target="_blank" rel="noopener">{f.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head center">
      <p class="eyebrow">SABANA OCCIDENTAL</p>
      <h2 data-split>También en la Sabana Occidental</h2>
      <p class="lead">
        Mismos servicios en los municipios vecinos y recursos para decidir con información.
      </p>
    </div>
    <div class="tag-row">
      {relatedCities.map((c) => (
        <a class="tag" href={`/${c.slug}/`}>{c.label}</a>
      ))}
      <a class="tag" href="/guias/que-es-presencia-digital/">Guía de presencia digital</a>
      <a class="tag" href="/servicios/">Ver servicios y planes</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">PREGUNTAS FRECUENTES</p>
        <h2 data-split>Dudas sobre <em>presencia digital en {city}</em></h2>
      </div>
      <p class="lead">
        Precios, ficha de Google e indexación. Si tu caso es especial, lo vemos en el diagnóstico.
      </p>
    </div>
    <FaqList faqs={faqs} />
  </section>

  <FinalCta
    eyebrow="EMPIEZA SIN RIESGO"
    title={`Primero revisamos tu presencia en ${city}. <em>Después decides.</em>`}
    note="Diagnóstico de 20 min · Sin compromiso · Presupuesto claro antes de pagar"
  />
</BaseLayout>
