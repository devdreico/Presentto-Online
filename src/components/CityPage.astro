---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';

interface Props {
  city: string;
  slug: string;
  focus: string;
  sectors: string;
  highlight: string;
  landmarks: string;
}
const {
  city,
  slug,
  focus,
  sectors,
  highlight,
  landmarks,
} = Astro.props;

const path = `/${slug}/`;
const title = `SEO local y posicionamiento en Google en ${city} | Presentto`;
const description = `Web con SEO local y posicionamiento en Google en ${city} desde $40.000 COP/mes: schema, ficha de Google, dominio y correo. Demo gratis.`;
const DEMO_URL = `https://wa.me/573236487336?text=${encodeURIComponent(
  `Hola Presentto, quiero solicitar una demo web gratis de mi negocio en ${city}`
)}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Páginas web con SEO local y posicionamiento en ${city}`,
  provider: { '@id': 'https://www.presentto.online/#organization' },
  areaServed: { '@type': 'Place', name: `${city}, Cundinamarca, Colombia` },
  serviceType: 'Diseño web, SEO on-page y posicionamiento local',
  offers: {
    '@type': 'Offer',
    price: '40000',
    priceCurrency: 'COP',
    description: 'Presenttación Digital — IVA incluido',
  },
};

const faqs = [
  {
    q: `¿Cuánto cuesta una página web con SEO local en ${city}?`,
    a: `En Presentto la Presenttación Digital cuesta desde $40.000 COP/mes (IVA incluido; prepago de 1, 3, 6 meses o 1 año) e incluye diseño, dominio propio, correo profesional, SEO on-page y SEO local orientado a ${city} y la Sabana Occidental. Antes de pagar puedes pedir una demo gratis de tu negocio.`,
  },
  {
    q: `¿Cómo posiciono mi negocio de ${city} en Google y en el pack de Maps?`,
    a: `Con las tres patas del SEO local: (1) web optimizada con metas, schema LocalBusiness y contenido municipal; (2) Google Business Profile con categorías, fotos y NAP coherente (Nombre, Dirección, Teléfono); (3) reseñas reales y constantes. Nosotros preparamos 1 y 2; la constancia en reseñas la decides tú. No prometemos ranking garantizado.`,
  },
  {
    q: `¿Cuánto tarda en indexarse y posicionarse un sitio web en ${city}?`,
    a: `La indexación (aparecer en el rastreador de Google) suele ocurrir en días o semanas tras publicar, con sitemap y Search Console. El posicionamiento orgánico en búsquedas competitivas de ${city} toma meses de autoridad, contenido y reseñas. Tras tu aprobación de la demo, la entrega técnica es de pocos días hábiles.`,
  },
];

const relatedCities = [
  { slug: 'funza', label: 'Páginas web en Funza' },
  { slug: 'mosquera', label: 'Páginas web en Mosquera' },
  { slug: 'madrid', label: 'Páginas web en Madrid' },
  { slug: 'facatativa', label: 'Páginas web en Facatativá' },
].filter((c) => c.slug !== slug);
---

<BaseLayout title={title} description={description} path={path} jsonld={[schema]}>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: city }]} />

  <section class="section wrap page-hero">
    <p class="eyebrow">SEO LOCAL · POSICIONAMIENTO · {city.toUpperCase()}</p>
    <h1>Tu negocio en {city}, <em>posicionado en Google.</em></h1>
    <p class="lead">
      Presentamos tu negocio online con SEO on-page, datos estructurados y contenido geolocalizado para
      aparecer en búsquedas locales de {city}, en el pack de Google Maps y en “cerca de mí”. Primero la ves
      gratis; pagas solo si te gusta.
    </p>
    <div class="actions">
      <a class="button primary" href={DEMO_URL} target="_blank" rel="noopener">
        Pedir mi demo gratis <span>↗</span>
      </a>
      <a class="button ghost" href="/servicios/">Ver servicio <span>↓</span></a>
    </div>
  </section>

  <section class="section wrap guide-layout">
    <h2>Visibilidad orgánica para {focus}</h2>
    <p class="snippet">
      {city} concentra {sectors}. Una página web rápida, indexable y optimizada para SEO local ayuda a que
      esos negocios aparezcan en los resultados orgánicos de Google, en el pack local de Maps y cuando el
      cliente busca “cerca de mí” o “en {city}” con intención de compra.
    </p>
    <p>
      {highlight}
    </p>
    <p>
      {landmarks} Trabajamos con la identidad real de tu empresa: tus fotos, tus servicios y la forma en que
      atiendes a tus clientes. La arquitectura del sitio (URLs limpias, enlaces internos, jerarquía de
      encabezados) queda lista para que Google rastree e indexe sin fricción.
    </p>

    <h2>Qué incluye la web con SEO local para {city}</h2>
    <ul>
      <li>Diseño personalizado alineado con tu marca y con {focus}.</li>
      <li>Dominio propio y correo profesional (por ejemplo, <strong>tuempresa.online</strong>).</li>
      <li>SEO on-page: meta títulos, meta descripciones, H1–H3, enlaces internos y URL limpias.</li>
      <li>Datos estructurados schema LocalBusiness/Service para rich results locales.</li>
      <li>Contenido geolocalizado y palabras clave de cola larga de {city}.</li>
      <li>Orientación de Google Business Profile: categorías, fotos y coherencia NAP.</li>
      <li>Velocidad y Core Web Vitals para móvil (factor de ranking y conversión).</li>
      <li>Sitemap XML y robots.txt listos para el rastreo de Google.</li>
      <li>Códigos QR para llevar tráfico del punto de venta a tu web.</li>
      <li>Administración del hosting por Presentto y ajustes durante el plan.</li>
    </ul>

    <h2>¿Cuánto cuesta una página web con SEO en {city}?</h2>
    <p class="snippet">
      La Presenttación Digital de Presentto cuesta desde $40.000 COP/mes, IVA incluido: creación, dominio,
      correo, SEO on-page, SEO local, schema y administración incluidos. Prepago de 1, 3, 6 meses o 1 año,
      sin permanencia. Pide tu demo gratis antes de decidir.
    </p>
    <table class="compare-table">
      <thead>
        <tr><th>Opción</th><th>Inversión típica</th><th>Ideal para</th></tr>
      </thead>
      <tbody>
        <tr><td>Presentto ({city}) — 1 mes</td><td>$40.000 COP (IVA incl.)</td><td>Negocios locales que quieren posicionar ya</td></tr>
        <tr><td>Presentto ({city}) — 1 año</td><td>$350.000 COP (IVA incl.)</td><td>Quien busca el mejor coste por mes</td></tr>
        <tr><td>Agencia web + SEO local</td><td>$800.000 – $3.000.000 COP + mant.</td><td>Proyectos grandes con CMS y blog</td></tr>
        <tr><td>Plantilla DIY (Wix, etc.)</td><td>Desde ~20 USD/mes</td><td>Quien quiere hacer SEO y web solo</td></tr>
      </tbody>
    </table>

    <h2>Cómo trabajamos el posicionamiento SEO en {city}</h2>
    <ol>
      <li>Keyword research local: búsquedas reales con intención en {city} y municipios vecinos.</li>
      <li>SEO on-page: arquitectura de contenidos, enlaces internos y metas por URL.</li>
      <li>SEO técnico: schema LocalBusiness/Service, sitemap, velocidad y indexación.</li>
      <li>SEO local: ficha de Google, NAP, categorías y orientación de reseñas.</li>
      <li>Medición en Google Search Console y ajuste continuo según tráfico orgánico.</li>
    </ol>

    <div class="guide-cta">
      <p><strong>¿Quieres posicionar tu negocio en {city}?</strong></p>
      <a class="button primary" href={DEMO_URL} target="_blank" rel="noopener">
        Pedir mi demo gratis <span>↗</span>
      </a>
      &nbsp;
      <a class="button ghost" href="/contacto/#planes">Ver planes <span>↗</span></a>
    </div>

    <section class="silo-related" aria-label="Municipios relacionados">
      <h2>También en la Sabana Occidental</h2>
      <ul>
        {relatedCities.map((c) => (
          <li><a href={`/${c.slug}/`}>{c.label}</a></li>
        ))}
        <li><a href="/guias/seo-local/">Guía completa de SEO local</a></li>
        <li><a href="/servicios/">Ver servicios y planes</a></li>
      </ul>
    </section>
  </section>

  <section class="section wrap">
    <p class="eyebrow">PREGUNTAS FRECUENTES</p>
    <h2>Dudas sobre <em>presencia web en {city}</em></h2>
    <FaqList faqs={faqs} />
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">EMPIEZA SIN RIESGO</p>
      <h2>Ve tu web gratis. <em>Decide después.</em></h2>
      <div class="actions">
        <a class="button light" href={DEMO_URL} target="_blank" rel="noopener">
          Pedir mi demo gratis <span>↗</span>
        </a>
        <a class="button ghost light-ghost" href="/contacto/#planes">Ver planes <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
