---
interface Props {
  className?: string;
}
const { className = '' } = Astro.props;
---

<div class:list={['mvo-constellation-wrap', className]} aria-hidden="true">
  <div class="constellation-poster">
    <div class="node-root">presentto.online</div>
    <div class="node-satellites">
      <span>negocio-a.presentto.online</span>
      <span>negocio-b.presentto.online</span>
      <span>negocio-c.presentto.online</span>
    </div>
  </div>
  <canvas id="mvoCanvas" class="mvo-canvas" data-three-canvas></canvas>
</div>

<style>
  .mvo-constellation-wrap {
    position: relative;
    width: 100%;
    height: 380px;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(248, 225, 211, .5), rgba(245, 239, 229, .9));
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .constellation-poster {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px;
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--muted);
    opacity: 0.8;
  }
  .node-root {
    background: var(--orange);
    color: #fff;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    font-weight: bold;
    box-shadow: var(--shadow-sm);
  }
  .node-satellites {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .node-satellites span {
    background: var(--glass-solid);
    border: 1px solid var(--line);
    padding: 6px 12px;
    border-radius: var(--r-sm);
    font-size: 0.75rem;
  }
  .mvo-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }
</style>

<script>
  import * as THREE from 'three';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const canvas = document.getElementById('mvoCanvas') as HTMLCanvasElement;
    if (canvas) {
      const parent = canvas.parentElement;
      const width = parent ? parent.clientWidth : 400;
      const height = parent ? parent.clientHeight : 380;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
      camera.position.z = 6;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
      scene.add(ambientLight);
      const pointLight = new THREE.PointLight(0xf15a24, 2, 50);
      pointLight.position.set(2, 3, 4);
      scene.add(pointLight);

      // Central node (Presentto)
      const coreGeo = new THREE.SphereGeometry(0.7, 32, 32);
      const coreMat = new THREE.MeshStandardMaterial({ color: 0xf15a24, roughness: 0.3, metalness: 0.1 });
      const core = new THREE.Mesh(coreGeo, coreMat);
      scene.add(core);

      // Orbiting nodes (Subdomains)
      const satCount = 4;
      const satellites: THREE.Mesh[] = [];
      const satMat = new THREE.MeshStandardMaterial({ color: 0x20201e, roughness: 0.8 });
      const satGeo = new THREE.BoxGeometry(0.35, 0.35, 0.35);

      for (let i = 0; i < satCount; i++) {
        const sat = new THREE.Mesh(satGeo, satMat);
        scene.add(sat);
        satellites.push(sat);
      }

      let clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        const elapsedTime = clock.getElapsedTime();

        core.rotation.y = elapsedTime * 0.3;

        satellites.forEach((sat, index) => {
          const angle = elapsedTime * 0.6 + (index * (Math.PI * 2)) / satCount;
          const radius = 2.2;
          sat.position.x = Math.cos(angle) * radius;
          sat.position.z = Math.sin(angle) * radius;
          sat.position.y = Math.sin(elapsedTime + index) * 0.3;
          sat.rotation.x += 0.01;
          sat.rotation.y += 0.02;
        });

        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        if (!parent) return;
        const w = parent.clientWidth;
        const h = parent.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });
    }
  }
</script>
