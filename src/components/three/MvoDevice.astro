---
interface Props {
  label?: string;
}
const { label = 'Demostración interactiva: un sitio web distinto por rubro dentro de un iPhone 16' } =
  Astro.props;
---

<div class="mvo-device" data-mvo-device>
  <div class="device-poster" aria-hidden="true">
    <div class="poster-phone">
      <span class="poster-island"></span>
      <div class="poster-screen">
        <span class="poster-nav"></span>
        <span class="poster-hero"></span>
        <span class="poster-row"><i></i><i></i></span>
        <span class="poster-line w80"></span>
        <span class="poster-line w60"></span>
        <span class="poster-cta"></span>
      </div>
    </div>
  </div>
  <canvas data-device-canvas aria-label={label} role="img"></canvas>
</div>

<script>
  let dispose: (() => void) | null = null;

  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  async function boot(wrapper: HTMLElement) {
    if (wrapper.dataset.deviceReady) return;
    wrapper.dataset.deviceReady = '1';

    const THREE = await import('three');
    const { RoundedBoxGeometry } = await import('three/addons/geometries/RoundedBoxGeometry.js');
    const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');

    // RoundedBoxGeometry limita el radio a la mitad de la dimensión menor,
    // así que el cuerpo y el frente se extruyen desde una Shape explícita.
    function roundedRectShape(w: number, h: number, r: number) {
      const s = new THREE.Shape();
      const x = -w / 2;
      const y = -h / 2;
      s.moveTo(x + r, y);
      s.lineTo(x + w - r, y);
      s.absarc(x + w - r, y + r, r, -Math.PI / 2, 0, false);
      s.lineTo(x + w, y + h - r);
      s.absarc(x + w - r, y + h - r, r, 0, Math.PI / 2, false);
      s.lineTo(x + r, y + h);
      s.absarc(x + r, y + h - r, r, Math.PI / 2, Math.PI, false);
      s.lineTo(x, y + r);
      s.absarc(x + r, y + r, r, Math.PI, Math.PI * 1.5, false);
      return s;
    }

    const canvas = wrapper.querySelector<HTMLCanvasElement>('canvas');
    if (!canvas) return;

    const gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
    if (!gl) return; // sin WebGL: queda el póster

    /* ---------------- Paletas: un "sitio web" distinto por rubro -------- */
    type Palette = {
      bg: string;
      surface: string;
      primary: string;
      accent: string;
      text: string;
      muted: string;
      glow: number;
    };
    const SITES: Palette[] = [
      { bg: '#17130f', surface: '#241d17', primary: '#e2703a', accent: '#f5c173', text: '#f8f0e6', muted: '#a8977f', glow: 0xe2703a },
      { bg: '#eef5fb', surface: '#ffffff', primary: '#2f81f7', accent: '#3ec7b4', text: '#132029', muted: '#5d7080', glow: 0x2f81f7 },
      { bg: '#121416', surface: '#1d2124', primary: '#f0a53c', accent: '#e5623c', text: '#f2f4f5', muted: '#8b949b', glow: 0xf0a53c },
      { bg: '#f6f3fb', surface: '#ffffff', primary: '#7c5cf0', accent: '#ff7ab6', text: '#1c1730', muted: '#6d6690', glow: 0x9a6cf5 },
      { bg: '#131313', surface: '#1f1f1f', primary: '#d8412f', accent: '#ffb020', text: '#f5f5f5', muted: '#9a9a9a', glow: 0xd8412f },
    ];

    const W = 540;
    const H = 1130;
    const CH = Math.round(H * 1.55); // altura del contenido "web" para el scroll

    /* ---------------- Sitio dibujado en canvas 2D ----------------------- */
    const siteCanvas = document.createElement('canvas');
    siteCanvas.width = W;
    siteCanvas.height = CH;
    const s = siteCanvas.getContext('2d')!;

    const rr = (ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) => {
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, r);
      ctx.closePath();
      ctx.fill();
    };

    function drawSite(p: Palette) {
      s.fillStyle = p.bg;
      s.fillRect(0, 0, W, CH);

      // Nav superior
      s.fillStyle = p.surface;
      rr(s, 18, 44, W - 36, 74, 22);
      s.fillStyle = p.primary;
      s.beginPath();
      s.arc(62, 81, 20, 0, Math.PI * 2);
      s.fill();
      s.fillStyle = p.muted;
      rr(s, 96, 72, 120, 10, 5);
      rr(s, 96, 90, 80, 8, 4);
      s.fillStyle = p.accent;
      rr(s, W - 96, 66, 62, 30, 15);

      // Hero del "sitio"
      const grad = s.createLinearGradient(18, 140, W - 18, 420);
      grad.addColorStop(0, p.primary);
      grad.addColorStop(1, p.accent);
      s.fillStyle = grad;
      rr(s, 18, 146, W - 36, 300, 30);
      s.fillStyle = 'rgba(255,255,255,.94)';
      rr(s, 52, 196, 300, 26, 13);
      rr(s, 52, 236, 236, 26, 13);
      s.fillStyle = 'rgba(255,255,255,.6)';
      rr(s, 52, 286, 200, 12, 6);
      rr(s, 52, 308, 160, 12, 6);
      s.fillStyle = 'rgba(255,255,255,.95)';
      rr(s, 52, 348, 150, 44, 22);
      s.fillStyle = p.primary;
      rr(s, 74, 366, 80, 10, 5);

      // Etiqueta de sección
      s.fillStyle = p.muted;
      rr(s, 18, 478, 140, 12, 6);
      rr(s, 18, 502, 90, 10, 5);

      // Cards
      const cards: Array<[number, number]> = [
        [18, 534],
        [W / 2 + 3, 534],
      ];
      cards.forEach(([x, y], i) => {
        s.fillStyle = p.surface;
        rr(s, x, y, W / 2 - 21, 240, 24);
        s.fillStyle = i === 0 ? p.accent : p.primary;
        s.globalAlpha = 0.28;
        rr(s, x + 14, y + 14, W / 2 - 49, 120, 16);
        s.globalAlpha = 1;
        s.fillStyle = p.text;
        s.globalAlpha = 0.85;
        rr(s, x + 14, y + 154, W / 2 - 70, 14, 7);
        s.globalAlpha = 0.4;
        rr(s, x + 14, y + 180, W / 2 - 90, 10, 5);
        rr(s, x + 14, y + 198, W / 2 - 110, 10, 5);
        s.globalAlpha = 1;
        s.fillStyle = i === 0 ? p.primary : p.accent;
        rr(s, x + 14, y + 214, 74, 24, 12);
      });

      // Bloque ancho
      s.fillStyle = p.surface;
      rr(s, 18, 796, W - 36, 170, 24);
      s.fillStyle = p.primary;
      rr(s, 40, 826, 120, 14, 7);
      s.fillStyle = p.muted;
      rr(s, 40, 856, W - 130, 10, 5);
      rr(s, 40, 876, W - 170, 10, 5);
      rr(s, 40, 896, W - 210, 10, 5);
      s.fillStyle = p.accent;
      rr(s, 40, 922, 110, 30, 15);

      // Líneas de texto + footer
      s.fillStyle = p.text;
      s.globalAlpha = 0.5;
      rr(s, 18, 996, W - 60, 12, 6);
      rr(s, 18, 1020, W - 140, 12, 6);
      rr(s, 18, 1044, W - 220, 12, 6);
      s.globalAlpha = 1;
      s.fillStyle = p.surface;
      rr(s, 0, 1084, W, CH - 1084, 0);
      s.fillStyle = p.muted;
      rr(s, 18, 1112, 160, 10, 5);
      rr(s, W - 120, 1112, 100, 10, 5);

      // Segunda pasada: repetir cabecera al final para el loop de scroll
      s.fillStyle = p.bg;
      s.fillRect(0, 1160, W, CH - 1160);
      s.fillStyle = p.surface;
      rr(s, 18, 1184, W - 36, 74, 22);
      s.fillStyle = p.primary;
      s.beginPath();
      s.arc(62, 1221, 20, 0, Math.PI * 2);
      s.fill();
      s.fillStyle = p.muted;
      rr(s, 96, 1212, 120, 10, 5);
      s.fillStyle = p.accent;
      rr(s, W - 96, 1206, 62, 30, 15);
      s.fillStyle = p.primary;
      rr(s, 18, 1290, W - 36, 260, 30);
      s.fillStyle = 'rgba(255,255,255,.92)';
      rr(s, 52, 1340, 280, 24, 12);
      rr(s, 52, 1378, 210, 24, 12);
    }

    const siteCache = new Map<number, HTMLCanvasElement>();
    function getSite(i: number): HTMLCanvasElement {
      let c = siteCache.get(i);
      if (!c) {
        drawSite(SITES[i % SITES.length]);
        c = document.createElement('canvas');
        c.width = W;
        c.height = CH;
        c.getContext('2d')!.drawImage(siteCanvas, 0, 0);
        siteCache.set(i, c);
      }
      return c;
    }

    /* ---------------- Textura de pantalla + isla dinámica ---------------- */
    const screen = document.createElement('canvas');
    screen.width = W;
    screen.height = H;
    const sc = screen.getContext('2d')!;
    const tex = new THREE.CanvasTexture(screen);
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.anisotropy = 4;

    // Esquinas redondeadas del contenido: 540 px ≈ 74.2 px/unidad,
    // BODY_R (1.35) - 0.31 ≈ 1.04 unidades ≈ 78 px.
    const clipScreen = () => {
      sc.save();
      sc.beginPath();
      sc.roundRect(0, 0, W, H, 78);
      sc.clip();
    };
    const unclipScreen = () => {
      sc.restore();
    };

    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    type IslandState = { w: number; h: number; mode: 'none' | 'msg' | 'media' };
    const ISLAND: IslandState[] = [
      { w: 118, h: 36, mode: 'none' },
      { w: 118, h: 36, mode: 'none' },
      { w: 236, h: 64, mode: 'msg' },
      { w: 236, h: 64, mode: 'msg' },
      { w: 268, h: 72, mode: 'media' },
      { w: 268, h: 72, mode: 'media' },
      { w: 118, h: 36, mode: 'none' },
    ];
    const ISLAND_STOPS = [0, 0.14, 0.3, 0.46, 0.6, 0.76, 1];

    function islandAt(t: number): IslandState {
      let i = 0;
      while (i < ISLAND_STOPS.length - 2 && t > ISLAND_STOPS[i + 1]) i++;
      const a = ISLAND[i];
      const b = ISLAND[i + 1];
      const span = ISLAND_STOPS[i + 1] - ISLAND_STOPS[i] || 1;
      const k = ease(Math.min(Math.max((t - ISLAND_STOPS[i]) / span, 0), 1));
      const mode = k > 0.5 ? b.mode : a.mode;
      return { w: a.w + (b.w - a.w) * k, h: a.h + (b.h - a.h) * k, mode };
    }

    function drawIsland(t: number, p: Palette) {
      const st = islandAt(t);
      const x = W / 2 - st.w / 2;
      const y = 34;
      sc.fillStyle = '#000';
      rr(sc, x, y, st.w, st.h, st.h / 2);

      if (st.mode !== 'none') {
        const pad = st.h / 2;
        if (st.mode === 'msg') {
          sc.fillStyle = p.accent;
          sc.beginPath();
          sc.arc(x + pad + 6, y + st.h / 2, 13, 0, Math.PI * 2);
          sc.fill();
          sc.fillStyle = 'rgba(255,255,255,.92)';
          rr(sc, x + pad + 28, y + st.h / 2 - 12, st.w - pad * 2 - 42, 9, 4.5);
          sc.fillStyle = 'rgba(255,255,255,.45)';
          rr(sc, x + pad + 28, y + st.h / 2 + 3, st.w - pad * 2 - 70, 8, 4);
        } else {
          sc.fillStyle = '#fff';
          sc.beginPath();
          sc.moveTo(x + pad, y + st.h / 2 - 11);
          sc.lineTo(x + pad + 18, y + st.h / 2);
          sc.lineTo(x + pad, y + st.h / 2 + 11);
          sc.closePath();
          sc.fill();
          const bars = 7;
          const bw = (st.w - pad * 2 - 44) / bars;
          sc.fillStyle = p.accent;
          for (let i = 0; i < bars; i++) {
            const hgt = 8 + Math.abs(Math.sin(t * 40 + i * 1.3)) * 22;
            rr(sc, x + pad + 30 + i * bw, y + st.h / 2 - hgt / 2, bw * 0.55, hgt, 3);
          }
        }
      }
    }

    function drawStatusBar(p: Palette) {
      sc.fillStyle = p.text;
      sc.globalAlpha = 0.9;
      sc.font = '700 26px Montserrat, Arial, sans-serif';
      sc.textBaseline = 'middle';
      sc.fillText('9:41', 44, 52);
      // batería / señal simplificadas
      rr(sc, W - 118, 44, 40, 20, 6);
      rr(sc, W - 66, 44, 34, 20, 6);
      sc.globalAlpha = 1;
    }

    /* ---------------- Escena three.js ------------------------------------ */
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const pmrem = new THREE.PMREMGenerator(renderer);
    const envTex = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    scene.environment = envTex;

    const camera = new THREE.PerspectiveCamera(26, 1, 0.1, 120);
    camera.position.set(0, 0, 38);

    scene.add(new THREE.AmbientLight(0xffffff, 0.55));
    const key = new THREE.DirectionalLight(0xffffff, 2.1);
    key.position.set(6, 10, 12);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xffb98a, 1.4);
    rim.position.set(-8, -4, -6);
    scene.add(rim);

    // Aura tras el teléfono (cambia con la paleta)
    const auraCanvas = document.createElement('canvas');
    auraCanvas.width = auraCanvas.height = 256;
    const ac = auraCanvas.getContext('2d')!;
    const auraGrad = ac.createRadialGradient(128, 128, 10, 128, 128, 128);
    auraGrad.addColorStop(0, 'rgba(255,255,255,.95)');
    auraGrad.addColorStop(0.45, 'rgba(255,255,255,.35)');
    auraGrad.addColorStop(1, 'rgba(255,255,255,0)');
    ac.fillStyle = auraGrad;
    ac.fillRect(0, 0, 256, 256);
    const auraTex = new THREE.CanvasTexture(auraCanvas);
    const auraMat = new THREE.SpriteMaterial({
      map: auraTex,
      color: new THREE.Color(SITES[0].glow),
      transparent: true,
      opacity: 0.5,
      depthWrite: false,
    });
    const aura = new THREE.Sprite(auraMat);
    aura.scale.set(34, 40, 1);
    aura.position.set(0, 0, -6);
    scene.add(aura);

    // Cuerpo iPhone 16
    const phone = new THREE.Group();
    const BW = 7.9;
    const BH = 16.1;
    const BD = 0.92;

    const BODY_R = 1.35; // iPhone-like: ~17% del ancho
    const BEVEL = 0.06;
    const bodyGeo = new THREE.ExtrudeGeometry(roundedRectShape(BW, BH, BODY_R), {
      depth: BD - BEVEL * 2,
      bevelEnabled: true,
      bevelThickness: BEVEL,
      bevelSize: BEVEL,
      bevelSegments: 5,
      curveSegments: 20,
    });
    bodyGeo.center();
    const bodyMat = new THREE.MeshPhysicalMaterial({
      color: 0x35353a,
      metalness: 1,
      roughness: 0.3,
      envMapIntensity: 1.4,
    });
    const body = new THREE.Mesh(bodyGeo, bodyMat);
    phone.add(body);

    // Frente "vidrio" negro (marco + pantalla)
    const FACE_R = 1.28;
    const faceGeo = new THREE.ExtrudeGeometry(roundedRectShape(BW - 0.12, BH - 0.12, FACE_R), {
      depth: 0.04,
      bevelEnabled: true,
      bevelThickness: 0.02,
      bevelSize: 0.02,
      bevelSegments: 3,
      curveSegments: 20,
    });
    faceGeo.center();
    const faceMat = new THREE.MeshPhysicalMaterial({
      color: 0x050505,
      metalness: 0.2,
      roughness: 0.18,
      clearcoat: 1,
      clearcoatRoughness: 0.12,
    });
    const face = new THREE.Mesh(faceGeo, faceMat);
    face.position.z = BD / 2;
    phone.add(face);

    const screenGeo = new THREE.PlaneGeometry(BW - 0.62, BH - 0.62);
    const screenMat = new THREE.MeshBasicMaterial({ map: tex, transparent: true });
    const screenMesh = new THREE.Mesh(screenGeo, screenMat);
    screenMesh.position.z = BD / 2 + 0.05;
    phone.add(screenMesh);

    // Botones laterales
    const btnMat = new THREE.MeshPhysicalMaterial({
      color: 0x2c2c30,
      metalness: 1,
      roughness: 0.35,
    });
    const sideBtn = (w: number, h: number, x: number, y: number) => {
      const g = new RoundedBoxGeometry(w, h, BD * 0.6, 3, 0.14);
      const m = new THREE.Mesh(g, btnMat);
      m.position.set(x, y, 0);
      phone.add(m);
    };
    sideBtn(0.14, 1.5, BW / 2 + 0.02, 2.2); // power
    sideBtn(0.14, 1.1, -BW / 2 - 0.02, 3.4); // vol up
    sideBtn(0.14, 1.1, -BW / 2 - 0.02, 2.1); // vol down
    sideBtn(0.14, 0.7, -BW / 2 - 0.02, 4.6); // action

    scene.add(phone);

    /* ---------------- Loop ---------------------------------------------- */
    let raf = 0;
    let running = true;
    let inView = true;
    let last = performance.now();
    let acc = 0;
    let scroll = 0;
    let siteIdx = 0;
    let phase = 0; // 0..1 dentro del ciclo de sitio
    const CYCLE = 5.2;
    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };

    const onPointer = (e: PointerEvent) => {
      const r = wrapper.getBoundingClientRect();
      pointer.tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      pointer.ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
    };
    wrapper.addEventListener('pointermove', onPointer);

    function resize() {
      const w = wrapper.clientWidth;
      const h = wrapper.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    const ro = new ResizeObserver(resize);
    ro.observe(wrapper);
    resize();

    const tmpColor = new THREE.Color();

    function frame(now: number) {
      if (!running) return;
      raf = requestAnimationFrame(frame);
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      acc += dt;

      // Textura a ~30 fps
      if (acc > 1 / 30) {
        acc = 0;
        phase = (phase + dt / CYCLE) % 1;
        const nextIdx = Math.floor(performance.now() / 1000 / CYCLE) % SITES.length;
        const p = SITES[siteIdx % SITES.length];
        const pn = SITES[nextIdx % SITES.length];
        scroll += 62 * dt; // px/s de scroll del "sitio"

        sc.clearRect(0, 0, W, H);
        clipScreen();
        sc.fillStyle = p.bg;
        sc.fillRect(0, 0, W, H);

        const off = scroll % CH;
        const site = getSite(siteIdx);
        sc.drawImage(site, 0, -off);
        sc.drawImage(site, 0, CH - off);

        // Crossfade al siguiente sitio en el primer 18% del ciclo
        if (phase < 0.18) {
          const k = ease(phase / 0.18);
          sc.globalAlpha = k;
          const next = getSite(nextIdx);
          sc.drawImage(next, 0, -off);
          sc.drawImage(next, 0, CH - off);
          sc.globalAlpha = 1;
        }

        drawStatusBar(p);
        drawIsland(phase, p);

        // Aro inferior (home indicator)
        sc.fillStyle = 'rgba(255,255,255,.55)';
        rr(sc, W / 2 - 80, H - 34, 160, 10, 5);

        unclipScreen();
        tex.needsUpdate = true;

        if (nextIdx !== siteIdx && phase < 0.18) {
          // al terminar el crossfade, comprometemos el índice
        }
        if (phase >= 0.99 || phase < 0.01) siteIdx = nextIdx;

        // Aura cambia de color con la paleta
        tmpColor.setHex(pn.glow).lerp(new THREE.Color(p.glow), phase < 0.5 ? 1 : 0);
        auraMat.color.copy(tmpColor);
        auraMat.opacity = 0.42 + Math.sin(now * 0.0012) * 0.08;
      }

      // Flotación + parallax
      pointer.x += (pointer.tx - pointer.x) * 0.06;
      pointer.y += (pointer.ty - pointer.y) * 0.06;
      const t = now * 0.001;
      phone.position.y = Math.sin(t * 0.9) * 0.35;
      phone.rotation.y = Math.sin(t * 0.45) * 0.16 + pointer.x * 0.32;
      phone.rotation.x = Math.sin(t * 0.6) * 0.05 - pointer.y * 0.18;
      phone.rotation.z = Math.sin(t * 0.35) * 0.02;

      renderer.render(scene, camera);
    }

    wrapper.classList.add('is-3d');
    if (reduced()) {
      // Render estático único
      phone.rotation.y = -0.18;
      const p0 = SITES[0];
      clipScreen();
      sc.clearRect(0, 0, W, H);
      sc.fillStyle = p0.bg;
      sc.fillRect(0, 0, W, H);
      drawStatusBar(p0);
      drawIsland(0, p0);
      sc.drawImage(getSite(0), 0, 0, W, H, 0, 0, W, H);
      unclipScreen();
      tex.needsUpdate = true;
      renderer.render(scene, camera);
    } else {
      raf = requestAnimationFrame(frame);
    }

    const onVisibility = () => {
      if (document.hidden) {
        running = false;
        cancelAnimationFrame(raf);
      } else if (!reduced() && inView && !running) {
        running = true;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    };
    document.addEventListener('visibilitychange', onVisibility);

    // Pausa el loop cuando el dispositivo queda fuera de pantalla
    const ioPause = new IntersectionObserver(
      (entries) => {
        const visible = entries.some((en) => en.isIntersecting);
        inView = visible;
        if (!visible) {
          if (running) {
            running = false;
            cancelAnimationFrame(raf);
          }
        } else if (!running && !reduced() && !document.hidden) {
          running = true;
          last = performance.now();
          raf = requestAnimationFrame(frame);
        }
      },
      { threshold: 0 },
    );
    ioPause.observe(wrapper);

    dispose = () => {
      running = false;
      cancelAnimationFrame(raf);
      document.removeEventListener('visibilitychange', onVisibility);
      ioPause.disconnect();
      wrapper.removeEventListener('pointermove', onPointer);
      ro.disconnect();
      bodyGeo.dispose();
      faceGeo.dispose();
      screenGeo.dispose();
      bodyMat.dispose();
      faceMat.dispose();
      screenMat.dispose();
      btnMat.dispose();
      auraMat.dispose();
      auraTex.dispose();
      tex.dispose();
      envTex.dispose();
      pmrem.dispose();
      renderer.dispose();
      wrapper.classList.remove('is-3d');
      delete wrapper.dataset.deviceReady;
      dispose = null;
    };
  }

  function setup() {
    const wrapper = document.querySelector<HTMLElement>('[data-mvo-device]');
    if (!wrapper) return;
    if (reduced()) return; // póster estático
    if (!('IntersectionObserver' in window)) {
      void boot(wrapper);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void boot(wrapper);
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(wrapper);
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    dispose?.();
  });
</script>
