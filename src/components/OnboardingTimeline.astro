---
import { process } from '../data/service';

interface Props {
  heading?: boolean;
  id?: string;
}
const { heading = true, id = 'proceso' } = Astro.props;
---

<section class="section wrap" id={id} aria-labelledby={`${id}-title`}>
  {heading && (
    <div class="section-head">
      <div>
        <p class="eyebrow">DEL DIAGNÓSTICO AL REPORTE</p>
        <h2 id={`${id}-title`} data-split>Seis pasos. <em>Cero improvisación.</em></h2>
      </div>
      <p class="lead">
        El primer día revisamos qué tienes y qué falta. A los 30 días ya hay entregables publicados
        y un plan medible. Sin reuniones eternas ni promesas sin fecha.
      </p>
    </div>
  )}

  <ol class="process-grid" data-stagger>
    {process.map((step, i) => (
      <li class="process-step reveal">
        <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{step.title}</h3>
        <p>{step.desc}</p>
      </li>
    ))}
  </ol>
</section>
