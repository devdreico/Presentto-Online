---
interface Props {
  path?: string;
}
const { path = '/' } = Astro.props;

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios/', label: 'Servicios' },
  { href: '/portfolio/', label: 'Portafolio' },
  { href: '/guias/', label: 'Guías' },
  { href: '/sitios/', label: 'Sitios' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const demoUrl =
  'https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio';
---

<header class="site-header">
  <div class="wrap nav-wrap">
    <a class="brand" href="/" aria-label="Presentto Online — Inicio">
      <img
        src="/assets/img/Presentto-Icono-Fondo-Transparente.webp"
        alt="Presentto Online"
        width="46"
        height="54"
        decoding="async"
      />
    </a>
    <nav aria-label="Navegación principal">
      {links.map((link) => (
        <a href={link.href} class={isActive(link.href) ? 'active' : undefined}>{link.label}</a>
      ))}
      <a class="nav-cta" href={demoUrl} target="_blank" rel="noopener"><span>Demo gratis</span> <b>↗</b></a>
    </nav>
  </div>
</header>
