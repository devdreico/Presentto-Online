---
import { ctaDiagnostico } from '../data/business';

interface Props {
  path?: string;
}
const { path = '/' } = Astro.props;

type NavLink = { href: string; label: string; desc?: string; external?: boolean };
type NavGroup = { label: string; links: NavLink[] };

const direct: NavLink[] = [
  { href: '/', label: 'Inicio' },
  { href: 'https://map.presentto.online/', label: 'Mapa', external: true },
];

const groups: NavGroup[] = [
  {
    label: 'Servicios',
    links: [
      { href: '/servicios/', label: 'Servicios', desc: 'Administración web y presencia digital' },
      { href: '/precios/', label: 'Precios', desc: '4 planes desde $100.000/mes' },
      { href: '/soporte/', label: 'Soporte', desc: 'Canales, SLA y cambios' },
    ],
  },
  {
    label: 'Trabajo',
    links: [
      { href: '/portfolio/', label: 'Portafolio', desc: 'Cómo queda cada proyecto' },
      { href: '/sitios/', label: 'Sitios publicados', desc: '15 clientes en producción' },
    ],
  },
  {
    label: 'Recursos',
    links: [
      { href: '/guias/', label: 'Guías', desc: 'Presencia digital paso a paso' },
      { href: '/preguntas/', label: 'Preguntas', desc: 'Dudas frecuentes resueltas' },
      { href: '/comparativas/', label: 'Comparativas', desc: 'Opciones de servicio comparadas' },
    ],
  },
];

const tail: NavLink[] = [
  { href: '/cuenta/', label: 'Mi cuenta' },
  { href: '/contacto/', label: 'Contacto' },
];

const isSame = (href: string, current: string) =>
  href === '/' ? current === '/' : current.startsWith(href);

const isGroupActive = (group: NavGroup) => group.links.some((l) => isSame(l.href, path));

const linkClass = (href: string) => (isSame(href, path) ? 'active' : undefined);

const mobileGroups: NavGroup[] = [
  {
    label: 'Mapa',
    links: [
      { href: 'https://map.presentto.online/', label: 'Mapa ↗', external: true, desc: 'Directorio en la Sabana Occidental' },
    ],
  },
  ...groups,
  {
    label: 'Cuenta',
    links: [...tail, { href: '/nosotros/', label: 'Nosotros', desc: 'Quiénes operan el portal' }],
  },
];
---

<header class="site-header" data-home-header={path === '/' ? '' : undefined}>
  <div class="wrap nav-wrap">
    <a class="brand" href="/" aria-label="Presentto Online — Inicio">
      <img
        src="/assets/img/Presentto-Icono-Fondo-Transparente.webp"
        alt=""
        width="46"
        height="54"
        decoding="async"
      />
      <span class="brand-name">Present<em>to</em></span>
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      {direct.map((link) => (
        <a
          class="nav-link"
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener' : undefined}
          aria-current={!link.external && linkClass(link.href) ? 'page' : undefined}
        >
          {link.label}
          {link.external && <span class="nav-ext" aria-hidden="true">↗</span>}
        </a>
      ))}
      {groups.map((group) => (
        <div class="nav-item" data-nav-item>
          <a
            class:list={['nav-link', { active: isGroupActive(group) }]}
            href={group.links[0].href}
            aria-haspopup="true"
            aria-expanded="false"
            data-nav-trigger
          >
            {group.label}
            <i class="nav-caret" aria-hidden="true"></i>
          </a>
          <div class="nav-panel" role="group" aria-label={group.label}>
            {group.links.map((link) => (
              <a href={link.href} class={linkClass(link.href)}>
                <b>{link.label}</b>
                {link.desc && <small>{link.desc}</small>}
              </a>
            ))}
          </div>
        </div>
      ))}
      {tail.map((link) => (
        <a class="nav-link" href={link.href} aria-current={linkClass(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        class="btn btn-primary btn-sm header-cta"
        href={ctaDiagnostico}
        target="_blank"
        rel="noopener"
        data-magnetic
      >
        Diagnóstico gratis <span>↗</span>
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
        data-nav-toggle
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil full-screen -->
<div class="nav-overlay" id="mobileMenu" data-nav-overlay aria-hidden="true">
  <div></div>
  <div class="nav-overlay-inner">
    {mobileGroups.map((group) => (
      <div class="nav-group">
        <small>{group.label}</small>
        <div class="nav-group-links">
          {group.links.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
              aria-current={!link.external && linkClass(link.href) ? 'page' : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="nav-overlay-foot">
    <a class="btn btn-primary" href={ctaDiagnostico} target="_blank" rel="noopener">
      Pedir diagnóstico gratis <span>↗</span>
    </a>
    <p>20 minutos sin compromiso · WhatsApp 24/7</p>
  </div>
</div>
