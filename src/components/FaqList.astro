---
// FAQ helper: visible <details> + FAQPage JSON-LD kept in sync
interface Faq {
  q: string;
  a: string;
}
interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<div class="faq-native">
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
