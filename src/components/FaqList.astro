---
// FAQ visual <details> — el schema FAQPage va al <head> vía la prop `faqs` de BaseLayout
interface Faq {
  q: string;
  a: string;
}
interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

<div class="faq-native">
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
