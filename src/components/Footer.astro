---
import { ctaDiagnostico, waDirect } from '../data/business';

const year = new Date().getFullYear();

const cols = [
  {
    title: 'Explora',
    links: [
      { href: '/servicios/', label: 'Servicios' },
      { href: '/precios/', label: 'Precios' },
      { href: '/soporte/', label: 'Soporte' },
      { href: '/cuenta/', label: 'Mi cuenta' },
      { href: '/portfolio/', label: 'Portafolio' },
      { href: '/sitios/', label: 'Sitios publicados' },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { href: '/guias/', label: 'Guías' },
      { href: '/preguntas/', label: 'Preguntas frecuentes' },
      { href: '/comparativas/', label: 'Comparativas' },
      { href: '/contacto/', label: 'Diagnóstico gratis' },
      { href: '/nosotros/', label: 'Nosotros' },
    ],
  },
  {
    title: 'Cerca de ti',
    links: [
      { href: '/funza/', label: 'Presencia digital en Funza' },
      { href: '/mosquera/', label: 'Presencia digital en Mosquera' },
      { href: '/madrid/', label: 'Presencia digital en Madrid' },
      { href: '/facatativa/', label: 'Presencia digital en Facatativá' },
    ],
  },
];

const socials = [
  { href: 'https://www.tiktok.com/@presenttonline', label: 'TikTok' },
  { href: 'https://www.instagram.com/presenttonline', label: 'Instagram' },
  { href: 'https://www.facebook.com/PresenttoOnline', label: 'Facebook' },
];
---

<footer aria-label="Pie de página">
  <p class="managed-by wrap">
    Administración de Presencia Digital · desde $100.000 COP/mes, IVA incluido · Servicio operado
    por Soverath Holding S.A.S. con respaldo de Aeperion Systems.
  </p>

  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Presentto Online">
        <img
          src="/assets/img/Presentto-Nombre-Fondo-Transparente.png"
          alt="Presentto Online"
          width="160"
          height="54"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>
        La agencia todo en 1 para crecer digitalmente: web, ficha de Google, analítica, sistemas y
        flujos de IA administrados por un solo equipo.
      </p>
      <a class="btn btn-dark btn-sm" href={ctaDiagnostico} target="_blank" rel="noopener">
        Pedir diagnóstico gratis <span>↗</span>
      </a>
    </div>

    {cols.map((col) => (
      <div class="footer-col">
        <small>{col.title}</small>
        {col.links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    ))}

    <div class="footer-col">
      <small>Hablemos</small>
      <a href={waDirect} target="_blank" rel="noopener">+57 323 648 7336</a>
      <a href="mailto:inbox@presentto.online">inbox@presentto.online</a>
      <span class="footer-hours">Humano 7:00–19:00 · WhatsApp 24/7</span>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener">{s.label} @presenttonline</a>
      ))}
    </div>
  </div>

  <div class="wrap footer-bottom">
    <div class="footer-legal">
      <a href="/privacidad/">Privacidad</a>
      <a href="/terminos/">Términos</a>
      <a href="/cookies/">Cookies</a>
      <a href="/sitios/">Mapa del sitio</a>
    </div>
    <p class="footer-copy">© {year} Presentto Online · Colombia</p>
  </div>
</footer>
