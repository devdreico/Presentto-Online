---
const year = new Date().getFullYear();
const demoUrl =
  'https://wa.me/573236487336?text=Hola%20Presentto%2C%20quiero%20solicitar%20una%20demo%20web%20gratis%20de%20mi%20negocio';
---

<footer aria-label="Pie de página">
  <p class="managed-by wrap">
    Web administrada y SEO local para la Sabana Occidental · Demo gratis desde $40.000 COP/mes · Servicio
    operado por Soverath Holding S.A.S. con respaldo de Aeperion Systems.
  </p>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Presentto Online">
        <img
          src="/assets/img/Presentto-Nombre-Fondo-Transparente.webp"
          alt="Presentto Online"
          width="160"
          height="54"
          loading="lazy"
          decoding="async"
        />
      </a>
      <a class="footer-demo" href={demoUrl} target="_blank" rel="noopener">Pedir demo gratis ↗</a>
    </div>
    <div>
      <small>EXPLORA</small>
      <a href="/servicios/">Servicios</a>
      <a href="/portfolio/">Portafolio</a>
      <a href="/guias/">Guías</a>
      <a href="/contacto/">Contacto</a>
    </div>
    <div>
      <small>HABLEMOS</small>
      <a href="https://wa.me/573236487336" target="_blank" rel="noopener">+57 323 648 7336</a>
      <a href="mailto:inbox@presentto.online">inbox@presentto.online</a>
    </div>
  </div>
  <div class="footer-info">
    <small>INFORMACIÓN</small>
    <a href="/nosotros/">Nosotros</a>
    <a href="/preguntas/">Preguntas frecuentes</a>
    <a href="/privacidad/">Privacidad</a>
    <a href="/terminos/">Términos</a>
    <a href="/cookies/">Cookies</a>
  </div>
  <div class="wrap copyright">© {year} Presentto Online · Sabana Occidental, Colombia</div>
</footer>
