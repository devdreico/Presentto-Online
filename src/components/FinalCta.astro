---
import { ctaDiagnostico } from '../data/business';

interface Props {
  eyebrow?: string;
  title?: string;
  note?: string;
}
const {
  eyebrow = 'EMPIEZA CON DIAGNÓSTICO GRATIS',
  title = 'Revisamos tu presencia. <em>Decide después.</em>',
  note = '20 minutos por Google Meet o WhatsApp · Sin compromiso · Presupuesto antes de pagar',
} = Astro.props;
---

<section class="final-cta">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h2 set:html={title} />
    <div class="actions">
      <a class="btn btn-light" href={ctaDiagnostico} target="_blank" rel="noopener" data-magnetic>
        Pedir diagnóstico gratis <span>↗</span>
      </a>
      <slot />
      <a class="btn btn-light-ghost" href="/precios/">Ver planes <span>↓</span></a>
    </div>
    <p class="final-cta-note">{note}</p>
  </div>
</section>
