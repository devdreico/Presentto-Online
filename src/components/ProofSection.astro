---
/**
 * Casos y testimonios aprobados. Si no hay nada aprobado, no se renderiza.
 * Se alimenta de src/data/proof.ts.
 */
import { approvedCases, approvedTestimonials } from '../data/proof';

const cases = approvedCases();
const quotes = approvedTestimonials();
const show = cases.length > 0 || quotes.length > 0;
---

{show && (
  <section class="section wrap" id="casos" aria-labelledby="casos-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">RESULTADOS CON PERMISO</p>
        <h2 id="casos-title" data-split>
          Lo que cambió, <em>con cifras.</em>
        </h2>
      </div>
      <p class="lead">
        Casos publicados con autorización del cliente. Cada cifra sale de Search Console, Analytics
        o del sistema del negocio, y corresponde al periodo indicado.
      </p>
    </div>

    {cases.length > 0 && (
      <div class="case-grid" data-stagger>
        {cases.map((item) => (
          <article class="case-card reveal">
            <p class="case-sector">{item.sector}</p>
            <h3>{item.client}</h3>
            <p class="case-challenge">{item.challenge}</p>
            <ul class="case-work">
              {item.work.map((step) => (
                <li>{step}</li>
              ))}
            </ul>
            <dl class="case-metrics">
              {item.metrics.map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd>{metric.value}</dd>
                </div>
              ))}
            </dl>
            {item.url && (
              <a class="case-link" href={item.url} target="_blank" rel="noopener noreferrer">
                Ver el sitio <span aria-hidden="true">↗</span>
              </a>
            )}
          </article>
        ))}
      </div>
    )}

    {quotes.length > 0 && (
      <div class="quote-grid" data-stagger>
        {quotes.map((item) => (
          <figure class="quote-card reveal">
            <blockquote>{item.quote}</blockquote>
            <figcaption>
              <strong>{item.author}</strong>
              <span>{item.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>
)}
