---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import {
  organizationSchema,
  websiteSchema,
  breadcrumbSchema,
  faqPageSchema,
  plansItemListSchema,
  personSchema,
  type Crumb,
  type Faq,
} from '../components/schemas';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  jsonld?: Array<Record<string, unknown>>;
  article?: { publishedTime: string; modifiedTime: string };
  breadcrumbs?: Crumb[];
  faqs?: Faq[];
  plansOffers?: boolean;
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  jsonld = [],
  article,
  breadcrumbs,
  faqs,
  plansOffers = false,
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/assets/img/og-presentto.jpg', Astro.site).href;
const fullTitle = title.includes('Presentto') ? title : `${title} | Presentto Online`;
const gsc = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bing = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const isArticle = Boolean(article);
const ogType = isArticle ? 'article' : 'website';

const webpageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: 'es-CO',
  isPartOf: { '@id': `${new URL('/', Astro.site).href}#website` },
  ...(path !== '/' && !noindex
    ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } }
    : {}),
  ...(article
    ? { datePublished: article.publishedTime, dateModified: article.modifiedTime }
    : {}),
};

const pageSchemas = jsonld.filter(Boolean).filter((s) => {
  const t = s['@type'];
  return t !== 'Organization' && t !== 'WebSite' && t !== 'WebPage';
});

const componentSchemas: Array<Record<string, unknown>> = [];
if (!noindex) {
  if (breadcrumbs?.length) componentSchemas.push(breadcrumbSchema(breadcrumbs, path));
  if (faqs?.length) componentSchemas.push(faqPageSchema(faqs));
  if (plansOffers) componentSchemas.push(plansItemListSchema(path));
}

const allSchemas = noindex
  ? pageSchemas
  : [
      organizationSchema,
      websiteSchema,
      webpageSchema,
      personSchema(),
      ...pageSchemas.filter(Boolean),
      ...componentSchemas,
    ].filter(Boolean);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />
    <meta name="theme-color" content="#fffdf9" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    {bing && <meta name="msvalidate.01" content={bing} />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content="Presentto Online" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/webp" href="/assets/img/Presentto-Icono-Fondo-Transparente.webp" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="mask-icon" href="/assets/img/Presentto-Icono-Fondo-Transparente.webp" color="#f15a24" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Presentto Online — Guías" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Presentto Online" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Presentto Online — web administrada y presencia digital desde $15.000 COP/mes" />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:modified_time" content={article.modifiedTime} />
        <meta property="article:author" content="https://www.presentto.online/nosotros/" />
        <meta property="article:section" content="Presencia digital" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Presentto Online — web administrada y presencia digital desde $15.000 COP/mes" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/fonts/montserrat-var-latin.woff2"
      crossorigin
    />

    <ClientRouter />

    <script is:inline>
      // Motion: habilita animaciones con red de seguridad (3.5s) y decide
      // si el preloader de marca se reproduce (solo 1ª visita de la sesión).
      document.documentElement.classList.add('has-motion');
      setTimeout(function () {
        document.documentElement.classList.add('motion-timeout');
      }, 3500);
      try {
        var seen = sessionStorage.getItem('presentto-pl');
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!seen && !reduced) {
          sessionStorage.setItem('presentto-pl', '1');
          document.documentElement.classList.add('play-preloader');
        }
        setTimeout(function () {
          document.documentElement.classList.remove('play-preloader');
        }, 3000);
      } catch (e) {
        document.documentElement.classList.remove('play-preloader');
      }
    </script>

    <script is:inline>
      // Redirect legacy query-string SPA URLs: /?page=servicios.html → /servicios/
      (function () {
        var page = new URLSearchParams(location.search).get('page');
        if (!page) return;
        var map = {
          'index.html': '/',
          'servicios.html': '/servicios/',
          'portfolio.html': '/portfolio/',
          'contacto.html': '/contacto/',
          'nosotros.html': '/nosotros/',
          'preguntas.html': '/preguntas/',
          'privacidad.html': '/privacidad/',
          'terminos.html': '/terminos/',
          'cookies.html': '/cookies/',
          'mapa.html': '/sitios/',
          'funza.html': '/funza/',
          'mosquera.html': '/mosquera/',
          'madrid.html': '/madrid/',
          'facatativa.html': '/facatativa/',
          'demos.html': '/portfolio/',
        };
        var target = map[page];
        if (target) location.replace(target);
      })();
    </script>

    <!-- Google Tag Manager — Consent Mode v2 defaults denied; loads only after grant -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
        window.__presenttoTrack = function (name, params) {
          window.dataLayer = window.dataLayer || [];
          var msg = { event: name };
          if (params) {
            for (var k in params) {
              if (Object.prototype.hasOwnProperty.call(params, k)) msg[k] = params[k];
            }
          }
          window.dataLayer.push(msg);
        };
        function readCookie(name) {
          return (
            (window.document.cookie
              .split('; ')
              .find(function (c) {
                return c.indexOf(name + '=') === 0;
              }) || ''
              .split('=')[1]) || null
          );
        }
        window.__presenttoLoadGtm = function () {
          if (window.__gtmLoaded) return;
          window.__gtmLoaded = true;
          gtag('consent', 'update', {
            analytics_storage: 'granted',
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
          });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-538NSMPT';
          document.head.appendChild(s);
        };
        if (readCookie('presentto-analytics') === 'granted') {
          window.__presenttoLoadGtm();
        }
      })();
    </script>

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>

    <div class="backdrop" aria-hidden="true">
      <span class="aura aura-1"></span>
      <span class="aura aura-2"></span>
      <span class="aura aura-3"></span>
      <span class="grain"></span>
    </div>

    <aside class="preloader" data-preloader aria-hidden="true">
      <div class="preloader-inner">
        <div class="preloader-mark">Presen<em>tto</em></div>
        <div class="preloader-bar"><i></i></div>
        <div class="preloader-sub">Presencia digital administrada</div>
      </div>
    </aside>

    <div class="scroll-progress" data-progress aria-hidden="true"><i></i></div>

    <Header path={path} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
