{
  "build": {
    "command": "npm run build",
    "output": "dist"
  },
  "redirects": [
    { "source": "/servicios.html", "destination": "/servicios/", "status": 301 },
    { "source": "/portfolio.html", "destination": "/portfolio/", "status": 301 },
    { "source": "/contacto.html", "destination": "/contacto/", "status": 301 },
    { "source": "/nosotros.html", "destination": "/nosotros/", "status": 301 },
    { "source": "/preguntas.html", "destination": "/preguntas/", "status": 301 },
    { "source": "/privacidad.html", "destination": "/privacidad/", "status": 301 },
    { "source": "/terminos.html", "destination": "/terminos/", "status": 301 },
    { "source": "/cookies.html", "destination": "/cookies/", "status": 301 },
    { "source": "/mapa.html", "destination": "/sitios/", "status": 301 },
    { "source": "/funza.html", "destination": "/funza/", "status": 301 },
    { "source": "/mosquera.html", "destination": "/mosquera/", "status": 301 },
    { "source": "/madrid.html", "destination": "/madrid/", "status": 301 },
    { "source": "/facatativa.html", "destination": "/facatativa/", "status": 301 },
    { "source": "/demos.html", "destination": "/portfolio/", "status": 301 }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
